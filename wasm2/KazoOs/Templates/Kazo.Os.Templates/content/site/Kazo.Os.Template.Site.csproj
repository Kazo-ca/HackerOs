<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      ADR 0106 §4: the host that installs this app trims it when it publishes; the trim analysis
      reports here, at build, any reflection the trimmer could not follow.
    -->
    <IsTrimmable>true</IsTrimmable>
    <!-- A Kazo OS app; also read by the Debug profile of a hackeros-solution repository (ADR 0207). -->
    <KazoOsAppProject>true</KazoOsAppProject>
    <!-- One version for every Kazo OS package (ADR 0098 §1). -->
    <KazoOsVersion>0.0.0-dev</KazoOsVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.13" />
    <PackageReference Include="Kazo.Os.AppSdk.Web" Version="$(KazoOsVersion)" />
    <!--
      Generates manifest.json, the route table and the site's entry point (ASP.Hack route generator),
      and embeds wwwroot/ in the assembly (served by UseStaticFiles).
    -->
    <PackageReference Include="Kazo.Os.App.Build" Version="$(KazoOsVersion)" PrivateAssets="all" />
  </ItemGroup>

</Project>
