<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Packaging.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Kazo.Os.Windowing.Core</PackageId>
    <Description>Headless, renderer-independent window manager engine: applies Kazo.Os.Windowing.Abstractions commands to authoritative window state (focus, z-order, geometry, modality, lifecycle) and emits deterministic events.</Description>
    <PackageTags>kazoos;windowing;blazor;desktop-shell</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Contracts (WindowId, WindowBounds, WindowRuntimeState, commands/events) live in
         Kazo.Os.Windowing.Abstractions; this project owns only the engine that applies them.
         No browser pipeline, no .razor components, no MudBlazor: this project stays headless. -->
    <ProjectReference Include="..\Kazo.Os.Windowing.Abstractions\Kazo.Os.Windowing.Abstractions.csproj" />
  </ItemGroup>

</Project>
