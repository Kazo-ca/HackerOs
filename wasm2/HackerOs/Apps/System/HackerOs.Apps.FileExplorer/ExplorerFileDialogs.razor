@using HackerOs.AppSdk.Apps
@using HackerOs.AppSdk.Blazor.Components
@using HackerOs.AppSdk.Blazor.Files
@using HackerOs.Simulation.Abstractions.FileSystem
@inherits HackEmbeddableComponent

@*
    The file dialogs of the OS (hackeros.file-dialogs, ADR 0148 §6, ADR 0155 §5), as the File Explorer
    provides them: "Open with", the properties of an entry and the "Replace / Keep both / Skip" choice.
    The OS shows this component in a window modal to the requesting app's window, inside that app's
    context: the catalog and the filesystem are read with the app's rights. Native markup, one panel
    per dialog, in the look of the OS app chooser.
*@
@switch (Dialog)
{
    case HackFileDialogs.OpenWith when Request is OpenWithDialogRequest openWith:
        <div class="explorer-file-dialog open-with" role="group" aria-labelledby="@_headingId">
            <p id="@_headingId" class="dialog-prompt">@OpenWithPrompt.Before<strong>@openWith.Path</strong>@OpenWithPrompt.After</p>
            @if (_apps is null)
            {
                <p class="dialog-status" role="status">@L["Dialog.Loading"]</p>
            }
            else if (_apps.Count == 0)
            {
                <p class="dialog-status" role="status">@L["Error.NoHandler"]</p>
            }
            else
            {
                <div class="app-list" role="radiogroup" aria-label="@L["Dialog.OpenWith.Title"]" @onkeydown="OnAppListKeyDown">
                    @foreach (HackAppInfo app in _apps)
                    {
                        <button type="button"
                                role="radio"
                                class="app-option @(app.Id == _selectedAppId ? "selected" : "")"
                                aria-checked="@(app.Id == _selectedAppId ? "true" : "false")"
                                tabindex="@(app.Id == _selectedAppId ? "0" : "-1")"
                                @onclick="() => _selectedAppId = app.Id"
                                @ondblclick="() => ChooseApp(app.Id)">
                            <span class="app-mark" aria-hidden="true">@(app.Id == _selectedAppId ? "▣" : "□")</span>
                            <span class="app-name">@app.Name</span>
                            <span class="app-id">@app.Id</span>
                        </button>
                    }
                </div>
            }
            @if (CanRemember)
            {
                <label class="dialog-check">
                    <input type="checkbox" @bind="_alwaysUse" />
                    <span>@L["OpenWith.AlwaysUse", _extension!]</span>
                </label>
            }
            <footer class="dialog-actions">
                <button type="button" class="primary" disabled="@(_selectedAppId is null)" @onclick="() => ChooseApp(_selectedAppId)">@L["OpenWith.Open"]</button>
                <button type="button" @onclick="CancelAsync">@L["OpenWith.Cancel"]</button>
            </footer>
        </div>
        break;

    case HackFileDialogs.Properties when Request is FilePropertiesDialogRequest properties:
        <div class="explorer-file-dialog properties" role="group" aria-labelledby="@_headingId">
            <h2 id="@_headingId" class="dialog-heading">@NameOf(properties.Path)</h2>
            @if (_statError is not null)
            {
                <p class="dialog-status" role="alert">@_statError</p>
            }
            else if (_metadata is null)
            {
                <p class="dialog-status" role="status">@L["Dialog.Loading"]</p>
            }
            else
            {
                <dl class="property-list">
                    <dt>@L["Properties.Name"]</dt>
                    <dd>@NameOf(properties.Path)</dd>
                    <dt>@L["Properties.Path"]</dt>
                    <dd class="mono">@properties.Path</dd>
                    <dt>@L["Properties.Kind"]</dt>
                    <dd>@KindText(_metadata.Kind)</dd>
                    <dt>@L["Properties.Size"]</dt>
                    <dd>@SizeText</dd>
                    <dt>@L["Properties.Owner"]</dt>
                    <dd class="mono">@_metadata.OwnerId</dd>
                    <dt>@L["Properties.Permissions"]</dt>
                    <dd class="mono">@_metadata.Permissions.ToString()</dd>
                    <dt>@L["Properties.Modified"]</dt>
                    <dd>@TimeZoneInfo.ConvertTime(_metadata.Timestamps.ContentModifiedAtUtc, HostContext.TimeZone).ToString("f", FormatCulture)</dd>
                </dl>
            }
            <footer class="dialog-actions">
                <button type="button" class="primary" @onclick="ClosePropertiesAsync">@L["Properties.Ok"]</button>
            </footer>
        </div>
        break;

    case HackFileDialogs.Conflict when Request is FileConflictDialogRequest conflict:
        <div class="explorer-file-dialog conflict" role="group" aria-labelledby="@_headingId">
            <p id="@_headingId" class="dialog-prompt">
                @ExistsText(conflict).Before<strong>@NameOf(conflict.DestinationPath)</strong>@ExistsText(conflict).After
            </p>
            <p class="dialog-detail">@MovingText.Before<span class="mono">@conflict.SourcePath</span>@MovingText.After</p>
            @if (conflict.DestinationIsDirectory)
            {
                <p class="dialog-warning" role="note">@L["Conflict.ReplaceWarning"]</p>
            }
            @if (conflict.OfferApplyToAll)
            {
                <label class="dialog-check">
                    <input type="checkbox" @bind="_applyToAll" />
                    <span>@L["Conflict.ApplyToAll"]</span>
                </label>
            }
            <footer class="dialog-actions">
                <button type="button" class="danger" @onclick="() => ResolveAsync(FileConflictDialogChoice.Replace)">@L["Conflict.Replace"]</button>
                <button type="button" class="primary" @onclick="() => ResolveAsync(FileConflictDialogChoice.KeepBoth)">@L["Conflict.KeepBoth"]</button>
                <button type="button" @onclick="() => ResolveAsync(FileConflictDialogChoice.Skip)">@L["Conflict.Skip"]</button>
            </footer>
        </div>
        break;

    default:
        <div class="explorer-file-dialog" role="alert">
            <p class="dialog-status">@L["Dialog.UnknownDialog", Dialog ?? string.Empty]</p>
            <footer class="dialog-actions">
                <button type="button" @onclick="CancelAsync">@L["OpenWith.Cancel"]</button>
            </footer>
        </div>
        break;
}
