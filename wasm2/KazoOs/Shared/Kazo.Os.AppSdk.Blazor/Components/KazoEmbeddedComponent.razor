@namespace Kazo.Os.AppSdk.Blazor.Components
@typeparam TController where TController : class
@inherits KazoComponentBase

@*
    Embeds the component another installed app registered for a contract (ADR 0063), without a
    reference to that app's assembly. The platform finds the provider (IHackComponentHost), the
    component renders here in this window's context, and its controller comes back through
    ControllerChanged.
*@
@if (_resolution is { ComponentType: not null })
{
    @BuildProvider
}
else if (_resolution is { Error: { } error })
{
    @if (Unavailable is not null)
    {
        @Unavailable(error)
    }
    else
    {
        <div class="embedded-unavailable" role="status">
            <span class="embedded-unavailable-title">@Contract</span>
            <span>@error</span>
        </div>
    }
}
else
{
    <div class="embedded-loading" role="status" aria-live="polite">@L["Embedded.Loading"]</div>
}
