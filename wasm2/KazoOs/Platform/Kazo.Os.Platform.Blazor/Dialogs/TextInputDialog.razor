@using Microsoft.AspNetCore.Components.Web
@using Kazo.Os.AppSdk.Blazor
@inject IStringLocalizer<Strings> L

<div class="text-input-dialog" role="dialog" aria-modal="true">
    <div class="text-input-body">
        @if (!string.IsNullOrWhiteSpace(Presentation.Request.Content))
        {
            <p class="text-input-content">@Presentation.Request.Content</p>
        }
        <input type="text"
               class="dialog-input"
               @bind="_inputValue"
               @bind:event="oninput"
               placeholder="@Presentation.Request.Placeholder"
               @onkeydown="HandleKeyDown" />
    </div>
    <footer class="text-input-actions">
        <button type="button" class="primary" @onclick="HandleSubmit">@L["Common.Ok"]</button>
        <button type="button" @onclick="HandleCancel">@L["Common.Cancel"]</button>
    </footer>
</div>

@code {
    private string _inputValue = string.Empty;

    [Parameter]
    [EditorRequired]
    public TextInputPresentation Presentation { get; set; } = default!;

    [Parameter]
    [EditorRequired]
    public DialogCoordinator Coordinator { get; set; } = default!;

    protected override void OnInitialized()
    {
        _inputValue = Presentation.Request.DefaultValue ?? string.Empty;
    }

    private void HandleSubmit() => Coordinator.SelectTextInput(Presentation.Id, _inputValue);
    private void HandleCancel() => Coordinator.Cancel(Presentation.Id);

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            HandleSubmit();
        }
        else if (e.Key == "Escape")
        {
            HandleCancel();
        }
    }
}
