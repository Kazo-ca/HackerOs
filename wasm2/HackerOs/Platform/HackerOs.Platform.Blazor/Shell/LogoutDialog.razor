@using HackerOs.Simulation.Abstractions.Processes
@using HackerOs.Simulation.Abstractions.Sessions
@inject ISessionService SessionService
@inject IProcessManager ProcessManager
@inject HackerOs.Platform.Core.Lifecycle.AppLifecycleOrchestrator Orchestrator
@inject IStringLocalizer<Strings> L

<div class="modal-backdrop" @onclick="CancelAsync">
    <div class="logout-dialog"
         role="dialog"
         aria-modal="true"
         aria-labelledby="logout-title"
         @onclick:stopPropagation>
        <header class="dialog-header">
            <div class="logout-mark" aria-hidden="true">⏻</div>
            <h2 id="logout-title">@(Restart ? L["Logout.Restart.Title"] : L["Logout.Title"])</h2>
        </header>

        <div class="dialog-body">
            <p>@L["Logout.Body"]</p>
            @if (Restart)
            {
                <p>@L["Logout.Restart.Body"]</p>
            }

            @if (OtherSessions.Count > 0)
            {
                @* ADR 0201 section 5: the other open sessions, ended with this one on request (always by a restart). *@
                <div class="other-sessions-section">
                    <span class="section-label">@L["Logout.OtherSessions", OtherSessions.Count]</span>
                    <ul class="session-list">
                        @foreach (AuthenticatedPrincipal other in OtherSessions)
                        {
                            <li @key="other.SessionId">@other.DisplayName <span class="proc-pid">@other.LoginName.Value</span></li>
                        }
                    </ul>
                    @if (Restart)
                    {
                        <p>@L["Logout.Restart.EndsOtherSessions"]</p>
                    }
                    else
                    {
                        <label class="end-others">
                            <input type="checkbox" checked="@_endOtherSessions" disabled="@_isSigningOut" @onchange="ToggleEndOtherSessions" />
                            <span>@L["Logout.EndOtherSessions"]</span>
                        </label>
                    }
                </div>
            }

            @if (RunningProcesses.Count > 0)
            {
                <div class="running-processes-section">
                    <span class="section-label">@L["Logout.Processes", RunningProcesses.Count]</span>
                    <ul class="process-list">
                        @foreach (ProcessRecord proc in RunningProcesses)
                        {
                            <li key="@proc.Pid.Value">
                                <span class="proc-name">@proc.AppId</span>
                                <span class="proc-pid">PID @proc.Pid.Value</span>
                            </li>
                        }
                    </ul>
                </div>
            }

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <p class="dialog-error" role="alert">@_errorMessage</p>
            }
        </div>

        <footer class="dialog-footer">
            <button type="button"
                    class="btn-secondary"
                    disabled="@_isSigningOut"
                    @onclick="CancelAsync">
                @L["Common.Cancel"]
            </button>
            <button type="button"
                    class="btn-danger"
                    disabled="@_isSigningOut"
                    @onclick="ConfirmLogoutAsync">
                @ConfirmLabel
            </button>
        </footer>
    </div>
</div>

@code {
    private bool _isSigningOut;
    private bool _endOtherSessions;
    private string? _errorMessage;

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnLoggedOut { get; set; }

    /// <summary>
    /// Gets or sets whether the dialog asks for « Redémarrer » (ADR 0195): the same sign-out, worded
    /// as a restart; the caller reloads the OS once <see cref="OnLoggedOut"/> was raised.
    /// </summary>
    [Parameter]
    public bool Restart { get; set; }

    private string ConfirmLabel => (_isSigningOut, Restart) switch
    {
        (true, true) => L["Logout.Restarting"],
        (true, false) => L["Logout.SigningOut"],
        (false, true) => L["Logout.Restart"],
        _ => L["Logout.SignOut"],
    };

    /// <summary>The open sessions in the background (ADR 0201), none when the host keeps a single session.</summary>
    private IReadOnlyList<AuthenticatedPrincipal> OtherSessions =>
        (SessionService as IUserSwitchingService)?.BackgroundSessions ?? [];

    /// <summary>The processes this sign-out stops: none of the sessions left open in the background.</summary>
    private IReadOnlyList<ProcessRecord> RunningProcesses
    {
        get
        {
            HashSet<SessionId> kept = EndsOtherSessions ? [] : [.. OtherSessions.Select(static other => other.SessionId)];
            return ProcessManager.GetActiveProcesses()
                .Where(p => (p.State == ProcessState.Running || p.State == ProcessState.Starting) && !kept.Contains(p.SessionId))
                .ToList();
        }
    }

    /// <summary>A restart reloads the page, so it always ends every session (ADR 0201 section 5).</summary>
    private bool EndsOtherSessions => Restart || _endOtherSessions;

    private void ToggleEndOtherSessions(ChangeEventArgs args) => _endOtherSessions = args.Value is true;

    private async Task ConfirmLogoutAsync()
    {
        _isSigningOut = true;
        _errorMessage = null;
        try
        {
            if (EndsOtherSessions && SessionService is IUserSwitchingService switching)
            {
                // Like the foreground one: the apps stop (drafts kept), then the session ends.
                foreach (AuthenticatedPrincipal other in switching.BackgroundSessions)
                {
                    await Orchestrator.StopSessionAppsAsync(other.SessionId);
                    await switching.EndBackgroundSessionAsync(other.SessionId);
                }
            }

            // The session's apps stop first, while the desktop can still close their windows.
            if (SessionService.CurrentPrincipal is { } principal)
            {
                await Orchestrator.StopSessionAppsAsync(principal.SessionId);
            }

            await SessionService.LogoutAsync();
            if (OnLoggedOut.HasDelegate)
            {
                await OnLoggedOut.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSigningOut = false;
        }
    }

    private async Task CancelAsync()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }
}
