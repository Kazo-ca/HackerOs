<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build-time manifest generator (ADR 0047). Runs through an MSBuild Exec after an app project is
    compiled: loads the app assembly in an isolated AssemblyLoadContext, instantiates its
    [AppManifest] classes and writes manifest.json. The shared ASP.NET Core framework lets it load
    Blazor entry-point types. It never ships to the browser, so trim analysis does not apply.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Kazo.Os.App.Abstractions\Kazo.Os.App.Abstractions.csproj" />
    <ProjectReference Include="..\..\Platform\Kazo.Os.Platform.Core\Kazo.Os.Platform.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kazo.Os.Tools.ManifestGenerator.Tests" />
  </ItemGroup>

</Project>
