<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Kazo.Os.App.Build (ADR 0098 §2): the build integration of Kazo OS apps for a project outside
    this repository. It carries no assembly, only:

      buildTransitive/Kazo.Os.App.Build.targets  sets KazoOsBuildFromPackage, imports kazoos-build/
      kazoos-build/Kazo.Os.Apps.targets         the same file the repository builds with (not under
                                                   build/, which NuGet would expect to hold only
                                                   Kazo.Os.App.Build.targets)
      kazoos-build/asp-kazo/                     ASP.Kazo .cshtml support files (ADR 0086)
      tools/generator/                             the manifest generator (ADR 0047), run with dotnet
      analyzers/dotnet/cs/                         the ASP.Kazo route generator (ADR 0082)

    An app references it with PrivateAssets="all" so that the app's own package does not turn its
    consumers into apps; a host references it the same way and sets KazoOsAppHost to true.
  -->
  <Import Project="..\..\Platform\Packaging.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Kazo.Os.App.Build</PackageId>
    <Description>Build integration of Kazo OS apps: generated manifest.json, SDK boundary checks, ASP.Kazo route generator and host aggregation of app packages.</Description>
    <PackageTags>kazoos;msbuild;build;app-manifest</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <!-- No assembly, so nothing for the public API analyzer to track. -->
    <NoWarn>$(NoWarn);NU5128;NU5100;RS0016;RS0017;RS0037</NoWarn>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_KazoOsPackBuildTools</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build order only: both tools are packed from their output folders. -->
    <ProjectReference Include="..\Kazo.Os.Tools.ManifestGenerator\Kazo.Os.Tools.ManifestGenerator.csproj"
                      ReferenceOutputAssembly="false" Private="false" PrivateAssets="all"
                      SkipGetTargetFrameworkProperties="true"
                      GlobalPropertiesToRemove="TargetFramework;RuntimeIdentifier;SelfContained" />
    <ProjectReference Include="..\Kazo.Os.Tools.WebRouteGenerator\Kazo.Os.Tools.WebRouteGenerator.csproj"
                      ReferenceOutputAssembly="false" Private="false" PrivateAssets="all"
                      SkipGetTargetFrameworkProperties="true"
                      GlobalPropertiesToRemove="TargetFramework;RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\Kazo.Os.App.Build.targets" Pack="true" PackagePath="buildTransitive\" />
    <None Include="..\..\build\Kazo.Os.Apps.targets" Pack="true" PackagePath="kazoos-build/Kazo.Os.Apps.targets" Link="build\Kazo.Os.Apps.targets" />
    <None Include="..\..\build\asp-kazo\**" Pack="true" PackagePath="kazoos-build/asp-kazo/%(RecursiveDir)%(Filename)%(Extension)" Link="build\asp-kazo\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="_KazoOsPackBuildTools">
    <MSBuild Projects="..\Kazo.Os.Tools.ManifestGenerator\Kazo.Os.Tools.ManifestGenerator.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" PropertyName="_KazoOsGeneratorPath" />
    </MSBuild>
    <MSBuild Projects="..\Kazo.Os.Tools.WebRouteGenerator\Kazo.Os.Tools.WebRouteGenerator.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" PropertyName="_KazoOsRouteGeneratorPath" />
    </MSBuild>
    <PropertyGroup>
      <_KazoOsGeneratorDir>$([System.IO.Path]::GetDirectoryName('$(_KazoOsGeneratorPath)'))</_KazoOsGeneratorDir>
    </PropertyGroup>
    <ItemGroup>
      <_KazoOsGeneratorFile Include="$(_KazoOsGeneratorDir)/**" Exclude="$(_KazoOsGeneratorDir)/**/*.pdb;$(_KazoOsGeneratorDir)/**/*.xml;$(_KazoOsGeneratorDir)/Kazo.Os.Tools.ManifestGenerator;$(_KazoOsGeneratorDir)/Kazo.Os.Tools.ManifestGenerator.exe" />
      <!-- The native apphost is left out: the targets run the tool with "dotnet <dll>" on every OS. -->
      <TfmSpecificPackageFile Include="@(_KazoOsGeneratorFile)" PackagePath="tools/generator/%(RecursiveDir)%(Filename)%(Extension)" />
      <TfmSpecificPackageFile Include="$(_KazoOsRouteGeneratorPath)" PackagePath="analyzers/dotnet/cs/" />
    </ItemGroup>
  </Target>

</Project>
