<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="../Packaging.props" />

  <PropertyGroup>
    <PackageId>HackerOs.Platform.RemoteRendering</PackageId>
    <Description>Trial of Kazo OS window apps rendered in a Web Worker (ADR 0129, ADR 0133): a Blazor renderer in the worker, DOM changes applied by the window's host on the page.</Description>
    <PackageTags>hackeros;platform;blazor;web-workers</PackageTags>
  </PropertyGroup>

  <!--
    ADR 0129 trial, verdict in ADR 0133. Two halves, one assembly (it is part of the host's boot set,
    so every worker has it):
    - Worker/: WorkerWindowRunner renders the app's window component with a Renderer of our own
      (derived from the public Microsoft.AspNetCore.Components.RenderTree.Renderer) and turns each
      RenderBatch into DOM operations of our own format (DomPatchWriter), sent to the page.
    - Host/: RemoteWindowHost, the page side: applies those operations to the window's content with
      its collocated RemoteWindowHost.razor.js and sends DOM events back to the worker.
    No framework internals, no blazor.web.js internals (ADR 0129, section 2).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HackerOs.Platform.Blazor\HackerOs.Platform.Blazor.csproj" />
    <ProjectReference Include="..\HackerOs.Platform.WorkerHost\HackerOs.Platform.WorkerHost.csproj" />
    <ProjectReference Include="..\..\Shared\HackerOs.AppSdk.Blazor\HackerOs.AppSdk.Blazor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HackerOs.Platform.RemoteRendering.Tests" />
  </ItemGroup>

</Project>
