@namespace Kazo.Os.Platform.RemoteRendering.Host
@using Microsoft.AspNetCore.Components.Web

@if (_fallback)
{
    @* No worker on this host: the app renders here, as without the trial. *@
    @RenderOnPage
}
else
{
    <div class="remote-window-host" @ref="_surface" data-remote-window="@_state" data-worker="@_workerId" data-pid="@_process?.Pid"></div>
    @if (_failure is not null)
    {
        <div class="remote-window-failure" role="alert">@_failure</div>
    }
}
