@inherits Kazo.Os.AppSdk.Blazor.KazoComponentBase
@* Shows a response body that is not a structured simulated page (ADR 0074, section 1). *@

<div class="body-viewer" data-kind="@View.Kind.ToString().ToLowerInvariant()">
    <div class="body-viewer-bar">
        <span class="body-viewer-type">@View.MediaType</span>
        <span class="body-viewer-size">@FormatSize(View.Length)</span>
        @if (StatusCode >= 400)
        {
            <span class="body-viewer-status">HTTP @StatusCode</span>
        }
    </div>

    @switch (View.Kind)
    {
        case ResponseBodyKind.Text:
        case ResponseBodyKind.Json:
        case ResponseBodyKind.Html:
            <pre class="body-viewer-text">@View.Text</pre>
            break;
        case ResponseBodyKind.Image:
            <div class="body-viewer-image">
                <img src="@View.DataUrl" alt="@Url" />
            </div>
            break;
        case ResponseBodyKind.Pdf:
            <object class="body-viewer-pdf" type="application/pdf" data="@View.DataUrl" aria-label="@Url">
                <div class="body-viewer-binary" role="note">
                    <p>@L["Body.Pdf.CannotDisplay"]</p>
                    <p class="binary-hint">@L["Body.Pdf.Use"] <code>curl -O @Url</code> @L["Body.Or"] <code>wget</code> @L["Body.Pdf.ToSave"]</p>
                </div>
            </object>
            break;
        case ResponseBodyKind.Binary:
            <div class="body-viewer-binary" role="note">
                <div class="binary-icon">&#128190;</div>
                @if (DownloadedTo is not null)
                {
                    <p>@L["Body.DownloadedTo"] <code class="download-path">@DownloadedTo</code></p>
                }
                else
                {
                    <p>@L["Body.CannotDisplay"]</p>
                }
                <p class="binary-hint">@L["Body.FromTerminal"] <code>curl -O @Url</code> @L["Body.Or"] <code>wget @Url</code>.</p>
            </div>
            break;
        default:
            <div class="body-viewer-empty">@L["Body.Empty"]</div>
            break;
    }
</div>

@code {
    /// <summary>The body to show.</summary>
    [Parameter, EditorRequired] public ResponseBodyView View { get; set; } = default!;

    /// <summary>Status code of the response, shown when it is an error.</summary>
    [Parameter] public int StatusCode { get; set; }

    /// <summary>URL of the response, for the image's alternative text and the download hint.</summary>
    [Parameter] public string Url { get; set; } = string.Empty;

    /// <summary>Path the browser saved a binary body to, or <see langword="null"/>.</summary>
    [Parameter] public string? DownloadedTo { get; set; }

    private IStringLocalizer<Strings>? _localizer;

    /// <summary>The browser's texts in its own process's language (ADR 0104).</summary>
    private IStringLocalizer<Strings> L => _localizer ??= AppContext.GetLocalizer<Strings>();

    /// <summary>The size in the units of the process's language, its number in the process's format culture.</summary>
    private string FormatSize(int bytes)
    {
        System.Globalization.CultureInfo numbers = AppContext?.FormatCulture ?? KazoLocale.DefaultFormatCulture;
        return bytes switch
        {
            < 1024 => L["Size.Bytes", bytes.ToString(numbers)],
            < 1024 * 1024 => L["Size.KibiBytes", (bytes / 1024.0).ToString("0.#", numbers)],
            _ => L["Size.Megabytes", (bytes / (1024.0 * 1024)).ToString("0.#", numbers)]
        };
    }
}
