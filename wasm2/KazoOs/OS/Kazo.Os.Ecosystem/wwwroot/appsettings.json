{
  "KazoOs": {
    "ResourceAccounting": {
      "Cpu": { "Enabled": true, "UnresponsiveThresholdMs": 5000 },
      "Memory": { "Enabled": true }
    },
    "RemoteWindowRendering": {
      "Enabled": false,
      "Apps": [ "org.kazoos.calculator" ]
    },
    "ResourceLimits": { "Enabled": true },
