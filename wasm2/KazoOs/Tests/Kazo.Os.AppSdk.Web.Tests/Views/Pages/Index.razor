@inherits HackView<NoteStore>
@layout _Layout
@{ ViewData.Title = "Notes"; }
<h1>@Model.All.Count notes</h1>
<ul>
    @foreach (Note note in Model.All)
    {
        <HackPartial Name="_NoteCard" Model="note" />
    }
</ul>
<HackSection Name="Scripts">
    <script src="@Url.Content("~/js/notes.js")"></script>
</HackSection>
