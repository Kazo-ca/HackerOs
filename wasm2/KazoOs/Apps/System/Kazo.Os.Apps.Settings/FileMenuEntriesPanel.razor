@inherits Kazo.Os.AppSdk.Blazor.KazoComponentBase
@using Kazo.Os.AppSdk.Administration

@*
    Settings > File menus (ADR 0159 §8): the entries apps added to the file menus, grouped by app,
    each one shown or hidden for the session user.
*@
<div class="file-menus-panel">
    @if (!_isAvailable)
    {
        <p class="setting-desc">@L["FileMenus.Unavailable"]</p>
    }
    else
    {
        <p class="setting-desc">
            @LocalizedMarkup.Format(L["FileMenus.Description"], LocalizedMarkup.Code("~/.config/hackeros/context-menus.config"))
        </p>

        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="file-menus-message error" role="status">@_message</div>
        }

        @if (_entries.Count == 0)
        {
            <p class="file-menus-empty">@L["FileMenus.Empty"]</p>
        }

        @foreach (IGrouping<string, KazoFileMenuEntryInfo> app in _entries.GroupBy(static entry => entry.AppId))
        {
            <section key="@app.Key" class="setting-group file-menus-app">
                <header class="file-menus-app-header">
                    <h4>@app.First().AppName</h4>
                    <code>@app.Key</code>
                </header>
                <ul class="file-menus-entries">
                    @foreach (KazoFileMenuEntryInfo entry in Ordered(app))
                    {
                        bool inherited = IsHiddenByParent(entry);
                        <li key="@entry.Name" class="@EntryClass(entry)">
                            <label class="file-menus-toggle">
                                <input type="checkbox" checked="@(!entry.IsHidden)"
                                       disabled="@(_isBusy || inherited)"
                                       @onchange="args => ToggleAsync(entry, args.Value is true)" />
                                <span class="file-menus-title">@entry.Title</span>
                            </label>
                            <code class="file-menus-name">@entry.Name</code>
                            <span class="file-menus-scopes">
                                @foreach (string scope in entry.Scopes)
                                {
                                    <span key="@scope" class="file-menus-scope">@ScopeTitle(scope)</span>
                                }
                            </span>
                            @if (inherited)
                            {
                                <span class="file-menus-note">@L["FileMenus.HiddenByParent"]</span>
                            }
                        </li>
                    }
                </ul>
            </section>
        }
    }
</div>
