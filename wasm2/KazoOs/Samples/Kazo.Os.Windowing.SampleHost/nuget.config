<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    EXT-WIN-013 verification: with UseLocalHackerOsPackages=true, proves the seven-package
    desktop export closure works as real .nupkg files instead of ProjectReference, catching
    static assets or dependencies that only worked by source-reference coincidence. Normal
    repository development keeps the default ProjectReference mode; see the export plan.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-windowing-packages" value="../../artifacts/local-nupkg" />
  </packageSources>
</configuration>
