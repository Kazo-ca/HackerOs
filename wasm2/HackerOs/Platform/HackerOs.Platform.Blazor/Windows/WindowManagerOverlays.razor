@using HackerOs.Platform.Core.Shell
@using HackerOs.Windowing.Abstractions
@using HackerOs.Windowing.Core
@implements IAsyncDisposable
@inject IStringLocalizer<Strings> L

@* ADR 0095 §3: the window manager's keyboard surfaces — switcher, keyboard move/resize banner and
   window menu. Every decision lives in WindowKeyboardCommands; this component only draws its state
   and connects the browser's key events to it. *@

@if (Commands.Mode == WindowKeyboardMode.Switching)
{
    IReadOnlyList<WindowRuntimeState> windows = Commands.SwitcherWindows;
    WindowId? selection = Commands.SwitcherSelection;
    <div class="window-switcher-backdrop">
        <section class="window-switcher" role="listbox" aria-label="@L["Switcher.Label"]" aria-activedescendant="@(selection is { } selected ? ItemId(selected) : null)">
            @foreach (WindowRuntimeState window in windows)
            {
                bool isSelected = window.Id == selection;
                <div id="@ItemId(window.Id)"
                     class="window-switcher-item @(isSelected ? "is-selected" : null) @(window.VisualState == WindowVisualState.Minimized ? "is-minimized" : null)"
                     role="option"
                     aria-selected="@(isSelected ? "true" : "false")"
                     data-window-switcher-item="@window.Id">
                    <span class="window-switcher-glyph" aria-hidden="true">
                        @if (!string.IsNullOrWhiteSpace(window.IconAssetPath))
                        {
                            <img src="@window.IconAssetPath" alt="" />
                        }
                        else
                        {
                            @Initial(window.Title)
                        }
                    </span>
                    <span class="window-switcher-title">@window.Title</span>
                </div>
            }
        </section>
    </div>
}

@if (Commands.ModeWindow is not null)
{
    <aside class="window-mode-banner" role="status" aria-live="polite" data-window-mode="@(Commands.Mode == WindowKeyboardMode.Moving ? "move" : "resize")">
        <strong>@(Commands.Mode == WindowKeyboardMode.Moving ? L["WindowMode.Move"] : L["WindowMode.Resize"])</strong>
        <span>@(Commands.Mode == WindowKeyboardMode.Moving ? L["WindowMode.MoveHint"] : L["WindowMode.ResizeHint"])</span>
    </aside>
}

@* ADR 0179 §3: the window menus open in the OS context menu (ContextMenuOverlay), for its submenus. *@
