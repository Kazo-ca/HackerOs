@inherits HackLayout
@*
    The layout of every MVC page of the site, .cshtml and .razor views alike (ADR 0086 "mixing").
    It is rendered after the view, so it sees the title and the "Scripts" section the view set.
    Its styles and scripts come from the embedded wwwroot (UseStaticFiles), never inline (ADR 0007).
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@PageTitle</title>
    <link rel="stylesheet" href="@Url.Content("~/css/site.css")" />
</head>
<body>
    <header class="topbar">
        <HackLink Action="Index" Controller="Home" class="brand">intranet<span>.hack</span></HackLink>
        <nav class="topnav" aria-label="Site">
            <HackLink Action="Index" Controller="Home" class="@NavClass("Home")" id="nav-home">Home</HackLink>
            <HackLink Action="Index" Controller="Notes" class="@NavClass("Notes")" id="nav-notes">Notes</HackLink>
            <HackLink Action="Index" Controller="People" class="@NavClass("People")" id="nav-people">People</HackLink>
            <a href="/board" id="nav-board">Board</a>
        </nav>
        <div class="whoami">
            <span class="whoami-name" id="whoami">@(DisplayName ?? IntranetSession.Anonymous)</span>
            <HackLink Action="Profile" Controller="Home" id="nav-profile">profile</HackLink>
        </div>
    </header>
    <main class="page">
        @Body
    </main>
    <footer class="footer">
        <span>ASP.Hack · served by the site process</span>
        <code>@Request.Method @Request.Path</code>
    </footer>
    <HackRenderSection Name="Scripts" Required="false" />
</body>
</html>
