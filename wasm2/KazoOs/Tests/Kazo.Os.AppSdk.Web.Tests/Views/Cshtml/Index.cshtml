@model NoteStore
@inject RequestCounter Counter
@{
    ViewData.Title = "Cshtml notes";
    Func<string, object> badge = @<b class="badge">@item</b>;
}
<h1>@Model.All.Count notes &amp; @("<tags>")</h1>
<ul>
    @foreach (Note note in Model.All)
    {
        <li class="note @(note.Done ? "done" : null)">
            @Html.ActionLink(note.Title, "Details", "Cshtml", new { id = note.Id })
            <input type="checkbox" checked="@note.Done" disabled="@note.Done" />
        </li>
    }
</ul>
<ul class="cards">
    @foreach (Note note in Model.All)
    {
        @await Html.PartialAsync("_CshtmlCard", note)
    }
</ul>
<ul class="razor-cards">@await Html.PartialAsync("~/Views/Pages/_NoteCard.razor", Model.All[0])</ul>
@badge("new")
@Html.Raw("<hr class=\"raw\" />")
<p class="counter">@(Counter.Instance > 0 ? "ok" : "ko")</p>
<p class="component">@(await Component.InvokeAsync<HackLink>(new Dictionary<string, object?> { ["Action"] = "Edit", ["ChildContent"] = (Microsoft.AspNetCore.Components.RenderFragment)(b => b.AddContent(0, "Edit")) }))</p>
<p class="json">@Json.Serialize(Model.All[0])</p>
@if (IsDone(Model.All[1]))
{
    <p>second is done</p>
}
@section Scripts {
    <script src="@Url.Content("~/js/notes.js")"></script>
}
@functions {
    private static bool IsDone(Note note) => note.Done;
}
