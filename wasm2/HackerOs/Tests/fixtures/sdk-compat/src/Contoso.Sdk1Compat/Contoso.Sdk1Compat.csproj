<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    ADR 0098 §8, ADR 0114: a third-party app compiled once against the KazoOS 1.0.0 packages. Its
    package, kept in ../../packages, is loaded by the current OS in the compatibility tests; it is
    never rebuilt against a newer SDK (produce-fixture.sh only exists for the next major version).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTrimmable>true</IsTrimmable>
    <IsPackable>true</IsPackable>
    <PackageId>Contoso.Sdk1Compat</PackageId>
    <Version>$(HackerOsVersion)</Version>
    <Authors>Contoso</Authors>
    <Description>KazoOS SDK compatibility fixture: a window app and a command compiled against SDK $(HackerOsVersion).</Description>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="HackerOsSdkCompiledAgainst" Value="$(HackerOsVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.13" />
    <PackageReference Include="HackerOs.AppSdk" Version="$(HackerOsVersion)" />
    <PackageReference Include="HackerOs.AppSdk.Blazor" Version="$(HackerOsVersion)" />
    <PackageReference Include="HackerOs.App.Build" Version="$(HackerOsVersion)" PrivateAssets="all" />
  </ItemGroup>

</Project>
