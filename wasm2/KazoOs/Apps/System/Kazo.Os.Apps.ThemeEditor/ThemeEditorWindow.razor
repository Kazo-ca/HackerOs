@using Kazo.Os.AppSdk.Blazor
@using MudBlazor
@inherits WindowAppBase
@implements IWindowCloseGuard

<div class="theme-editor">
    <header class="editor-toolbar" role="toolbar" aria-label="@L["Toolbar.AriaLabel"]">
        <span class="editor-title" id="theme-editor-title">@DocumentTitle</span>
        <div class="toolbar-group">
            <label class="toolbar-label" for="theme-new-base">@L["Toolbar.NewFrom"]</label>
            <select id="theme-new-base" class="toolbar-select" @bind="_newBaseThemeId">
                @foreach (ThemeDefinition theme in ThemeCatalog.AllThemes)
                {
                    <option value="@theme.Id">@theme.DisplayName</option>
                }
            </select>
            <button type="button" id="theme-btn-new" class="toolbar-button" disabled="@_busy" @onclick="NewAsync">@L["Toolbar.New"]</button>
            <button type="button" id="theme-btn-open" class="toolbar-button" disabled="@_busy" @onclick="OpenAsync">@L["Toolbar.Open"]</button>
            <button type="button" id="theme-btn-save" class="toolbar-button is-primary" disabled="@_busy" @onclick="SaveAsync">@L["Toolbar.Save"]</button>
            <button type="button" id="theme-btn-export" class="toolbar-button" disabled="@_busy" @onclick="ExportAsync">@L["Toolbar.Export"]</button>
        </div>
        <div class="toolbar-group">
            <button type="button" id="theme-btn-use-desktop" class="toolbar-button" disabled="@(_busy || !_document.ForDesktop)" @onclick="() => UseAsync(ThemePlatform.Desktop)">@L["Toolbar.UseDesktop"]</button>
            <button type="button" id="theme-btn-use-mobile" class="toolbar-button" disabled="@(_busy || !_document.ForMobile)" @onclick="() => UseAsync(ThemePlatform.Mobile)">@L["Toolbar.UseMobile"]</button>
        </div>
    </header>

    @if (_message is not null)
    {
        <div class="editor-message @(_messageIsError ? "is-error" : "is-info")" role="@(_messageIsError ? "alert" : "status")">
            <span>@_message</span>
            <button type="button" class="link-button" @onclick="() => _message = null">@L["Message.Dismiss"]</button>
        </div>
    }

    <div class="editor-body">
        <aside class="editor-sidebar" aria-label="@L["Sidebar.AriaLabel"]">
            <section class="sidebar-section">
                <h3>@L["Sidebar.Theme"]</h3>
                <label for="theme-name">@L["Field.Name"]</label>
                <input id="theme-name" class="field" maxlength="80" value="@_document.Name" @onchange="OnNameChanged" />
                <label for="theme-id">@L["Field.Id"]</label>
                <input id="theme-id" class="field mono" maxlength="64" value="@_document.Id" @onchange="OnIdChanged" />
                <label for="theme-base">@L["Field.Base"]</label>
                <select id="theme-base" class="field" value="@_document.BaseThemeId" @onchange="OnBaseChanged">
                    @foreach (ThemeDefinition theme in ThemeCatalog.AllThemes)
                    {
                        <option value="@theme.Id">@theme.DisplayName (@PlatformText(theme.Platform))</option>
                    }
                </select>
                <fieldset class="platforms">
                    <legend>@L["Field.OfferedOn"]</legend>
                    <label><input type="checkbox" checked="@_document.ForDesktop" @onchange="OnDesktopChanged" /> @L["Platform.DesktopLabel"]</label>
                    <label><input type="checkbox" checked="@_document.ForMobile" @onchange="OnMobileChanged" /> @L["Platform.MobileLabel"]</label>
                </fieldset>
                <p class="sidebar-hint">@L["Sidebar.TokenCount", _document.TokenCount]</p>
                <p class="sidebar-hint mono">@(_document.Path ?? SavePathHint)</p>
            </section>

            <section class="sidebar-section">
                <h3>@L["Sidebar.Installed"]</h3>
                @if (_library.Themes.Count == 0)
                {
                    <p class="sidebar-hint">@L["Sidebar.NoThemes"]</p>
                }
                <ul class="theme-list">
                    @foreach (UserTheme theme in _library.Themes)
                    {
                        <li>
                            <button type="button" class="theme-entry @(theme.SourcePath == _document.Path ? "is-current" : "")" @onclick="() => OpenInstalledAsync(theme)">
                                <span class="theme-entry-name">@theme.Name</span>
                                <span class="theme-entry-meta">@theme.Id · @(theme.Origin == ThemeOrigin.System ? "/etc" : "~")</span>
                            </button>
                        </li>
                    }
                </ul>
                @if (_library.Diagnostics.Count > 0)
                {
                    <details class="diagnostics">
                        <summary>@L["Sidebar.Warnings", _library.Diagnostics.Count]</summary>
                        <ul>
                            @foreach (ThemeFileDiagnostic diagnostic in _library.Diagnostics)
                            {
                                <li class="mono">@diagnostic.ToString(Strings.CultureOf(L))</li>
                            }
                        </ul>
                    </details>
                }
            </section>
        </aside>

        <main class="editor-tokens" aria-label="@L["Tokens.AriaLabel"]">
            <MudTabs Elevation="0" ApplyEffectsToContainer="true" KeepPanelsAlive="false" Class="token-tabs" TabPanelsClass="token-panel">
                @foreach (ThemeTokenGroup group in Enum.GetValues<ThemeTokenGroup>())
                {
                    <MudTabPanel Text="@GroupLabel(group)">
                        <p class="group-intro">@GroupIntro(group)</p>
                        <div class="token-grid">
                            @foreach (ThemeTokenDefinition token in ThemeTokenCatalog.InGroup(group))
                            {
                                <ThemeTokenField @key="token.Name"
                                                 Token="token"
                                                 Value="@_document.GetValue(token.Name)"
                                                 Error="@_document.GetError(token.Name)"
                                                 ValueChanged="value => OnTokenChanged(token.Name, value)" />
                            }
                        </div>
                    </MudTabPanel>
                }
                <MudTabPanel Text="@L["Tab.Documentation"]">
                    <ThemeTokenDocumentation />
                </MudTabPanel>
            </MudTabs>
        </main>

        <aside class="editor-preview" aria-label="@L["Preview.AriaLabel"]">
            <div class="preview-switch" role="group" aria-label="@L["Preview.Switch"]">
                <button type="button" class="toolbar-button @(_previewPlatform == ThemePlatform.Desktop ? "is-active" : "")" aria-pressed="@(_previewPlatform == ThemePlatform.Desktop ? "true" : "false")" @onclick="() => _previewPlatform = ThemePlatform.Desktop">@L["Platform.DesktopLabel"]</button>
                <button type="button" class="toolbar-button @(_previewPlatform == ThemePlatform.Mobile ? "is-active" : "")" aria-pressed="@(_previewPlatform == ThemePlatform.Mobile ? "true" : "false")" @onclick="() => _previewPlatform = ThemePlatform.Mobile">@L["Platform.MobileLabel"]</button>
            </div>
            <ThemeEditorPreview BaseThemeId="@_document.BaseThemeId"
                                Platform="@_previewPlatform"
                                Tokens="@_document.ValidTokens"
                                ThemeName="@DisplayName" />
        </aside>
    </div>
</div>
