@namespace HackerOs.Windowing.Blazor
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<article class="@HostClass"
         @ref="_hostElement"
         role="dialog"
         tabindex="-1"
         aria-modal="@(Window.Modality == WindowModality.OwnerModal ? "true" : "false")"
         aria-hidden="@(IsInteractionBlocked ? "true" : "false")"
         aria-labelledby="@(ShowChrome ? TitleId : null)"
         aria-label="@(ShowChrome ? null : Window.Title)"
         inert="@(IsInteractionBlocked ? true : null)"
         aria-busy="@(Window.IsResponding ? null : "true")"
         data-window-id="@Window.Id"
         data-window-x="@Window.Bounds.X.ToString(System.Globalization.CultureInfo.InvariantCulture)"
         data-window-y="@Window.Bounds.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)"
         data-window-width="@Window.Bounds.Width.ToString(System.Globalization.CultureInfo.InvariantCulture)"
         data-window-height="@Window.Bounds.Height.ToString(System.Globalization.CultureInfo.InvariantCulture)"
         data-window-state="@Window.VisualState"
         data-window-snapped="@(Window.IsSnapped ? "true" : null)"
         data-window-z="@Window.ZOrder"
         hidden="@(IsHidden ? true : null)"
         @onpointerdown="FocusAsync">
    @if (ShowChrome)
    {
        <WindowChrome Window="Window"
                      TitleId="@TitleId"
                      OnFocus="OnFocus"
                      OnMinimize="OnMinimize"
                      OnToggleMaximize="OnToggleMaximize"
                      OnClose="OnClose"
                      OnBack="OnBack"
                      OnWindowMenu="OnWindowMenu"
                      OnGesture="OnGesture" />
    }
    <div class="window-content">
        @ChildContent
    </div>
    @if (Overlay is not null)
    {
        @* Window-attached layer above the content and below the chrome's z-order neighbours, e.g. the
           "not responding" dialog of ADR 0127 §3: it belongs to this window only. *@
        <div class="@(ShowChrome ? "window-overlay" : "window-overlay is-chromeless")">
            @Overlay
        </div>
    }
</article>

@code {
    /// <summary>Gets or sets the authoritative snapshot rendered by this host.</summary>
    [Parameter, EditorRequired]
    public WindowRuntimeState Window { get; set; } = null!;

    /// <summary>Gets or sets the app content rendered inside the chrome.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets content layered over this window's content area only, such as the platform's
    /// "not responding" dialog (ADR 0127 §3). Nothing is rendered when it is <see langword="null"/>.
    /// </summary>
    [Parameter]
    public RenderFragment? Overlay { get; set; }

    /// <summary>
    /// Gets or sets whether the floating-window chrome (title bar, drag/resize handles, chrome
    /// buttons) is rendered around the content. Defaults to <see langword="true"/> for source
    /// compatibility with every existing caller; a chromeless host (plan
    /// doc/en/wasm/dev/old/mobile-interface-platform-plan.md §7.1, <c>MOB-009</c>) sets this <see langword="false"/>
    /// so a pinned single surface has no floating-window affordances to interact with.
    /// </summary>
    [Parameter]
    public bool ShowChrome { get; set; } = true;

    /// <summary>Gets or sets the focus request callback.</summary>
    [Parameter]
    public EventCallback<WindowId> OnFocus { get; set; }

    /// <summary>Gets or sets the minimize request callback.</summary>
    [Parameter]
    public EventCallback<WindowId> OnMinimize { get; set; }

    /// <summary>Gets or sets the maximize/restore request callback.</summary>
    [Parameter]
    public EventCallback<WindowId> OnToggleMaximize { get; set; }

    /// <summary>Gets or sets the close request callback.</summary>
    [Parameter]
    public EventCallback<WindowId> OnClose { get; set; }

    /// <summary>Gets or sets the Back request callback.</summary>
    [Parameter]
    public EventCallback<WindowId> OnBack { get; set; }

    /// <summary>Gets or sets the window menu request callback (ADR 0095 §3).</summary>
    [Parameter]
    public EventCallback<WindowMenuRequest> OnWindowMenu { get; set; }

    /// <summary>Gets or sets the pointer gesture command callback.</summary>
    [Parameter]
    public EventCallback<WindowCommand> OnGesture { get; set; }

    /// <summary>Gets or sets whether an owner-modal child blocks this host.</summary>
    [Parameter]
    public bool IsInteractionBlocked { get; set; }

    private string TitleId => $"window-title-{Window.Id.Value:N}";
    private ElementReference _hostElement;
    private IJSObjectReference? _module;

    /// <summary>Whether the window was the focused one at the previous render, to move the keyboard focus on the transition only.</summary>
    private bool _wasFocused;

    /// <summary>The snapshot of the previous parameters, to find which animation a change plays (ADR 0198).</summary>
    private WindowRuntimeState? _previous;

    /// <summary>The animation the next render plays: "open", "minimize", "restore", "geometry" or "none".</summary>
    private string _pendingTransition = "open";

    /// <summary>
    /// Counts the minimize animations: the window keeps being drawn while the latest one runs, and
    /// gets its <c>hidden</c> attribute when it ends (ADR 0198 §2). A restore during the animation
    /// makes it stale.
    /// </summary>
    private int _minimizeGeneration;
    private int _minimizingGeneration = -1;

    /// <summary>
    /// Whether the first render is still to open the window: it is drawn transparent until its open
    /// animation starts, so the module import never shows it unanimated for a frame.
    /// </summary>
    private bool _opening;

    private bool _disposed;

    /// <summary>A minimized window is hidden once its minimize animation has ended.</summary>
    private bool IsHidden =>
        Window.VisualState == WindowVisualState.Minimized && _minimizingGeneration != _minimizeGeneration;

    private string HostClass => string.Join(
        ' ',
        "window-host",
        Window.IsFocused ? "is-focused" : "is-background",
        Window.VisualState == WindowVisualState.Maximized ? "is-maximized" : "is-normal",
        Window.IsResponding ? string.Empty : "is-not-responding",
        _opening ? "is-opening" : string.Empty).Trim();

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        WindowRuntimeState? previous = _previous;
        _previous = Window;
        if (previous is null || !ShowChrome)
        {
            // The first render opens the window (unless it starts minimized); a chromeless host
            // (one pinned surface on mobile) has no window animations.
            _pendingTransition = ShowChrome && Window.VisualState != WindowVisualState.Minimized ? "open" : "none";
            _opening = _pendingTransition == "open";
            return;
        }

        string transition = TransitionBetween(previous, Window);
        if (transition == "minimize")
        {
            _minimizeGeneration++;
            _minimizingGeneration = _minimizeGeneration;
        }
        else if (transition == "restore")
        {
            _minimizingGeneration = -1;
        }

        // A render without a change keeps an animation not played yet (two parameter sets before
        // one render).
        if (transition != "none" || _pendingTransition == "none")
        {
            _pendingTransition = transition;
        }
    }

    /// <summary>The animation that a change of window snapshot plays (ADR 0198 §1).</summary>
    private static string TransitionBetween(WindowRuntimeState previous, WindowRuntimeState current)
    {
        bool wasMinimized = previous.VisualState == WindowVisualState.Minimized;
        bool isMinimized = current.VisualState == WindowVisualState.Minimized;
        if (!wasMinimized && isMinimized)
        {
            return "minimize";
        }

        if (wasMinimized && !isMinimized)
        {
            return "restore";
        }

        return !isMinimized && (previous.VisualState != current.VisualState || previous.IsSnapped != current.IsSnapped)
            ? "geometry"
            : "none";
    }

    private Task FocusAsync(PointerEventArgs _) =>
        IsInteractionBlocked ? Task.CompletedTask : OnFocus.InvokeAsync(Window.Id);

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/HackerOs.Windowing.Blazor/WindowHost.razor.js");
            await _module.InvokeVoidAsync("trackFocus", _hostElement);
        }

        if (_module is not null)
        {
            string transition = _pendingTransition;
            _pendingTransition = "none";
            int minimizeGeneration = _minimizeGeneration;
            Task projection = ProjectGeometryAsync(transition);
            if (transition == "minimize")
            {
                // Hidden at the end of the animation, without holding this render: the focus moves
                // to the next window meanwhile.
                _ = HideAfterMinimizeAsync(projection, minimizeGeneration);
            }
            else
            {
                await projection;
            }

            // The script took the class away when the animation started; later renders leave it out.
            _opening = false;

            // A window that becomes the focused one (Alt+`, Alt+Q on the window above it, the
            // taskbar) takes the keyboard focus too, or keyboard users are left on <body> with
            // a window that only looks focused (ADR 0105 §4).
            bool becameFocused = Window.IsFocused && !_wasFocused && !IsInteractionBlocked;
            _wasFocused = Window.IsFocused;
            if (becameFocused)
            {
                try
                {
                    await _module.InvokeVoidAsync("focusWindow", _hostElement);
                }
                catch (Exception ex)
                {
                    Console.Error.WriteLine($"[WindowHost] Failed to move the keyboard focus: {ex.Message}");
                }
            }
        }
    }

    private async Task ProjectGeometryAsync(string transition)
    {
        try
        {
            await _module!.InvokeVoidAsync(
                "projectWindowGeometry",
                _hostElement,
                Window.Bounds.X,
                Window.Bounds.Y,
                Window.Bounds.Width,
                Window.Bounds.Height,
                Window.ZOrder,
                transition,
                Window.Id.ToString());
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[WindowHost] Failed to project window geometry: {ex.Message}");
        }
    }

    private async Task HideAfterMinimizeAsync(Task animation, int generation)
    {
        await animation;
        if (!_disposed && _minimizingGeneration == generation)
        {
            _minimizingGeneration = -1;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is null)
        {
            return;
        }

        try
        {
            // The close animation plays on a frozen copy of the window (ADR 0198 §4).
            if (ShowChrome)
            {
                try
                {
                    await _module.InvokeVoidAsync("playClose", _hostElement);
                }
                catch (JSException ex)
                {
                    Console.Error.WriteLine($"[WindowHost] Failed to play the close animation: {ex.Message}");
                }
            }

            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
