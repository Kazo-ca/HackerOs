@namespace HackerOs.Apps.FileExplorer.FileControl
@inherits HackerOs.AppSdk.Blazor.HackComponentBase

@*
    Root of the lazily-expandable Tree renderer (FV-004). Top-level nodes mirror the same Items the other
    two modes show for the current directory; each directory node expands further children in place via
    FileViewTreeNode, without changing Owner.CurrentDirectory. See
    doc/en/wasm/dev/old/Global-FileView-And-MessagingSystem/FileViewControl.md.
*@
<ul class="file-view-tree" role="tree" aria-multiselectable="@(Owner.AllowMultiSelect ? "true" : "false")">
    @foreach (FileViewTreeNodeState node in RootNodes)
    {
        <FileViewTreeNode Owner="Owner" Root="this" Node="node" Depth="1" />
    }
</ul>
