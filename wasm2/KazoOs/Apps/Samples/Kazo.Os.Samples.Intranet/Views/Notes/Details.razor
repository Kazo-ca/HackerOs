@inherits KazoView<Note>
@layout _Layout
@{ ViewData.Title = Model.Title; }
<article class="panel narrow" id="note-details">
    <p class="prompt">$ cat notes/@(Model.Id).md</p>
    <h1>@Model.Title @if (Model.Pinned) { <span class="badge">pinned</span> }</h1>
    <p class="note-text">@Model.Body</p>
    <p class="card-meta">by @Model.Author · @Model.UpdatedAt.ToString("yyyy-MM-dd HH:mm") UTC</p>
    <div class="actions">
        <KazoLink Action="Edit" RouteValues="@KazoRoute.Values(new { id = Model.Id })" class="button" id="note-edit">Edit</KazoLink>
        <KazoForm Action="Delete" RouteValues="@KazoRoute.Values(new { id = Model.Id })" class="inline">
            <button type="submit" class="button danger" id="note-delete">Delete</button>
        </KazoForm>
        <KazoLink Action="Index" class="button ghost">Back to the list</KazoLink>
    </div>
</article>
