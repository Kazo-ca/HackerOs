@inherits HackView<ContactForm>
@layout _Layout
<HackValidationSummary ModelOnly="true" />
<HackForm Action="Edit" class="edit">
    <label>Name <input name="Name" value="@Model.Name" /></label>
    <HackValidationMessage For="Name" />
    <label>Age <input name="Age" value="@Model.Age" /></label>
    <HackValidationMessage For="Age" />
    <button type="submit">Save</button>
</HackForm>
<HackForm Href="~/search" Method="get"><input name="q" /></HackForm>
