<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Deque.AxeCore.Playwright" Version="4.14.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.64.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Each test spins up its own dotnet build+run of the shared test/test harness
         project; running test classes in parallel makes them race on that project's
         shared obj/bin output and randomly fails with file-lock build errors. -->
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\test\test\test.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\Platform\Kazo.Os.Platform.Core\Kazo.Os.Platform.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kazo.Os.E2E.Support\Kazo.Os.E2E.Support.csproj" />
    <Using Include="Kazo.Os.E2E.Support" />
  </ItemGroup>

</Project>
