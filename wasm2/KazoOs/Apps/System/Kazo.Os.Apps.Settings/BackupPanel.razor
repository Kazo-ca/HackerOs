@inherits Kazo.Os.AppSdk.Blazor.KazoComponentBase
@using Kazo.Os.AppSdk.Administration

<div class="setting-group backup-panel">
    <h4>@L["Backup.Create.Title"]</h4>
    <p class="setting-desc">
        @LocalizedMarkup.Format(L["Backup.Create.Description"],
            LocalizedMarkup.Strong(L["Backup.Create.Everything"]),
            LocalizedMarkup.Code("/etc"),
            LocalizedMarkup.Code(".hosbak"),
            LocalizedMarkup.Code("sudo hackbackup create"))
    </p>
    <button type="button" class="btn-secondary" disabled="@IsBusy" @onclick="CreateAsync">
        @(_operation == Operation.Create ? L["Backup.Creating"] : L["Backup.Create"])
    </button>
    @if (_lastBackup is not null)
    {
        <p class="backup-result" role="status">
            @LocalizedMarkup.Format(L["Backup.Result"],
                LocalizedMarkup.Code(_lastBackup.FileName),
                FormatSize(_lastBackup.SizeBytes),
                _lastBackup.RecordCount.ToString("N0", Formats))
        </p>
    }
</div>

<div class="setting-group backup-panel danger-zone">
    <h4>@L["Backup.Restore.Title"]</h4>
    <p class="setting-desc">
        @LocalizedMarkup.Format(L["Backup.Restore.Description"],
            LocalizedMarkup.Code(".hosbak"),
            LocalizedMarkup.Code("sudo hackbackup restore --merge"),
            LocalizedMarkup.Code("--replace"))
    </p>
    <div class="restore-modes" role="radiogroup" aria-label="@L["Backup.Mode.AriaLabel"]">
        <button type="button" role="radio" class="@ModeClass(KazoBackupRestoreMode.Merge)"
                aria-checked="@(_mode == KazoBackupRestoreMode.Merge ? "true" : "false")"
                disabled="@IsBusy"
                @onclick="() => _mode = KazoBackupRestoreMode.Merge">
            <span class="restore-mode-title">@L["Backup.Mode.Merge"]</span>
            <span class="restore-mode-desc">@L["Backup.Mode.Merge.Description"]</span>
        </button>
        <button type="button" role="radio" class="@ModeClass(KazoBackupRestoreMode.Replace)"
                aria-checked="@(_mode == KazoBackupRestoreMode.Replace ? "true" : "false")"
                disabled="@IsBusy"
                @onclick="() => _mode = KazoBackupRestoreMode.Replace">
            <span class="restore-mode-title">@L["Backup.Mode.Replace"]</span>
            <span class="restore-mode-desc">@L["Backup.Mode.Replace.Description"]</span>
        </button>
    </div>
    <button type="button" class="@(_mode == KazoBackupRestoreMode.Replace ? "btn-danger" : "btn-secondary")"
            disabled="@IsBusy" @onclick="RestoreAsync">
        @(_operation == Operation.Restore ? L["Backup.Restoring"] : L["Backup.Restore"])
    </button>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <p class="dialog-error" role="alert">@_error</p>
}
