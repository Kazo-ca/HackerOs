<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../Packaging.props" />

  <PropertyGroup>
    <PackageId>HackerOs.Platform.ResourceAccounting</PackageId>
    <Description>Optional measured CPU time and process memory for KazoOS (ADR 0066). Referenced by a host only when accounting is compiled in.</Description>
    <PackageTags>hackeros;platform;accounting</PackageTags>
  </PropertyGroup>

  <!--
    ADR 0066: the measuring half of the optional resource accounting. It depends on Platform Core,
    never the reverse. A host references it only through build/HackerOs.ResourceAccounting.targets,
    and only when HackerOsCpuAccounting or HackerOsMemoryAccounting is true: with both false, none
    of this code is in the binary.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HackerOs.Platform.Core\HackerOs.Platform.Core.csproj" />
    <ProjectReference Include="..\..\Shared\HackerOs.AppSdk\HackerOs.AppSdk.csproj" />
    <ProjectReference Include="..\..\Shared\HackerOs.Simulation.Abstractions\HackerOs.Simulation.Abstractions.csproj" />
  </ItemGroup>

</Project>
