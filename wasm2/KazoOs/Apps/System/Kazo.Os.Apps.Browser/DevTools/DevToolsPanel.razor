@using Kazo.Os.Apps.Browser.DevTools
@inherits Kazo.Os.AppSdk.Blazor.HackComponentBase
@implements IDisposable
@* Developer tools of the browser (ADR 0075 §2): Network and Console panels of the current page. *@

<section class="devtools" aria-label="@L["DevTools.Label"]">
    <div class="devtools-bar" role="tablist" aria-label="@L["DevTools.Panels"]">
        <button id="devtools-tab-network" role="tab" class="devtools-tab @(_tab == Panel.Network ? "active" : null)"
                aria-selected="@(_tab == Panel.Network ? "true" : "false")" @onclick="() => _tab = Panel.Network">
            @L["DevTools.Network"] <span class="devtools-count">@_network.Count</span>
        </button>
        <button id="devtools-tab-console" role="tab" class="devtools-tab @(_tab == Panel.Console ? "active" : null)"
                aria-selected="@(_tab == Panel.Console ? "true" : "false")" @onclick="() => _tab = Panel.Console">
            @L["DevTools.Console"]
            @if (_errors > 0)
            {
                <span class="devtools-errors">@_errors</span>
            }
        </button>
        <span class="devtools-spacer"></span>
        <button class="devtools-action" title="@L["DevTools.Clear"]" @onclick="Log.Clear">&#8856;</button>
        <button class="devtools-action" title="@L["DevTools.Close"]" @onclick="OnClose">&#10005;</button>
    </div>

    @if (_tab == Panel.Network)
    {
        <div class="devtools-body" role="tabpanel" aria-labelledby="devtools-tab-network">
            @if (_network.Count == 0)
            {
                <p class="devtools-empty">@L["DevTools.Recording"]</p>
            }
            else
            {
                <table class="network-table">
                    <thead>
                        <tr><th>@L["DevTools.Column.Name"]</th><th>@L["DevTools.Column.Method"]</th><th>@L["DevTools.Column.Status"]</th><th>@L["DevTools.Column.Type"]</th><th>@L["DevTools.Column.Size"]</th><th>@L["DevTools.Column.Time"]</th></tr>
                    </thead>
                    <tbody>
                        @foreach (NetworkLogEntry entry in _network)
                        {
                            <tr class="@(entry.IsFailure ? "failed" : null)" title="@entry.Url">
                                <td class="network-name">@ShortName(entry.Url)</td>
                                <td>@entry.Method</td>
                                <td>@(entry.Error ?? entry.StatusCode.ToString(System.Globalization.CultureInfo.InvariantCulture))</td>
                                <td>@KindLabel(entry)</td>
                                <td>@FormatSize(entry.Size)</td>
                                <td>@FormatDuration(entry.Duration)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
    else
    {
        <div class="devtools-body console-body" role="tabpanel" aria-labelledby="devtools-tab-console">
            @if (_console.Count == 0)
            {
                <p class="devtools-empty">@L["DevTools.NoMessages"]</p>
            }
            @foreach (ConsoleLogEntry entry in _console)
            {
                <div class="console-line level-@entry.Level.ToString().ToLowerInvariant()">
                    <span class="console-message">@entry.Message</span>
                    @if (entry.Source.Length > 0)
                    {
                        <span class="console-source">@entry.Source</span>
                    }
                </div>
            }
        </div>
    }
</section>
