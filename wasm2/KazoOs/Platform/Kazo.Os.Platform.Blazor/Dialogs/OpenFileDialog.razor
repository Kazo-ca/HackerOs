@namespace Kazo.Os.Platform.Blazor.Dialogs
@using Kazo.Os.App.Abstractions
@using Kazo.Os.AppSdk.Blazor
@using Kazo.Os.Simulation.Abstractions.FileSystem
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@inject IStringLocalizer<Strings> L

<section class="file-dialog" role="dialog" aria-modal="true" aria-labelledby="@TitleId"
         tabindex="-1" @onkeydown="HandleKeyDown">
    <header>
        <MudIcon Icon="@Icons.Material.Filled.FolderOpen" />
        <h2 id="@TitleId">@(Presentation.Request.Title ?? L["FileDialog.OpenFile"])</h2>
    </header>

    @if (Presentation.Request.Filters.Count > 1)
    {
        <label class="filter-control">
            <span>@L["FileDialog.FileType"]</span>
            <select value="@_filterIndex" @onchange="ChangeFilter">
                @for (int index = 0; index < Presentation.Request.Filters.Count; index++)
                {
                    <option value="@index">@Presentation.Request.Filters[index].DisplayName</option>
                }
            </select>
        </label>
    }

    <FileDialogBrowser @ref="_browser"
                       Context="@Presentation.Context"
                       FileSystem="@Presentation.FileSystem"
                       InitialDirectory="@EffectiveInitialDirectory"
                       AllowFileSelection="true"
                       AllowDirectorySelection="false"
                       AllowMultipleSelection="@Presentation.Request.AllowMultiple"
                       FileFilter="MatchesFilter"
                       SelectionChanged="UpdateSelection"
                       FileActivated="OpenActivated" />

    <footer>
        <span class="selection-summary" aria-live="polite">@SelectionSummary</span>
        <button type="button" class="secondary" @onclick="Cancel">@L["Common.Cancel"]</button>
        <button type="button" class="primary" disabled="@(_selection.Count == 0)" @onclick="Open">@L["Common.Open"]</button>
    </footer>
</section>

@code {
    /// <summary>Gets or sets the active open-file presentation.</summary>
    [Parameter, EditorRequired]
    public OpenFileDialogPresentation Presentation { get; set; } = null!;

    /// <summary>Gets or sets the owning session coordinator.</summary>
    [Parameter, EditorRequired]
    public FileDialogCoordinator Coordinator { get; set; } = null!;

    private readonly string _titleId = $"open-file-title-{Guid.NewGuid():N}";
    private FileDialogBrowser? _browser;
    private IReadOnlyList<VirtualPath> _selection = [];
    private int _filterIndex;

    private VirtualPath EffectiveInitialDirectory =>
        Presentation.Request.InitialDirectory ?? VirtualPath.Parse($"/home/{Presentation.UserId}");

    private string TitleId => _titleId;
    private string SelectionSummary => _selection.Count switch
    {
        0 => L["FileDialog.NoFileSelected"],
        1 => _selection[0].Value,
        _ => L["FileDialog.FilesSelected", _selection.Count],
    };

    private void UpdateSelection(IReadOnlyList<VirtualPath> selection) => _selection = selection;

    private void ChangeFilter(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out int index)
            && index >= 0
            && index < Presentation.Request.Filters.Count)
        {
            _filterIndex = index;
            _selection = [];
            _browser?.RefreshFilter();
        }
    }

    /// <summary>Whether a regular file matches the chosen file type, by extension or media type.</summary>
    private bool MatchesFilter(string name, string? mediaType)
    {
        if (Presentation.Request.Filters.Count == 0)
        {
            return true;
        }

        FileDialogFilter filter = Presentation.Request.Filters[_filterIndex];
        bool extensionMatches = filter.Extensions.Any(
            extension => name.EndsWith(extension, StringComparison.OrdinalIgnoreCase));
        bool mediaTypeMatches = mediaType is not null
            && filter.MediaTypes.Contains(mediaType, StringComparer.OrdinalIgnoreCase);
        return (filter.Extensions.Count == 0 && filter.MediaTypes.Count == 0)
            || extensionMatches
            || mediaTypeMatches;
    }

    private void Open()
    {
        if (_selection.Count > 0)
        {
            Coordinator.SelectOpen(Presentation.Id, _selection);
        }
    }

    // Double-click/Enter on a file opens it (the selection already holds it; with multiple
    // selection the whole selection opens, like Ctrl-clicking then double-clicking in GTK). A file
    // opened from the menu without being selected first opens alone.
    private void OpenActivated(VirtualPath path)
    {
        if (!_selection.Contains(path))
        {
            _selection = [path];
        }

        Open();
    }

    private void Cancel() => Coordinator.Cancel(Presentation.Id);

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            Cancel();
        }
    }
}