<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="..\..\Platform\Packaging.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Kazo.Os.AppSdk.Icons</PackageId>
    <Description>Framework-independent icon catalog and native Blazor SVG renderer used by Kazo OS apps and reusable shell packages.</Description>
    <PackageTags>hackeros;icons;svg;blazor;app-sdk</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\bootstrap-icons.json" LogicalName="Kazo.Os.AppSdk.Icons.Data.bootstrap-icons.json" />
    <EmbeddedResource Include="Data\font-awesome.json" LogicalName="Kazo.Os.AppSdk.Icons.Data.font-awesome.json" />
    <EmbeddedResource Include="Data\lucide.json" LogicalName="Kazo.Os.AppSdk.Icons.Data.lucide.json" />
    <EmbeddedResource Include="Data\simple-icons.json" LogicalName="Kazo.Os.AppSdk.Icons.Data.simple-icons.json" />
  </ItemGroup>

</Project>
