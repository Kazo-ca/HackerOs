@namespace HackerOs.Windowing.Blazor
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@inject IServiceProvider LocalizationServices

<main @ref="_desktopElement" class="desktop-area" aria-label="@L["Desktop.Workspace"]">
    <div class="desktop-grid" aria-hidden="true"></div>
    @* ADR 0202 §4: the wallpaper image covers the theme's background and grid, under everything else. *@
    @WallpaperContent
    @if (BackgroundContent is not null && BackgroundInteractive)
    {
        @* ADR 0160 §1: the desktop icons are reachable, by the pointer and by assistive technologies. *@
        <section class="background-layer interactive">
            @BackgroundContent
        </section>
    }
    else if (BackgroundContent is not null)
    {
        <section class="background-layer" aria-hidden="true">
            @BackgroundContent
        </section>
    }
    <section @ref="_windowLayer" class="@WindowLayerClass" aria-label="@L["Desktop.OpenWindows"]" data-display="@DisplayId.Number">
        @foreach (WindowRuntimeState window in RenderedWindows)
        {
            <WindowPortal @key="window.Id" Target="@LayerFor(window)">
                <WindowHost Window="window"
                            IsInteractionBlocked="@IsBlocked(window.Id)"
                            PeekState="@PeekStateOf(window)"
                            OnFocus="OnFocus"
                            OnMinimize="OnMinimize"
                            OnToggleMaximize="OnToggleMaximize"
                            OnClose="OnClose"
                            OnBack="OnBack"
                            OnWindowMenu="OnWindowMenu"
                            OnGesture="OnGesture"
                            Overlay="@(WindowOverlay?.Invoke(window))">
                    @if (WindowContent is not null)
                    {
                        @WindowContent(window)
                    }
                </WindowHost>
            </WindowPortal>
        }
    </section>
</main>

@code {
    /// <summary>The window layer lets the pointer reach an interactive background between the windows (ADR 0160 §1).</summary>
    private string WindowLayerClass => BackgroundInteractive && BackgroundContent is not null ? "window-layer pass-through" : "window-layer";

    private ElementReference _desktopElement;
    private ElementReference _windowLayer;
    private WindowLayers? _registeredLayers;
    private DisplayId _registeredDisplay;
    private IJSObjectReference? _module;
    private DotNetObjectReference<DesktopArea>? _dotNetHelper;

    /// <summary>Gets or sets stable window snapshots ordered back-to-front.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<WindowRuntimeState> Windows { get; set; } = [];

    /// <summary>
    /// Gets or sets the screen this area shows (ADR 0178 §3): its size changes go to that screen's
    /// work area, and it shows only that screen's windows. Screen 1 by default. A screen other than
    /// screen 1 must be added to the window runtime (<see cref="AddDisplayCommand"/>) before its
    /// area renders.
    /// </summary>
    [Parameter]
    public DisplayId DisplayId { get; set; }

    /// <summary>
    /// Gets or sets the window layers shared by the areas of every screen (ADR 0178 §3). The area
    /// of screen 1 then renders every window once and moves each one into the layer of its screen;
    /// the other areas render none. Without it, the area renders the windows of its own screen.
    /// </summary>
    [Parameter]
    public WindowLayers? Layers { get; set; }

    /// <summary>Gets or sets content rendered for each window snapshot.</summary>
    [Parameter]
    public RenderFragment<WindowRuntimeState>? WindowContent { get; set; }

    /// <summary>
    /// Gets or sets optional content rendered in a dedicated layer above the desktop grid background and
    /// below every window (`INT-011`) — e.g. a future desktop-icons feature. Backward compatible: omitting
    /// it renders nothing extra, the same DOM as before this parameter existed.
    /// </summary>
    [Parameter]
    public RenderFragment? BackgroundContent { get; set; }

    /// <summary>
    /// Gets or sets whether <see cref="BackgroundContent"/> receives the pointer and is exposed to
    /// assistive technologies (ADR 0160 §1): the desktop icons. The window layer then lets the pointer
    /// through where there is no window. <see langword="false"/> by default: a decorative background.
    /// </summary>
    [Parameter]
    public bool BackgroundInteractive { get; set; }

    /// <summary>
    /// Gets or sets the wallpaper of this screen (ADR 0202 §4), drawn over the theme's background
    /// and grid and under <see cref="BackgroundContent"/> and the windows. It must take no pointer
    /// and be hidden from assistive technologies. <see langword="null"/> keeps the theme's background.
    /// </summary>
    [Parameter]
    public RenderFragment? WallpaperContent { get; set; }

    /// <summary>
    /// Gets or sets content layered over one window's content area, such as the platform's
    /// "not responding" dialog (ADR 0127 §3); rendered through <see cref="WindowHost.Overlay"/>.
    /// </summary>
    [Parameter]
    public RenderFragment<WindowRuntimeState>? WindowOverlay { get; set; }

    /// <summary>
    /// Gets or sets the window the user peeks at from its taskbar preview (ADR 0199 §5): it shows
    /// alone on its screen, the other windows of that screen see-through. No peek when null.
    /// </summary>
    [Parameter]
    public WindowId? PeekWindowId { get; set; }

    /// <summary>Gets or sets the focus request callback.</summary>
    [Parameter]
    public EventCallback<WindowId> OnFocus { get; set; }

    /// <summary>Gets or sets the minimize request callback.</summary>
    [Parameter]
    public EventCallback<WindowId> OnMinimize { get; set; }

    /// <summary>Gets or sets the maximize/restore request callback.</summary>
    [Parameter]
    public EventCallback<WindowId> OnToggleMaximize { get; set; }

    /// <summary>Gets or sets the close request callback.</summary>
    [Parameter]
    public EventCallback<WindowId> OnClose { get; set; }

    /// <summary>Gets or sets the Back request callback.</summary>
    [Parameter]
    public EventCallback<WindowId> OnBack { get; set; }

    /// <summary>Gets or sets the window menu request callback (ADR 0095 §3).</summary>
    [Parameter]
    public EventCallback<WindowMenuRequest> OnWindowMenu { get; set; }

    /// <summary>Gets or sets the pointer gesture command callback.</summary>
    [Parameter]
    public EventCallback<WindowCommand> OnGesture { get; set; }

    /// <summary>Callback invoked by JS ResizeObserver when the desktop container bounds change.</summary>
    [JSInvokable]
    public async Task OnDesktopResized(double width, double height)
    {
        if (OnGesture.HasDelegate)
        {
            await OnGesture.InvokeAsync(new ChangeViewportCommand(new WindowBounds(0, 0, width, height), DisplayId));
        }
    }

    /// <summary>The windows this area renders: all of them for screen 1 with shared layers, none for the other screens, else its own screen's.</summary>
    private IEnumerable<WindowRuntimeState> RenderedWindows => Layers is null
        ? Windows.Where(window => window.DisplayId == DisplayId)
        : DisplayId.IsPrimary ? Windows : [];

    /// <summary>The layer a window moves to, or <see langword="null"/> to stay in this area (its screen, or a screen not shown).</summary>
    private ElementReference? LayerFor(WindowRuntimeState window) =>
        Layers is not null && window.DisplayId != DisplayId && Layers.TryGetLayer(window.DisplayId, out ElementReference layer)
            ? layer
            : null;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_registeredLayers, Layers) && _registeredDisplay == DisplayId)
        {
            return;
        }

        LeaveLayers();
    }

    private void LeaveLayers()
    {
        if (_registeredLayers is null)
        {
            return;
        }

        _registeredLayers.Changed -= OnLayersChanged;
        _registeredLayers.Unregister(_registeredDisplay, _windowLayer);
        _registeredLayers = null;
    }

    private void OnLayersChanged() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Layers is not null && _registeredLayers is null)
        {
            // Registered after the first render, once the layer element exists.
            _registeredLayers = Layers;
            _registeredDisplay = DisplayId;
            Layers.Changed += OnLayersChanged;
            Layers.Register(DisplayId, _windowLayer);
        }

        if (firstRender)
        {
            _dotNetHelper = DotNetObjectReference.Create(this);
            try
            {
                _module = await JSRuntime.InvokeAsync<IJSObjectReference>(
                    "import",
                    "./_content/HackerOs.Windowing.Blazor/DesktopArea.razor.js");
                await _module.InvokeVoidAsync("observeDesktopSize", _desktopElement, _dotNetHelper);
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"[DesktopArea] Failed to initialize resize observer: {ex.Message}");
            }
        }
    }

    /// <summary>How one window shows during the peek: the peeked window and its dialogs stay, the other windows of its screen turn see-through.</summary>
    private WindowPeekState PeekStateOf(WindowRuntimeState window)
    {
        if (PeekWindowId is not { } peeked
            || Windows.FirstOrDefault(candidate => candidate.Id == peeked) is not { } target)
        {
            return WindowPeekState.None;
        }

        if (window.Id == peeked || window.OwnerId == peeked)
        {
            return WindowPeekState.Shown;
        }

        return window.DisplayId == target.DisplayId ? WindowPeekState.SeeThrough : WindowPeekState.None;
    }

    private bool IsBlocked(WindowId id) => Windows.Any(window =>
        window.Modality == WindowModality.OwnerModal
        && window.OwnerId == id
        && window.VisualState != WindowVisualState.Minimized);

    public async ValueTask DisposeAsync()
    {
        LeaveLayers();
        _dotNetHelper?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch
            {
            }
        }
    }

    /// <summary>Gets the package's texts: the host's session language, or English without localization (ADR 0104).</summary>
    private IStringLocalizer L => _localizer ??= PackageStringLocalizer.Resolve<Strings>(LocalizationServices);
    private IStringLocalizer? _localizer;
}
