@using Kazo.Os.AppSdk.IO
@using Kazo.Os.AppSdk.Icons
@inherits Kazo.Os.AppSdk.Blazor.KazoComponentBase

@*
    Trash view of the file explorer (ADR 0052, section 5). It lists KazoTrash.GetItemsAsync — never the
    raw ~/.local/share/Trash folders — and offers Restore, Delete permanently and Empty trash.
*@
<div class="trash-view">
    <div class="trash-toolbar">
        <span class="trash-title">
            <KazoIcon Library="IconLibrary.Lucide" Name="trash-2" Size="16" /> @L["Trash.Title"]
        </span>
        <span class="trash-spacer"></span>
        <button class="trash-btn" disabled="@(_selected.Count == 0 || _busy)" @onclick="RestoreSelectedAsync" title="@L["Trash.Restore"]">
            <KazoIcon Library="IconLibrary.Lucide" Name="archive-restore" Size="16" /> <span>@L["Trash.Restore"]</span>
        </button>
        <button class="trash-btn danger" disabled="@(_selected.Count == 0 || _busy)" @onclick="DeleteSelectedAsync" title="@L["Trash.DeletePermanently"]">
            <KazoIcon Library="IconLibrary.Lucide" Name="octagon-x" Size="16" /> <span>@L["Trash.DeletePermanently"]</span>
        </button>
        <button class="trash-btn danger" disabled="@(_items.Count == 0 || _busy)" @onclick="EmptyAsync" title="@L["Trash.Empty"]">
            <KazoIcon Library="IconLibrary.Lucide" Name="trash" Size="16" /> <span>@L["Trash.Empty"]</span>
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="trash-error">@_error</div>
    }

    @if (_items.Count == 0)
    {
        <div class="trash-empty">@L["Trash.IsEmpty"]</div>
    }
    else
    {
        <div class="trash-list">
        <table class="trash-table" role="grid" aria-label="@L["Trash.TableAriaLabel"]">
            <thead>
                <tr>
                    <th>@L["Trash.Column.Name"]</th>
                    <th>@L["Trash.Column.Origin"]</th>
                    <th>@L["Trash.Column.Deleted"]</th>
                    <th class="size">@L["Trash.Column.Size"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (KazoTrashItem item in _items)
                {
                    <tr class="@(_selected.Contains(item.Name) ? "selected" : null)"
                        tabindex="0"
                        aria-selected="@(_selected.Contains(item.Name) ? "true" : "false")"
                        @onclick="args => Select(item, args)"
                        @ondblclick="() => RestoreAsync([item])"
                        @onkeydown="args => OnRowKeyDownAsync(item, args)">
                        <td class="name">
                            <KazoIcon Library="IconLibrary.Lucide" Name="@(item.IsDirectory ? "folder" : "file")" Size="14" />
                            @DisplayName(item)
                        </td>
                        <td class="origin">@(OriginalLocation(item) ?? L["Trash.UnknownOrigin"])</td>
                        <td class="date">@FormatDate(item.DeletedAt, FormatCulture)</td>
                        <td class="size">@FormatBytes(item.Length, FormatCulture, L)</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }

    <div class="trash-statusbar">
        <span>@Strings.Plural(L, "Status.Items", _items.Count)</span>
        @if (_selected.Count > 0)
        {
            <span> | @Strings.Plural(L, "Status.Selected", _selected.Count)</span>
        }
    </div>
</div>
