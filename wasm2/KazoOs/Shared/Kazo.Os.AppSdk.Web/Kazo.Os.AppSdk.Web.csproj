<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../Platform/Packaging.props" />

  <PropertyGroup>
    <PackageId>Kazo.Os.AppSdk.Web</PackageId>
    <Description>ASP.Hack: MVC-like web sites hosted inside Kazo OS (controllers, routing, model binding, Razor views, cookie session).</Description>
    <PackageTags>hackeros;app-sdk;asp-hack;web</PackageTags>
  </PropertyGroup>

  <!--
    ASP.Hack (ADR 0076): an ASP.NET MVC-like layer over the SDK's KazoHttpListener. A site is a web
    app process (AppKind.Web) running in the shared web worker; this library gives it a middleware
    pipeline, routing, controllers, model binding, results, per-request DI and a cookie session.
    Views (.razor components rendered to HTML), anti-forgery tokens and the embedded wwwroot come
    with web/7 (ADR 0083).
    The controller route table is generated at build by Kazo.Os.Tools.WebRouteGenerator (ADR 0082),
    which links Routing/KazoRouteTemplate.cs from this project.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kazo.Os.App.Abstractions\Kazo.Os.App.Abstractions.csproj" />
    <ProjectReference Include="..\Kazo.Os.AppSdk\Kazo.Os.AppSdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <!-- ILogger<T> of a site and its debug log /var/log/hackweb/<id>.log (ADR 0088 §5). -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <!-- Views (ADR 0076 §7, web/7): Razor components rendered to static HTML by HtmlRenderer. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kazo.Os.AppSdk.Web.Tests" />
  </ItemGroup>

</Project>
