<Project Sdk="Microsoft.NET.Sdk.Razor">
  <ItemGroup>
    <InternalsVisibleTo Include="HackerOs.Platform.Blazor.Tests" />
  </ItemGroup>

  <Import Project="../Packaging.props" />

  <PropertyGroup>
    <PackageId>HackerOs.Platform.Blazor</PackageId>
    <Description>Kazo OS Blazor shell: desktop, launcher, window launching, dialogs and lazy app loading. For composing an OS host.</Description>
    <PackageTags>hackeros;platform;blazor</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HackerOs.Platform.Core\HackerOs.Platform.Core.csproj" />
    <ProjectReference Include="..\HackerOs.Windowing.Core\HackerOs.Windowing.Core.csproj" />
    <ProjectReference Include="..\HackerOs.Windowing.Blazor\HackerOs.Windowing.Blazor.csproj" />
    <ProjectReference Include="..\HackerOs.Taskbar.Blazor\HackerOs.Taskbar.Blazor.csproj" />
    <ProjectReference Include="..\HackerOs.MobileShell.Blazor\HackerOs.MobileShell.Blazor.csproj" />
    <ProjectReference Include="..\..\Shared\HackerOs.AppSdk.Blazor\HackerOs.AppSdk.Blazor.csproj" />
    <!-- ADR 0084: the OS side of Blazor sites (IHackWebSiteHost). -->
    <ProjectReference Include="..\..\Shared\HackerOs.AppSdk.Web.Blazor\HackerOs.AppSdk.Web.Blazor.csproj" />
    <ProjectReference Include="..\..\Shared\HackerOs.AppSdk.Icons\HackerOs.AppSdk.Icons.csproj" />
    <ProjectReference Include="..\..\Shared\HackerOs.Simulation.Abstractions\HackerOs.Simulation.Abstractions.csproj" />
  </ItemGroup>

</Project>
