@using HackerOs.Simulation.Abstractions.Processes
@using HackerOs.Simulation.Abstractions.Sessions
@inject ISessionService SessionService
@inject IProcessManager ProcessManager
@inject HackerOs.Platform.Core.Lifecycle.AppLifecycleOrchestrator Orchestrator
@inject IStringLocalizer<Strings> L

<div class="modal-backdrop" @onclick="CancelAsync">
    <div class="logout-dialog"
         role="dialog"
         aria-modal="true"
         aria-labelledby="logout-title"
         @onclick:stopPropagation>
        <header class="dialog-header">
            <div class="logout-mark" aria-hidden="true">⏻</div>
            <h2 id="logout-title">@L["Logout.Title"]</h2>
        </header>

        <div class="dialog-body">
            <p>@L["Logout.Body"]</p>

            @if (RunningProcesses.Count > 0)
            {
                <div class="running-processes-section">
                    <span class="section-label">@L["Logout.Processes", RunningProcesses.Count]</span>
                    <ul class="process-list">
                        @foreach (ProcessRecord proc in RunningProcesses)
                        {
                            <li key="@proc.Pid.Value">
                                <span class="proc-name">@proc.AppId</span>
                                <span class="proc-pid">PID @proc.Pid.Value</span>
                            </li>
                        }
                    </ul>
                </div>
            }

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <p class="dialog-error" role="alert">@_errorMessage</p>
            }
        </div>

        <footer class="dialog-footer">
            <button type="button"
                    class="btn-secondary"
                    disabled="@_isSigningOut"
                    @onclick="CancelAsync">
                @L["Common.Cancel"]
            </button>
            <button type="button"
                    class="btn-danger"
                    disabled="@_isSigningOut"
                    @onclick="ConfirmLogoutAsync">
                @(_isSigningOut ? L["Logout.SigningOut"] : L["Logout.SignOut"])
            </button>
        </footer>
    </div>
</div>

@code {
    private bool _isSigningOut;
    private string? _errorMessage;

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnLoggedOut { get; set; }

    private IReadOnlyList<ProcessRecord> RunningProcesses =>
        ProcessManager.GetActiveProcesses()
            .Where(p => p.State == ProcessState.Running || p.State == ProcessState.Starting)
            .ToList();

    private async Task ConfirmLogoutAsync()
    {
        _isSigningOut = true;
        _errorMessage = null;
        try
        {
            // The session's apps stop first, while the desktop can still close their windows.
            if (SessionService.CurrentPrincipal is { } principal)
            {
                await Orchestrator.StopSessionAppsAsync(principal.SessionId);
            }

            await SessionService.LogoutAsync();
            if (OnLoggedOut.HasDelegate)
            {
                await OnLoggedOut.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSigningOut = false;
        }
    }

    private async Task CancelAsync()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }
}
