@using HackerOs.App.Abstractions
@using HackerOs.Infrastructure.Browser.Interop
@using MudBlazor
@using Microsoft.AspNetCore.Components
@using HackerOs.Infrastructure.Browser.Recovery
@using HackerOs.Platform.Blazor.Shell
@using HackerOs.Platform.Core.Sessions
@using HackerOs.Platform.Core.Shell
@using HackerOs.Platform.Core.Appearance
@using HackerOs.Simulation.Abstractions.Recovery
@using HackerOs.Simulation.Abstractions.Sessions
@using HackerOs.Platform.Blazor.Hosting
@using HackerOs.Theming.Abstractions
@using HackerOs.Theming.Blazor
@implements IDisposable
@inject ILocalUserRepository UserRepository
@inject ILocalGroupRepository GroupRepository
@inject GuestAccountService GuestAccounts
@inject ISessionService SessionService
@inject EcosystemBootCoordinator BootCoordinator
@inject IEcosystemHostEnvironment HostEnvironment
@inject WebCryptoPasswordHasher PasswordHasher
@inject UiPlatformPreferenceService PlatformPreference
@inject ThemePreferenceService ThemePreference
@inject AccessibilityPreferenceService Accessibility
@inject HackerOs.Platform.Core.Globalization.SessionTimeZoneService TimeZones
@inject UserThemeCatalogService UserThemes
@inject HackerOs.Platform.Core.Clipboard.HostClipboardBridge HostClipboard
@inject HackerOs.Platform.Core.Globalization.SessionLocaleService SessionLocale
@inject IStringLocalizer<Strings> L
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services

<ThemeScope ThemeId="@ActiveTheme.BaseThemeId"
            Tokens="@ActiveTheme.UserTheme?.Tokens"
            Platform="@ActiveThemePlatform"
            AccentId="@ThemePreference.Current.AccentId"
            AnimationsEnabled="@(!Accessibility.Effective.ReducedMotion)"
            HighContrast="@Accessibility.Effective.HighContrast"
            TextScale="@Accessibility.Effective.TextScale">
<main class="ecosystem-host">
    <MudThemeProvider Theme="_theme" IsDarkMode="true" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />
    @if (State.UpdateAvailable)
    {
        <aside class="@UpdateNoticeClass" role="status">
            <span>@(State.AvailableVersion is { } version ? L["Update.VersionReady", version] : L["Update.Ready"]) @L["Update.Detail"]</span>
            <button type="button" disabled="@IsRestartingForUpdate" @onclick="RestartForUpdateAsync">@L["Update.Restart"]</button>
        </aside>
    }

    <HostErrorBoundary @ref="ErrorBoundary">
        <ChildContent>
        @switch (State.View)
        {
        case EcosystemHostView.Initializing:
            <section class="boot-surface" aria-busy="true">
                <div class="boot-mark" aria-hidden="true">H_</div>
                <h1>HackerOS</h1>
                <p role="status">@L["Boot.Validating"]</p>
            </section>
            break;
        case EcosystemHostView.FirstRun:
            <section class="auth-surface" aria-labelledby="setup-title">
                <div class="boot-mark" aria-hidden="true">H_</div>
                <h1 id="setup-title">@L["Setup.Title"]</h1>
                <p>@L["Setup.Intro"]</p>
                <form @onsubmit="CreateAdministratorAsync" @onsubmit:preventDefault>
                    <label for="setup-login">@L["Setup.LoginName"]</label>
                    <input id="setup-login" autocomplete="username" maxlength="32" required @bind="SetupLogin" />
                    <label for="setup-display">@L["Setup.DisplayName"]</label>
                    <input id="setup-display" autocomplete="name" maxlength="80" required @bind="SetupDisplayName" />
                    <label for="setup-password">@L["Common.Password"]</label>
                    <input id="setup-password" type="password" autocomplete="new-password" minlength="8" required @bind="SetupPassword" />
                    <label for="setup-confirm">@L["Setup.ConfirmPassword"]</label>
                    <input id="setup-confirm" type="password" autocomplete="new-password" minlength="8" required @bind="SetupPasswordConfirmation" />
                    @if (!string.IsNullOrEmpty(FormError))
                    {
                        <p class="form-error" role="alert">@FormError</p>
                    }
                    <button type="submit" disabled="@IsSubmitting">@L["Setup.Submit"]</button>
                </form>
                @* ADR 0187 section 2: offered only here, while no account exists at all. *@
                <div class="guest-start">
                    <p class="guest-separator" aria-hidden="true"><span>@L["Guest.Separator"]</span></p>
                    <button type="button" class="guest-button" disabled="@IsSubmitting" @onclick="StartAsGuestAsync">@L["Guest.Start"]</button>
                    <p class="guest-hint">@L["Guest.StartHint"]</p>
                </div>
                <ProjectInformation />
            </section>
            break;
        case EcosystemHostView.Login:
            <section class="auth-surface" aria-labelledby="login-title">
                <div class="boot-mark" aria-hidden="true">H_</div>
                <h1 id="login-title">@(State.LoneGuest is not null && ShowGuestAccountForm ? L["GuestAccount.Title"] : L["Login.Title"])</h1>
                @if (State.LoneGuest is not null && ShowGuestAccountForm)
                {
                    @* ADR 0187 section 4: "Create my account" belongs to the host, like the first-run form,
                       and runs with the guest session closed (usermod refuses a signed-in user). *@
                    <form class="guest-account" @onsubmit="CreateMyAccountAsync" @onsubmit:preventDefault>
                        <p>@L["GuestAccount.Intro"]</p>
                        <label for="account-login">@L["Setup.LoginName"]</label>
                        <input id="account-login" autocomplete="username" maxlength="32" required @bind="SetupLogin" />
                        <label for="account-display">@L["Setup.DisplayName"]</label>
                        <input id="account-display" autocomplete="name" maxlength="80" required @bind="SetupDisplayName" />
                        <label for="account-password">@L["Common.Password"]</label>
                        <input id="account-password" type="password" autocomplete="new-password" minlength="8" required @bind="SetupPassword" />
                        <label for="account-confirm">@L["Setup.ConfirmPassword"]</label>
                        <input id="account-confirm" type="password" autocomplete="new-password" minlength="8" required @bind="SetupPasswordConfirmation" />
                        <fieldset class="guest-choice">
                            <legend>@L["GuestAccount.Choice"]</legend>
                            <label class="guest-option">
                                <input type="radio" name="guest-choice" checked="@KeepGuestFiles" @onchange="() => KeepGuestFiles = true" />
                                <span><strong>@L["GuestAccount.Migrate"]</strong> <span class="guest-option-hint">@L["GuestAccount.MigrateHint"]</span></span>
                            </label>
                            <label class="guest-option">
                                <input type="radio" name="guest-choice" checked="@(!KeepGuestFiles)" @onchange="() => KeepGuestFiles = false" />
                                <span><strong>@L["GuestAccount.Delete"]</strong> <span class="guest-option-hint">@L["GuestAccount.DeleteHint"]</span></span>
                            </label>
                        </fieldset>
                        @if (!KeepGuestFiles)
                        {
                            <p class="form-warning" role="note">@L["GuestAccount.DeleteWarning"]</p>
                        }
                        @if (!string.IsNullOrEmpty(FormError))
                        {
                            <p class="form-error" role="alert">@FormError</p>
                        }
                        <button type="submit" disabled="@IsSubmitting">@L["GuestAccount.Submit"]</button>
                        <button type="button" class="guest-button" disabled="@IsSubmitting" @onclick="CloseGuestAccountForm">@L["GuestAccount.Back"]</button>
                    </form>
                }
                else if (State.LoneGuest is { } guest)
                {
                    @* ADR 0187 section 3: while the guest is the only account, it signs in directly. *@
                    <div class="guest-login">
                        <p class="guest-name">@guest.DisplayName</p>
                        @if (!string.IsNullOrEmpty(FormError))
                        {
                            <p class="form-error" role="alert">@FormError</p>
                        }
                        <button type="button" class="guest-button" disabled="@IsSubmitting" @onclick="ContinueAsGuestAsync">@L["Guest.Continue"]</button>
                        <button type="button" class="guest-create" disabled="@IsSubmitting" @onclick="OpenGuestAccountForm">@L["GuestAccount.Open"]</button>
                    </div>
                }
                else
                {
                <form @onsubmit="LoginAsync" @onsubmit:preventDefault>
                    <label for="login-user">@L["Login.User"]</label>
                    <select id="login-user" autocomplete="username" required @bind="SelectedLogin">
                        @foreach (LocalUser user in State.Users)
                        {
                            @* ADR 0201 section 4: an account whose session waits in the background resumes it. *@
                            <option value="@user.LoginName.Value">@user.DisplayName (@user.LoginName.Value)@(HasOpenSession(user) ? L["Login.OpenSession"].Value : string.Empty)</option>
                        }
                    </select>
                    <label for="login-password">@L["Common.Password"]</label>
                    <input id="login-password" type="password" autocomplete="current-password" @bind="LoginPassword" />
                    @if (!string.IsNullOrEmpty(FormError))
                    {
                        <p class="form-error" role="alert">@FormError</p>
                    }
                    <button type="submit" disabled="@IsSubmitting">@L["Login.Submit"]</button>
                    @if (SelectedUserHasPasskey)
                    {
                        <button type="button" class="passkey-login" disabled="@IsSubmitting" @onclick="LoginWithPasskeyAsync">@L["Login.UsePasskey"]</button>
                    }
                </form>
                }
                <ProjectInformation />
            </section>
            break;
        case EcosystemHostView.LoginProgress:
            <LoginProgressScreen />
            break;
        case EcosystemHostView.Desktop:
            @if (PlatformPreference.Current.ActivePlatform == WellKnownAppPlatforms.Mobile)
            {
                <MobileShell />
            }
            @* The desktop shell is rendered after this switch, so it can stay in the page during "Switch user" (ADR 0201). *@
            break;
        case EcosystemHostView.Recovery:
            <section class="recovery-surface" aria-labelledby="recovery-title">
                <div class="boot-mark" aria-hidden="true">H_</div>
                <p class="status-label">@L["Recovery.Label"]</p>
                <h1 id="recovery-title">@L["Recovery.Title"]</h1>
                <p>@L["Recovery.Body"]</p>
                <code>@State.Recovery?.ErrorCode</code>
                <code>@L["Correlation", State.Recovery?.CorrelationId.ToString() ?? string.Empty]</code>
                @if (State.Recovery?.Actions.HasFlag(StorageRecoveryActions.Retry) == true)
                {
                    <button type="button" @onclick="InitializeHostAsync">@L["Recovery.Retry"]</button>
                }
                <ProjectInformation ShowLegacyNotice="false" />
            </section>
            break;
            case EcosystemHostView.Fatal:
                <section class="fatal-surface" aria-labelledby="fatal-title">
                    <div class="boot-mark" aria-hidden="true">H_</div>
                    <h1 id="fatal-title">@L["Fatal.Title"]</h1>
                    <p>@L["Fatal.Recorded"]</p>
                    <code>@L["Correlation", State.FatalCorrelationId?.ToString() ?? string.Empty]</code>
                    <ProjectInformation ShowLegacyNotice="false" />
                </section>
                break;
        }
        @if (KeepsDesktopShell)
        {
            @* ADR 0201 section 3: while a session waits in the background, its desktop stays in the page,
               hidden and inert under the sign-in screen, so the apps of that session keep their windows. *@
            <div class="@(ShowsDesktop ? "session-desktop" : "session-desktop is-switched-out")"
                 inert="@(ShowsDesktop ? null : true)"
                 aria-hidden="@(ShowsDesktop ? null : "true")">
                <DesktopShell OnLoggedOut="HandleLoggedOut"
                              OnRestart="HandleRestartAsync"
                              OnSwitchUser="SwitchUserAsync"
                              ForegroundSession="@SessionService.CurrentPrincipal?.SessionId"
                              TestDemoEnabled="@TestDemoEnabled" />
            </div>
        }
        </ChildContent>
        <ErrorContent Context="exception">
            <section class="fatal-surface" aria-labelledby="boundary-fatal-title">
                <div class="boot-mark" aria-hidden="true">H_</div>
                <h1 id="boundary-fatal-title">@L["Fatal.BoundaryTitle"]</h1>
                <p>@L["Fatal.Recorded"]</p>
                <code>@L["Correlation", ErrorBoundary?.CorrelationId?.ToString() ?? string.Empty]</code>
                @if (HostEnvironment.IsDevelopment)
                {
                    <pre class="fatal-details">@exception.ToString()</pre>
                }
                <ProjectInformation ShowLegacyNotice="false" />
            </section>
        </ErrorContent>
    </HostErrorBoundary>
</main>
</ThemeScope>

@code {
    /// <summary>
    /// Enables the E2E-only "Test Demo" fixture-seeding control on the desktop shell.
    /// Set by the hosting page from a trusted, out-of-band signal (e.g. a CLI flag on
    /// the test harness process) — never something an end user's normal launch can set.
    /// See doc/en/wasm/dev/old/e2e-test-demo-mode.md.
    /// </summary>
    [Parameter]
    public bool TestDemoEnabled { get; set; }

    // MudColor intentionally accepts concrete colors only. These values are safe boot/portal
    // fallbacks; ThemeScope's collocated CSS bridges MudBlazor's generated custom properties to
    // the active --hos-* tokens for every themed descendant.
    private static readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Black = "#101417",
            Background = "#101417",
            BackgroundGray = "#151c20",
            Surface = "#172025",
            DrawerBackground = "#151c20",
            DrawerText = "#a8bac4",
            AppbarBackground = "#151c20",
            AppbarText = "#f4f7f8",
            TextPrimary = "#f4f7f8",
            TextSecondary = "#a8bac4",
            TextDisabled = "#6a7e88",
            ActionDefault = "#a8bac4",
            Primary = "#42d392",
            Success = "#42d392",
            Error = "#ff9a91",
            Warning = "#d5a84f",
            Info = "#64b5f6",
            LinesDefault = "#34444c",
            LinesInputs = "#34444c",
            TableLines = "#34444c",
            Divider = "#34444c",
            DividerLight = "#212c32",
        }
    };

    private HostErrorBoundary? ErrorBoundary { get; set; }
    private EcosystemHostState State { get; } = new();
    private string SetupLogin { get; set; } = string.Empty;
    private string SetupDisplayName { get; set; } = string.Empty;
    private string SetupPassword { get; set; } = string.Empty;
    private string SetupPasswordConfirmation { get; set; } = string.Empty;
    private string SelectedLogin { get; set; } = string.Empty;
    private string LoginPassword { get; set; } = string.Empty;
    private string? FormError { get; set; }
    private bool IsSubmitting { get; set; }
    private bool ShowGuestAccountForm { get; set; }
    private bool KeepGuestFiles { get; set; } = true;
    private GuestAccountRequests? GuestRequests { get; set; }
    private bool IsRestartingForUpdate { get; set; }

    // ADR 0162: only the browser host registers it (a server prerender of this component has none).
    private HackerOs.Platform.Blazor.LazyLoading.HostBuildUpdateMonitor? BuildMonitor { get; set; }

    // ADR 0174: reads the served version.json every five minutes (browser host only).
    private HackerOs.Platform.Blazor.LazyLoading.HostReleaseMonitor? ReleaseMonitor { get; set; }

    /// <summary>
    /// The update notice stays above the desktop taskbar or the mobile navigation bar of the shown
    /// session (issue #242); the sign-in screens have no bar, so it keeps the bottom corner there.
    /// </summary>
    private string UpdateNoticeClass => State.View != EcosystemHostView.Desktop
        ? "update-notice"
        : PlatformPreference.Current.ActivePlatform == WellKnownAppPlatforms.Mobile
            ? "update-notice above-mobile-nav"
            : "update-notice above-taskbar";

    private ThemePlatform ActiveThemePlatform =>
        PlatformPreference.Current.ActivePlatform == WellKnownAppPlatforms.Mobile
            ? ThemePlatform.Mobile
            : ThemePlatform.Desktop;

    private string ActiveThemeId => ActiveThemePlatform == ThemePlatform.Mobile
        ? ThemePreference.Current.MobileThemeId
        : ThemePreference.Current.DesktopThemeId;

    /// <summary>
    /// The built-in theme to render and the user theme tokens over it (ADR 0103): an id naming no
    /// theme, or a theme of the other form factor, falls back to the form factor's default.
    /// </summary>
    private ResolvedTheme ActiveTheme => UserThemes.Resolve(ActiveThemeId, ActiveThemePlatform);

    /// <summary>
    /// ADR 0071, section 2: once the desktop is shown (the session is open and its startup apps were
    /// launched by the login), the system is started; Web Workers warm up behind it, when idle.
    /// </summary>
    protected override void OnAfterRender(bool firstRender)
    {
        if (State.View == EcosystemHostView.Desktop)
        {
            BootCoordinator.MarkSystemStarted();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        PlatformPreference.Changed += OnPlatformPreferenceChanged;
        ThemePreference.Changed += OnThemePreferenceChanged;
        UserThemes.Changed += OnThemePreferenceChanged;
        // ADR 0105: high contrast, text size and reduced motion (which also covers animationsEnabled).
        Accessibility.Changed += OnThemePreferenceChanged;
        // ADR 0104: this component outlives every session; its sign-in screens follow the system
        // language at boot and after a sign-out, and the user's language once signed in.
        SessionLocale.Changed += OnSessionLocaleChanged;
        BuildMonitor = Services.GetService<HackerOs.Platform.Blazor.LazyLoading.HostBuildUpdateMonitor>();
        if (BuildMonitor is not null)
        {
            BuildMonitor.UpdatePending += OnBuildUpdatePending;
            State.SetUpdateAvailable(BuildMonitor.IsUpdatePending);
        }

        ReleaseMonitor = Services.GetService<HackerOs.Platform.Blazor.LazyLoading.HostReleaseMonitor>();
        if (ReleaseMonitor is not null)
        {
            ReleaseMonitor.ReleaseAvailable += OnReleaseAvailable;
            if (ReleaseMonitor.AvailableVersion is { } available)
            {
                State.SetAvailableVersion(available);
            }

            ReleaseMonitor.Start(HackerOs.Platform.Blazor.LazyLoading.HostReleaseMonitor.DefaultInterval);
        }

        // ADR 0187 section 5: Settings ▸ Users and the Start menu ask from inside the guest session.
        GuestRequests = Services.GetService<GuestAccountRequests>();
        if (GuestRequests is not null)
        {
            GuestRequests.CreateAccountRequested += OnCreateAccountRequested;
        }

        // Boot creates/reconciles canonical settings documents. Preferences are then loaded before
        // a user can reach a desktop, so the saved theme never depends on opening Settings first.
        await InitializeHostAsync();
    }

    private void OnPlatformPreferenceChanged() => InvokeAsync(StateHasChanged);

    private void OnThemePreferenceChanged() => InvokeAsync(StateHasChanged);

    private void OnSessionLocaleChanged() => InvokeAsync(StateHasChanged);

    private void OnBuildUpdatePending() => InvokeAsync(() =>
    {
        State.SetUpdateAvailable(true);
        StateHasChanged();
    });

    private void OnReleaseAvailable(string version) => InvokeAsync(() =>
    {
        State.SetAvailableVersion(version);
        StateHasChanged();
    });

    /// <summary>
    /// ADR 0162: the OS files were replaced under the running page. Restart like after a system
    /// update: flush the logs, end the session (apps close), then reload the new build.
    /// </summary>
    private async Task RestartForUpdateAsync()
    {
        IsRestartingForUpdate = true;
        if (Services.GetService<HackerOs.Platform.Core.Power.SystemPowerService>() is { } power)
        {
            await power.RestartAfterAsync(static () => Task.CompletedTask);
        }
        else if (Services.GetService<HackerOs.Platform.Core.Power.ISystemPowerDevice>() is { } device)
        {
            await device.RestartAsync();
        }
    }

    /// <inheritdoc />
    public void Dispose()
    {
        PlatformPreference.Changed -= OnPlatformPreferenceChanged;
        ThemePreference.Changed -= OnThemePreferenceChanged;
        UserThemes.Changed -= OnThemePreferenceChanged;
        Accessibility.Changed -= OnThemePreferenceChanged;
        SessionLocale.Changed -= OnSessionLocaleChanged;
        if (BuildMonitor is not null)
        {
            BuildMonitor.UpdatePending -= OnBuildUpdatePending;
        }

        if (ReleaseMonitor is not null)
        {
            ReleaseMonitor.ReleaseAvailable -= OnReleaseAvailable;
        }

        if (GuestRequests is not null)
        {
            GuestRequests.CreateAccountRequested -= OnCreateAccountRequested;
        }
    }

    private async Task InitializeAsync()
    {
        State.BeginInitialization();
        FormError = null;
        try
        {
            EcosystemBootResult result = await BootCoordinator.BootAsync();
            State.CompleteIdentityLoad(result.Users);
            SelectedLogin = State.Users.FirstOrDefault()?.LoginName.Value ?? string.Empty;
        }
        catch (Exception exception)
        {
            State.ShowRecovery(BrowserStorageRecoveryClassifier.Classify(
                exception, StorageRecoveryContext.Boot, Guid.NewGuid()));
        }
    }

    private async Task InitializeHostAsync()
    {
        await InitializeAsync();
        if (State.View is EcosystemHostView.Recovery or EcosystemHostView.Fatal)
        {
            return;
        }

        try
        {
            // ADR 0104: every process may speak French whatever the browser's language, so the
            // French satellite assemblies are loaded once, before any app renders; the sign-in
            // screens then speak the system language (/etc/locale.conf).
            await HackerOs.Infrastructure.Browser.Globalization.BrowserSatelliteAssemblies.LoadAsync(
                HackerOs.AppSdk.Globalization.HackLocale.SupportedLanguages.Select(static culture => culture.Name));
            await SessionLocale.UseSystemLocaleAsync();
            await PlatformPreference.InitializeAsync();
            await ThemePreference.InitializeAsync();
            // After the appearance: animationsEnabled = false counts as reducedMotion = on.
            await Accessibility.InitializeAsync();
            // ADR 0193: the time zone of the clock and of the apps (datetime.config).
            await TimeZones.InitializeAsync();
            await UserThemes.InitializeAsync();
            // Shares clipboard text with the real machine (ADR 0065); never fails the boot.
            await HostClipboard.StartAsync();
        }
        catch (Exception exception)
        {
            // Preference reads use the same IndexedDB boundary as boot. Keep failures inside the
            // root recovery state so the Retry action can rerun the complete initialization path.
            State.ShowRecovery(BrowserStorageRecoveryClassifier.Classify(
                exception, StorageRecoveryContext.Boot, Guid.NewGuid()));
        }
    }

    private async Task CreateAdministratorAsync()
    {
        FormError = null;
        if (SetupPassword.Length < 8 || !StringComparer.Ordinal.Equals(SetupPassword, SetupPasswordConfirmation))
        {
            FormError = L["Setup.PasswordRules"];
            return;
        }

        // The system services' account (ADR 0097) is built in and `guest` belongs to the guest
        // account (ADR 0187): no login account may take a reserved name.
        if (LocalAccountService.IsReserved(SetupLogin))
        {
            FormError = L["Setup.ReservedLogin", SetupLogin.Trim()];
            return;
        }

        IsSubmitting = true;
        try
        {
            LocalLoginName loginName = LocalLoginName.Parse(SetupLogin);
            LocalLoginName groupName = LocalLoginName.Parse("administrators");
            LocalGroup group = await GroupRepository.FindByNameAsync(groupName)
                ?? await GroupRepository.CreateGroupAsync(groupName);
            LocalPasswordCredential credential = await LocalPasswordHasher.CreateAsync(
                SetupPassword,
                asyncHasher: (pwd, salt, iter, len, ct) => PasswordHasher.DeriveKeyAsync(pwd, salt, iter, len, ct));
            await UserRepository.CreateUserAsync(
                loginName,
                SetupDisplayName,
                AppAuthority.Administrator,
                group.Id,
                credential: credential);
            State.BeginLoginProgress();
            StateHasChanged();
            await Task.Delay(50);
            AuthenticatedPrincipal principal = await SessionService.LoginAsync(loginName, SetupPassword);
            await UseSessionLocaleAsync(principal);
            ClearPasswords();
            State.CompleteLogin();
        }
        catch (Exception exception) when (exception is FormatException or InvalidOperationException)
        {
            State.CompleteIdentityLoad(State.Users);
            FormError = exception.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    /// <summary>
    /// ADR 0187 sections 1 and 2: creates the guest account (no password, administrator, display
    /// name in the system language) and opens its session. Refused once any account exists.
    /// </summary>
    private async Task StartAsGuestAsync()
    {
        FormError = null;
        IsSubmitting = true;
        try
        {
            LocalUser guest = await GuestAccounts.CreateAsync(L["Guest.DisplayName"]);
            await SignInGuestAsync(guest.LoginName);
        }
        catch (Exception exception) when (exception is FormatException or InvalidOperationException)
        {
            State.CompleteIdentityLoad(await UserRepository.GetAllAsync());
            FormError = L["Guest.Unavailable"];
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    /// <summary>ADR 0187 section 3: the lone guest account signs in without a password.</summary>
    private async Task ContinueAsGuestAsync()
    {
        FormError = null;
        IsSubmitting = true;
        try
        {
            if (await GuestAccounts.FindLoneGuestAsync() is not { } guest)
            {
                State.CompleteIdentityLoad(await UserRepository.GetAllAsync());
                FormError = L["Guest.Unavailable"];
                return;
            }

            await SignInGuestAsync(guest.LoginName);
        }
        catch (Exception exception) when (exception is FormatException or InvalidOperationException)
        {
            State.CompleteIdentityLoad(State.Users);
            FormError = L["Login.Rejected"];
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task SignInGuestAsync(LocalLoginName loginName)
    {
        State.BeginLoginProgress();
        StateHasChanged();
        await Task.Delay(50);
        AuthenticatedPrincipal principal = await SessionService.LoginAsync(loginName, password: null);
        await UseSessionLocaleAsync(principal);
        ClearPasswords();
        State.CompleteLogin();
    }

    private void OpenGuestAccountForm()
    {
        FormError = null;
        KeepGuestFiles = true;
        ShowGuestAccountForm = true;
    }

    private void CloseGuestAccountForm()
    {
        FormError = null;
        ClearPasswords();
        ShowGuestAccountForm = false;
    }

    /// <summary>
    /// ADR 0187 section 5: the guest asked from its session. The session is closed first (its apps
    /// stop as on a sign-out), then the sign-in screen opens on the "Create my account" form.
    /// </summary>
    private void OnCreateAccountRequested() => InvokeAsync(async () =>
    {
        if (State.View != EcosystemHostView.Desktop
            || SessionService.CurrentPrincipal is not { } principal
            || await GuestAccounts.FindGuestAsync() is not { } guest
            || guest.Id != principal.UserId)
        {
            return;
        }

        // As a sign-out from the session menu: the session's apps stop while the desktop can still
        // close their windows, then the session ends.
        await Services.GetRequiredService<HackerOs.Platform.Core.Lifecycle.AppLifecycleOrchestrator>()
            .StopSessionAppsAsync(principal.SessionId);
        await SessionService.LogoutAsync();
        State.BeginInitialization();
        StateHasChanged();
        await InitializeHostAsync();
        OpenGuestAccountForm();
        StateHasChanged();
    });

    /// <summary>
    /// ADR 0187 section 4: the guest becomes an administrator with a password, by migration (same
    /// account, home moved) or by replacement (new account, guest and its files deleted); the new
    /// account then signs in with that password.
    /// </summary>
    private async Task CreateMyAccountAsync()
    {
        FormError = null;
        if (SetupPassword.Length < 8 || !StringComparer.Ordinal.Equals(SetupPassword, SetupPasswordConfirmation))
        {
            FormError = L["Setup.PasswordRules"];
            return;
        }

        if (LocalAccountService.IsReserved(SetupLogin))
        {
            FormError = L["Setup.ReservedLogin", SetupLogin.Trim()];
            return;
        }

        IsSubmitting = true;
        try
        {
            HackerOs.AppSdk.Administration.HackNewUserAccount account = new(
                SetupLogin.Trim(), SetupDisplayName, AppAuthority.Administrator, SetupPassword);
            LocalUser created = KeepGuestFiles
                ? await GuestAccounts.MigrateAsync(account)
                : await GuestAccounts.ReplaceAsync(account);
            State.BeginLoginProgress();
            StateHasChanged();
            await Task.Delay(50);
            AuthenticatedPrincipal principal = await SessionService.LoginAsync(created.LoginName, SetupPassword);
            ShowGuestAccountForm = false;
            await UseSessionLocaleAsync(principal);
            ClearPasswords();
            State.CompleteLogin();
        }
        catch (Exception exception) when (exception is ArgumentException or FormatException or InvalidOperationException)
        {
            State.CompleteIdentityLoad(await UserRepository.GetAllAsync());
            SelectedLogin = State.Users.FirstOrDefault()?.LoginName.Value ?? string.Empty;
            ShowGuestAccountForm = State.LoneGuest is not null;
            FormError = exception.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task LoginAsync()
    {
        FormError = null;
        IsSubmitting = true;
        try
        {
            State.BeginLoginProgress();
            StateHasChanged();
            await Task.Delay(50);
            AuthenticatedPrincipal principal = await SessionService.LoginAsync(LocalLoginName.Parse(SelectedLogin), LoginPassword);
            await UseSessionLocaleAsync(principal);
            ClearPasswords();
            State.CompleteLogin();
        }
        catch (SessionLimitReachedException limit)
        {
            State.CompleteIdentityLoad(State.Users);
            FormError = L["Login.TooManySessions", limit.MaxOpenSessions];
        }
        catch (Exception exception) when (exception is FormatException or InvalidOperationException)
        {
            State.CompleteIdentityLoad(State.Users);
            FormError = L["Login.Rejected"];
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    /// <summary>
    /// ADR 0104: the desktop takes the language of the user's login environment (system locale,
    /// /etc/environment, ~/.config/locale.conf). An unreadable file never blocks the session: the
    /// language already shown is kept and the problem is logged by the provider.
    /// </summary>
    private async Task UseSessionLocaleAsync(AuthenticatedPrincipal principal)
    {
        try
        {
            await SessionLocale.UseSessionLocaleAsync(principal);
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or InvalidOperationException)
        {
            // Keep the sign-in screen's language.
        }
    }

    /// <summary>ADR 0168: the account chosen on the sign-in screen has at least one passkey.</summary>
    private bool SelectedUserHasPasskey =>
        State.Users.FirstOrDefault(user => user.LoginName.Value == SelectedLogin) is { Passkeys.Count: > 0 };

    /// <summary>
    /// ADR 0168 section 2: signs in with one of the account's passkeys. A cancelled or failed passkey
    /// leaves the password sign-in available.
    /// </summary>
    private async Task LoginWithPasskeyAsync()
    {
        FormError = null;
        IsSubmitting = true;
        try
        {
            PasskeyService passkeys = Services.GetRequiredService<PasskeyService>();
            if (SessionService is not LocalSessionService sessions)
            {
                FormError = L["Login.PasskeyUnsupported"];
                return;
            }

            // The browser's prompt shows first; the progress screen follows a verified passkey.
            LocalLoginName loginName = LocalLoginName.Parse(SelectedLogin);
            State.BeginLoginProgress();
            StateHasChanged();
            AuthenticatedPrincipal principal = await sessions.LoginWithPasskeyAsync(loginName, passkeys);
            await UseSessionLocaleAsync(principal);
            ClearPasswords();
            State.CompleteLogin();
        }
        catch (OperationCanceledException)
        {
            State.CompleteIdentityLoad(State.Users);
            FormError = L["Login.PasskeyCancelled"];
        }
        catch (NotSupportedException)
        {
            State.CompleteIdentityLoad(State.Users);
            FormError = L["Login.PasskeyUnsupported"];
        }
        catch (SessionLimitReachedException limit)
        {
            State.CompleteIdentityLoad(State.Users);
            FormError = L["Login.TooManySessions", limit.MaxOpenSessions];
        }
        catch (Exception exception) when (exception is FormatException or InvalidOperationException)
        {
            State.CompleteIdentityLoad(State.Users);
            FormError = L["Login.PasskeyRejected"];
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private void ClearPasswords()
    {
        SetupPassword = string.Empty;
        SetupPasswordConfirmation = string.Empty;
        LoginPassword = string.Empty;
    }

    /// <summary>
    /// After a sign-out the sign-in screen is loaded again. Returned as a task so the callback
    /// renders again once the users are loaded: a discarded task left the boot screen shown.
    /// </summary>
    private Task HandleLoggedOut()
    {
        if (HasBackgroundSessions)
        {
            // ADR 0201 section 5: other sessions still run; the sign-in screen offers them again.
            return ShowSwitchUserScreenAsync();
        }

        State.BeginInitialization();
        return InitializeHostAsync();
    }

    /// <summary>The session service, when it keeps several sessions open (ADR 0201).</summary>
    private IUserSwitchingService? Switching => SessionService as IUserSwitchingService;

    private bool HasBackgroundSessions => Switching?.BackgroundSessions.Count > 0;

    private bool HasOpenSession(LocalUser user) =>
        Switching?.OpenSessions.Any(open => open.UserId == user.Id) == true;

    /// <summary>The desktop is shown: a session is in the foreground on the desktop form factor.</summary>
    private bool ShowsDesktop =>
        State.View == EcosystemHostView.Desktop
        && PlatformPreference.Current.ActivePlatform != WellKnownAppPlatforms.Mobile;

    /// <summary>
    /// The desktop shell stays in the page when it is shown, and, hidden, while sessions wait in the
    /// background behind the sign-in screens (ADR 0201 section 3).
    /// </summary>
    private bool KeepsDesktopShell =>
        ShowsDesktop
        || (HasBackgroundSessions && State.View is EcosystemHostView.Initializing or EcosystemHostView.Login
            or EcosystemHostView.LoginProgress or EcosystemHostView.Desktop);

    /// <summary>
    /// ADR 0201 section 4: « Changer d'utilisateur » of the Start menu. The session moves to the
    /// background with its apps, without confirmation, and the sign-in screen opens.
    /// </summary>
    private async Task SwitchUserAsync()
    {
        if (Switching is not { } switching || State.View != EcosystemHostView.Desktop)
        {
            return;
        }

        try
        {
            await switching.SwitchAwayAsync();
        }
        catch (InvalidOperationException)
        {
            // The session ended under the menu: the sign-out path already runs.
            return;
        }

        await ShowSwitchUserScreenAsync();
    }

    /// <summary>
    /// Opens the sign-in screen while sessions run in the background: no boot again (their apps keep
    /// running), only the accounts and the system language (ADR 0104) are loaded.
    /// </summary>
    private async Task ShowSwitchUserScreenAsync()
    {
        FormError = null;
        ShowGuestAccountForm = false;
        ClearPasswords();
        State.BeginInitialization();
        StateHasChanged();
        try
        {
            await SessionLocale.UseSystemLocaleAsync();
            State.CompleteIdentityLoad(await UserRepository.GetAllAsync());
            // The first account without an open session is the likely next one.
            SelectedLogin = (State.Users.FirstOrDefault(user => !HasOpenSession(user)) ?? State.Users.FirstOrDefault())
                ?.LoginName.Value ?? string.Empty;
        }
        catch (Exception exception)
        {
            State.ShowRecovery(BrowserStorageRecoveryClassifier.Classify(
                exception, StorageRecoveryContext.Boot, Guid.NewGuid()));
        }
    }

    /// <summary>
    /// ADR 0195: « Redémarrer » of the Start menu. The session already ended like a sign-out; the
    /// boot screen shows while the caches empty, then the page reloads. If no power device could
    /// reload it, the sign-in screen opens as after a sign-out.
    /// </summary>
    private async Task HandleRestartAsync()
    {
        State.BeginInitialization();
        StateHasChanged();
        await BrowserHostRestart.RestartAsync(Services);
        await InitializeHostAsync();
    }
}
