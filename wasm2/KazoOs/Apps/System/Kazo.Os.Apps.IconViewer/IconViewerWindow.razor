@using Kazo.Os.App.Abstractions
@using Kazo.Os.AppSdk.Blazor
@using Kazo.Os.AppSdk.Icons
@using Kazo.Os.AppSdk.Globalization
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@inherits WindowAppBase
@implements IAsyncDisposable
@inject IIconCatalog Catalog
@inject IJSRuntime JS

<div class="iconviewer-container">
    <header class="iconviewer-header">
        <span class="iconviewer-title">@L["Header.Title"]</span>
        <input class="iconviewer-search"
               type="search"
               placeholder="@L["Search.Placeholder"]"
               value="@_query"
               @oninput="OnQueryChanged" />
        <span class="iconviewer-count">@Strings.Plural(L, "Count", _totalMatching)</span>
    </header>

    <nav class="iconviewer-libnav" role="tablist" aria-label="@L["Library.AriaLabel"]">
        <button type="button" role="tab" aria-selected="@(_activeLibrary is null ? "true" : "false")" class="@LibraryButtonClass(null)" @onclick="() => SetLibrary(null)">
            @L["Library.All", _countAll]
        </button>
        <button type="button" role="tab" aria-selected="@(_activeLibrary == IconLibrary.Bootstrap ? "true" : "false")" class="@LibraryButtonClass(IconLibrary.Bootstrap)" @onclick="() => SetLibrary(IconLibrary.Bootstrap)">
            Bootstrap (@_countBootstrap)
        </button>
        <button type="button" role="tab" aria-selected="@(_activeLibrary == IconLibrary.FontAwesome ? "true" : "false")" class="@LibraryButtonClass(IconLibrary.FontAwesome)" @onclick="() => SetLibrary(IconLibrary.FontAwesome)">
            Font Awesome (@_countFontAwesome)
        </button>
        <button type="button" role="tab" aria-selected="@(_activeLibrary == IconLibrary.Lucide ? "true" : "false")" class="@LibraryButtonClass(IconLibrary.Lucide)" @onclick="() => SetLibrary(IconLibrary.Lucide)">
            Lucide (@_countLucide)
        </button>
        <button type="button" role="tab" aria-selected="@(_activeLibrary == IconLibrary.SimpleIcons ? "true" : "false")" class="@LibraryButtonClass(IconLibrary.SimpleIcons)" @onclick="() => SetLibrary(IconLibrary.SimpleIcons)">
            Simple Icons (@_countSimpleIcons)
        </button>
    </nav>

    <div class="iconviewer-body">
        <div class="iconviewer-grid">
            @foreach (IconDescriptor icon in _visible)
            {
                <button type="button"
                        class="iconviewer-tile @(IsSelected(icon) ? "selected" : "")"
                        title="@icon.DisplayName"
                        @onclick="() => SelectIcon(icon)">
                    <HackerIcon Icon="icon" Size="28" />
                    <span class="iconviewer-tile-name">@icon.Name</span>
                </button>
            }
        </div>

        @if (_visible.Count == 0)
        {
            <p class="iconviewer-empty">@L["Empty", _query]</p>
        }
        @if (_visible.Count < _totalMatching)
        {
            <button type="button" class="iconviewer-loadmore" @onclick="ShowMore">
                @L["ShowMore", _totalMatching - _visible.Count]
            </button>
        }
    </div>

    @if (_selected is { } selected)
    {
        <aside class="iconviewer-detail" aria-label="@L["Detail.AriaLabel"]">
            <button type="button" class="iconviewer-detail-close" aria-label="@L["Detail.Close"]" @onclick="() => SelectIcon(null)">&times;</button>
            <HackerIcon Icon="selected" Size="56" />
            <h3>@selected.DisplayName</h3>
            <dl>
                <dt>@L["Detail.Library"]</dt>
                <dd>@selected.Library@(selected.Variant is null ? "" : $" ({selected.Variant})")</dd>
                <dt>@L["Detail.Name"]</dt>
                <dd>@selected.Name</dd>
            </dl>
            <label for="iconviewer-snippet">@L["Detail.Usage"]</label>
            <input id="iconviewer-snippet"
                   class="iconviewer-snippet"
                   readonly
                   value="@RazorSnippet(selected)"
                   @ref="_snippetInputRef"
                   @onclick="SelectSnippetText"
                   @onfocus="SelectSnippetText" />
            <p class="iconviewer-hint">@L["Detail.Hint"]</p>
        </aside>
    }
</div>

@code {
    private const int PageSize = 200;

    private string _query = string.Empty;
    private IconLibrary? _activeLibrary;
    private int _take = PageSize;
    private List<IconDescriptor> _visible = [];
    private int _totalMatching;
    private IconDescriptor? _selected;
    private IJSObjectReference? _module;
    private ElementReference _snippetInputRef;
    private IStringLocalizer<Strings>? _localizer;

    /// <summary>The Icon Viewer's texts in its own process's language (ADR 0104).</summary>
    private IStringLocalizer<Strings> L => _localizer ??= AppContext.GetLocalizer<Strings>();

    private int _countAll;
    private int _countBootstrap;
    private int _countFontAwesome;
    private int _countLucide;
    private int _countSimpleIcons;

    protected override void OnAppInitialized()
    {
        base.OnAppInitialized();
        _countAll = Catalog.Count();
        _countBootstrap = Catalog.Count(IconLibrary.Bootstrap);
        _countFontAwesome = Catalog.Count(IconLibrary.FontAwesome);
        _countLucide = Catalog.Count(IconLibrary.Lucide);
        _countSimpleIcons = Catalog.Count(IconLibrary.SimpleIcons);
        Recompute();
    }

    protected override async Task OnAppAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Kazo.Os.Apps.IconViewer/select-text.js");
        }
    }

    private void OnQueryChanged(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? string.Empty;
        _take = PageSize;
        Recompute();
    }

    private void SetLibrary(IconLibrary? library)
    {
        _activeLibrary = library;
        _take = PageSize;
        Recompute();
    }

    private void ShowMore()
    {
        _take += PageSize;
        Recompute();
    }

    private void SelectIcon(IconDescriptor? icon)
    {
        _selected = icon;
    }

    private bool IsSelected(IconDescriptor icon) =>
        _selected is { } selected && selected.Library == icon.Library && selected.Name == icon.Name;

    private void Recompute()
    {
        IReadOnlyList<IconDescriptor> matches = Catalog.Search(_query, _activeLibrary, maxResults: 20_000);
        _totalMatching = matches.Count;
        _visible = [.. matches.Take(_take)];
    }

    private string LibraryButtonClass(IconLibrary? library) =>
        _activeLibrary == library ? "active" : string.Empty;

    private static string RazorSnippet(IconDescriptor icon) =>
        $"<HackerIcon Library=\"IconLibrary.{icon.Library}\" Name=\"{icon.Name}\" />";

    private async Task SelectSnippetText()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("selectText", _snippetInputRef);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.DisposeAsync();
        }
    }
}
