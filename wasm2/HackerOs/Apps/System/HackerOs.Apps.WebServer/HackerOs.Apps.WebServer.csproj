<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="../../../Platform/Packaging.props" />

  <PropertyGroup>
    <PackageId>HackerOs.Apps.WebServer</PackageId>
    <Description>The base Kazo OS hackwebd web server and Web Server Manager app, to include in an OS host (ProjectReference or PackageReference, optionally IsSystemApp).</Description>
    <PackageTags>hackeros;app</PackageTags>
  </PropertyGroup>

  <!--
    ADR 0077 / ADR 0080: the hosted static sites. Two apps in one assembly, like nginx and its
    control tools in one package: the hackwebd service (HackWebdApp) and the Web Server Manager window
    (WebServerManagerApp). Being in the same assembly makes hackwebd a companion service of the
    Manager, which may start and stop it without services.manage (IAppServiceControlGateway rule).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\HackerOs.App.Abstractions\HackerOs.App.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\Shared\HackerOs.AppSdk\HackerOs.AppSdk.csproj" />
    <ProjectReference Include="..\..\..\Shared\HackerOs.AppSdk.Blazor\HackerOs.AppSdk.Blazor.csproj" />
    <ProjectReference Include="..\..\..\Shared\HackerOs.Simulation.Abstractions\HackerOs.Simulation.Abstractions.csproj" />
  </ItemGroup>

</Project>
