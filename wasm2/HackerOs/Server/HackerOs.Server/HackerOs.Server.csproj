<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Optional ASP.NET Core server. Clients continue to work when this process is absent. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
    <RootNamespace>HackerOs.Server</RootNamespace>
    <AssemblyName>HackerOs.Server</AssemblyName>
    <Description>Optional ASP.NET Core server providing sync, identity, and network proxy services for HackerOs. The browser PWA operates fully offline when this server is absent.</Description>
    <!-- Publish as a self-contained single-file for easy operator deployment. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <!--
      The optional ASP.NET Core/EF Core server is intentionally not trimmed.
      EF Core explicitly requires unreferenced code, while the WASM client and
      shared contracts continue to use the repository-wide trim analyzer.
    -->
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Inline the server ADR decision: D-017, D-018 implemented here. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Server\HackerOs.Server.Contracts\HackerOs.Server.Contracts.csproj" />
    <!--
      ADR 0130: the browser receives the OS in WebAssembly. Referencing the standalone Ecosystem PWA
      makes its published files (index.html, _framework/, service worker, every app) static web
      assets of this server, served as they are by MapStaticAssets. Nothing of the OS runs here.
    -->
    <ProjectReference Include="..\..\OS\HackerOs.Ecosystem\HackerOs.Ecosystem.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQLite for portable single-file server deployment; can be swapped for PostgreSQL. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Pin a patched native SQLite build instead of the vulnerable transitive floor. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- Scalar for OpenAPI documentation UI. -->
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.2" />
    <!-- OpenAPI document generation (required for AddOpenApi/MapOpenApi). -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.13.0" />
    <!-- Hosts the Blazor WebAssembly client (ADR 0130): MIME types and debugging proxy of _framework/. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.13" />
    <!-- ADR 0191 §4: the installable server runs as a Windows service or a systemd unit. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.13" />
  </ItemGroup>

</Project>
