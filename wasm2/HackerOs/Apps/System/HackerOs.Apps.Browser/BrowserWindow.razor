@using HackerOs.App.Abstractions
@using HackerOs.AppSdk.Blazor
@using HackerOs.AppSdk.Blazor.Display
@using HackerOs.AppSdk.Web.Blazor.Sites
@using HackerOs.Apps.Browser.DevTools
@using HackerOs.Simulation.Abstractions.Network
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@inherits WindowAppBase
<div class="browser-root">
    <!-- Address / Navigation Toolbar -->
    <div class="browser-toolbar">
        <div class="nav-buttons">
            <button id="browser-btn-back"    class="nav-btn" disabled="@(!CanGoBack)"    @onclick="GoBack"    title="@L["Toolbar.Back"]">&#8592;</button>
            <button id="browser-btn-forward" class="nav-btn" disabled="@(!CanGoForward)" @onclick="GoForward" title="@L["Toolbar.Forward"]">&#8594;</button>
            <button id="browser-btn-refresh" class="nav-btn" @onclick="RefreshAsync"     title="@L["Toolbar.Refresh"]">&#8635;</button>
            <button id="browser-btn-home"    class="nav-btn" @onclick="NavigateHomeAsync" title="@L["Toolbar.Home"]">&#8962;</button>
        </div>

        <div class="address-bar">
            @if (Indicator.SourceIcon.Length > 0)
            {
                <span id="browser-source" class="address-source @Indicator.SourceClass" title="@Indicator.SourceTitle"
                      role="img" aria-label="@Indicator.SourceTitle">@Indicator.SourceIcon</span>
            }
            <span class="address-scheme @SchemeClass" title="@SchemeTitle">@SchemeIcon</span>
            @if (Indicator.NotSecureLabel is { Length: > 0 })
            {
                <span id="browser-not-secure" class="address-not-secure">@Indicator.NotSecureLabel</span>
            }
            <input id="browser-address-input"
                   type="text"
                   class="address-input"
                   value="@_urlInputValue"
                   @oninput="OnUrlInputChanged"
                   @onkeydown="HandleAddressKeyDownAsync"
                   aria-label="@L["Toolbar.AddressBar"]"
                   spellcheck="false" />
        </div>

        <button id="browser-btn-navigate" class="go-btn" @onclick="NavigateToCurrentInputAsync" title="@L["Toolbar.Navigate"]">@L["Toolbar.Go"]</button>

        <button id="browser-btn-source" class="nav-btn @(_viewSource ? "toggled" : null)" @onclick="ToggleViewSourceAsync"
                title="@L["Toolbar.ViewSource"]" aria-pressed="@(_viewSource ? "true" : "false")" disabled="@(!CanViewSource)">&lt;/&gt;</button>
        <button id="browser-btn-devtools" class="nav-btn devtools-toggle @(_devToolsOpen ? "toggled" : null)" @onclick="ToggleDevTools"
                title="@L["Toolbar.DevTools"]" aria-pressed="@(_devToolsOpen ? "true" : "false")">
            &#128295;
            @if (_devTools.ErrorCount > 0)
            {
                <span class="devtools-badge">@_devTools.ErrorCount</span>
            }
        </button>
        <button id="browser-btn-bookmarks" class="nav-btn" @onclick="ToggleBookmarksAsync" title="@L["Toolbar.Bookmarks"]">&#9733;</button>
        <button id="browser-btn-detach" class="nav-btn @(_surface is not null ? "toggled" : null)" @onclick="ToggleDetachedAsync"
                title="@(_surface is null ? L["Toolbar.Detach"] : L["Toolbar.Reattach"])"
                aria-pressed="@(_surface is not null ? "true" : "false")" disabled="@(!CanDetach)">&#10697;</button>
    </div>

    <!-- Main Content Area -->
    <div class="browser-content">
        @if (_detachMessage is not null)
        {
            <div class="page-alert detach-alert" role="alert">
                <span class="page-alert-message">@_detachMessage</span>
                <button class="action-btn" @onclick="DismissDetachMessage">@L["Common.Ok"]</button>
            </div>
        }

        @if (_notice is not null)
        {
            <div class="page-alert" role="status">
                <span class="page-alert-message">@_notice</span>
                <button class="action-btn" @onclick="DismissNotice">@L["Common.Ok"]</button>
            </div>
        }

        @if (_alertMessage is not null)
        {
            <div class="page-alert" role="alert">
                <span class="page-alert-origin">@L["Alert.Says", _alertOrigin]</span>
                <span class="page-alert-message">@_alertMessage</span>
                <button class="action-btn" @onclick="DismissAlert">@L["Common.Ok"]</button>
            </div>
        }

        @if (_surface is not null)
        {
            <div class="browser-view">
                <div class="browser-detached" role="status">
                    <div class="detached-icon">&#10697;</div>
                    <h1 class="detached-title">@L["Detached.Title"]</h1>
                    <p class="detached-url">@_finalUrl</p>
                    <div class="detached-actions">
                        <button id="browser-btn-show-detached" class="action-btn" @onclick="ShowDetachedAsync">@L["Detached.Show"]</button>
                        <button id="browser-btn-reattach" class="action-btn" @onclick="ReattachAsync">@L["Detached.BringBack"]</button>
                    </div>
                </div>
            </div>
        }

        @*
            The page area, always rendered at this one place of the tree (ADR 0084 §7): the portal
            moves its element into the detached window (ADR 0078 §3) and back, so a Blazor site
            keeps its components and their state across a detach.
        *@
        <DisplaySurfaceContent Surface="_surface">
            <div class="page-host @(_surface is null ? null : "browser-root surface-page")">
                @if (_surface is not null)
                {
                    <div class="surface-toolbar">
                        <span class="address-scheme @SchemeClass" title="@SchemeTitle">@SchemeIcon</span>
                        <span id="surface-address" class="surface-address" title="@_finalUrl">
                            @if (!string.IsNullOrWhiteSpace(_pageTitle))
                            {
                                <span class="surface-title">@_pageTitle</span>
                            }
                            <span class="surface-url">@_finalUrl</span>
                        </span>
                        <button id="surface-btn-refresh" class="nav-btn" @onclick="RefreshAsync" title="@L["Toolbar.Refresh"]">&#8635;</button>
                        <button id="surface-btn-reattach" class="nav-btn" @onclick="ReattachAsync" title="@L["Surface.ReattachTitle"]">&#8690; @L["Surface.Reattach"]</button>
                    </div>
                }
                @PageContent
            </div>
        </DisplaySurfaceContent>

        @if (_devToolsOpen)
        {
            <DevToolsPanel Log="_devTools" OnClose="ToggleDevTools" />
        }
    </div>

    <!-- Status Bar -->
    <div class="browser-statusbar" aria-live="polite">
        @if (_isLoading)
        {
            <span>@L["Status.Connecting", _currentUrl]</span>
        }
        else if (_error is not null)
        {
            <span class="status-error">@_error.Code</span>
        }
        else if (_currentPage is not null || _currentBody is not null || _frameDocument is not null)
        {
            <span>&#10003; @(string.IsNullOrWhiteSpace(_pageTitle) ? _finalUrl : $"{_pageTitle} — {_finalUrl}")</span>
        }
    </div>
</div>

@code {
    // The page area, drawn either in the window or in the detached surface (ADR 0078 §3).
    private RenderFragment PageContent => @<text>
        <div class="browser-view @(ShowsFrame || ShowsSite ? "frame-view" : null)">
        @if (_isLoading)
        {
            <div class="browser-loading" role="status" aria-live="polite">
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                <span class="loading-label">@L["Loading.Label", _currentUrl]</span>
            </div>
        }
        else if (_error is not null)
        {
            <div class="browser-error-page" role="alert" data-error-code="@_error.Code">
                <div class="error-icon">&#9888;</div>
                <h1 class="error-title">@_error.Title</h1>
                <p class="error-url">@_error.Message</p>
                @if (_error.Hints.Count > 0)
                {
                    <ul class="error-hints">
                        @foreach (string hint in _error.Hints)
                        {
                            <li>@hint</li>
                        }
                    </ul>
                }
                <p class="error-code">@_error.Code</p>
                <button class="action-btn" @onclick="RefreshAsync">@L["Error.TryAgain"]</button>
            </div>
        }
        else if (_currentPage is not null)
        {
            <SimulatedPageRenderer Page="_currentPage" OnNavigate="HandleInPageNavigationAsync" OnSubmit="HandleFormSubmitAsync" />
        }
        else if (ShowsSite)
        {
            @* A Blazor site (ADR 0084 §4): its root component, drawn here as the site's renderer process. *@
            <HackWebSiteView @ref="_siteView" Process="_site!" Url="_siteUrl!" Cookies="_cookies"
                             OnLocationChanged="HandleSiteLocationChangedAsync" OnNavigate="HandleSiteNavigateAsync"
                             OnTitleChanged="HandleSiteTitleChangedAsync" OnFaulted="HandleSiteFaultedAsync" />
        }
        else if (ShowsFrame)
        {
            <BrowserPageView @ref="_pageView" Document="_frameDocument" OnRequest="HandleBridgeRequestAsync" OnEvent="HandleBridgeEventAsync" OnEscaped="HandleFrameEscapedAsync" />
        }
        else if (_currentBody is not null)
        {
            <ResponseBodyViewer View="_currentBody" StatusCode="_currentStatus" Url="@_finalUrl" DownloadedTo="@_downloadedTo" />
        }
        else
        {
            <!-- New-tab placeholder -->
            <div class="browser-new-tab">
                <h1 class="new-tab-title">@L["NewTab.Title"]</h1>
                <p class="new-tab-subtitle">@L["NewTab.Subtitle"]</p>
                <div class="new-tab-bookmarks">
                    @foreach (var (label, url) in DefaultBookmarks)
                    {
                        <button class="bookmark-chip" id="browser-bookmark-@label.Replace(" ", "-").ToLowerInvariant()"
                                @onclick="() => NavigateToAsync(url)">
                            @label
                        </button>
                    }
                </div>
            </div>
        }

        </div>
    </text>;
}
