@using HackerOs.AppSdk.Blazor
@inherits WindowAppBase

<div class="platform-demo-container">
    <header class="platform-demo-header">
        <span class="platform-demo-title">Platform Demo (MOB-014)</span>
    </header>
    <div class="platform-demo-body">
        <p>
            This sample demonstrates one shared entry point declared for both the
            <code>desktop</code> and <code>mobile</code> platforms: its <code>[AppManifest]</code> class sets
            <code>MobileEntryPoint</code> to the same component, which the generated
            <code>manifest.json</code> turns into one <code>platform.entryPoints</code> entry, per
            doc/en/wasm/dev/old/mobile-interface-platform-plan.md §4.1.
        </p>
    </div>
</div>
