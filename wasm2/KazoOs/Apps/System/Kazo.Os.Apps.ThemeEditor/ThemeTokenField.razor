@inherits HackComponentBase
@* One editable theme token (ADR 0103 §2.1): a typed input, its validation message and its help. *@
<div class="token-field @(Error is null ? "" : "has-error") @(Value is null ? "is-inherited" : "is-set")">
    <div class="token-head">
        <label class="token-label" for="@InputId">@Token.GetLabel(Strings.CultureOf(L))</label>
        <code class="token-name">@Token.Name</code>
        <span class="token-type">@Strings.TypeLabel(L, Token.Type)</span>
    </div>
    <div class="token-inputs">
        @if (Token.Type == ThemeTokenType.Color)
        {
            <input type="color"
                   class="token-swatch"
                   aria-label="@L["Field.Pick", Token.GetLabel(Strings.CultureOf(L))]"
                   value="@(ThemeTokenValidator.ToHexColor(Value ?? Token.Example) ?? "#000000")"
                   @onchange="OnPickedAsync" />
        }
        <input id="@InputId"
               class="token-input"
               type="text"
               spellcheck="false"
               placeholder="@L["Field.Placeholder", Token.Example]"
               value="@Value"
               aria-invalid="@(Error is null ? "false" : "true")"
               aria-describedby="@($"{InputId}-help")"
               @onchange="OnTypedAsync" />
        <button type="button" class="token-reset" title="@L["Field.ResetTooltip"]" disabled="@(Value is null)" @onclick="ResetAsync">@L["Field.Reset"]</button>
    </div>
    <p id="@($"{InputId}-help")" class="token-help">
        @if (Error is not null)
        {
            <span class="token-error" role="alert">@Error</span>
        }
        else
        {
            <span>@Token.GetDescription(Strings.CultureOf(L))</span>
        }
    </p>
</div>

@code {
    /// <summary>Gets or sets the token edited by this field.</summary>
    [Parameter, EditorRequired]
    public ThemeTokenDefinition Token { get; set; } = default!;

    /// <summary>Gets or sets the value typed for the token, or <see langword="null"/> when the base value applies.</summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>Gets or sets the validation error of the value, if any.</summary>
    [Parameter]
    public string? Error { get; set; }

    /// <summary>Gets or sets the callback receiving a new value (<see langword="null"/> to reset).</summary>
    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>The Theme Editor's texts in the language of its process (ADR 0104).</summary>
    private IStringLocalizer<Strings> L => AppContext.GetLocalizer<Strings>();

    private string InputId => $"token{Token.Name}";

    private Task OnTypedAsync(ChangeEventArgs args) => ValueChanged.InvokeAsync(args.Value as string);

    private Task OnPickedAsync(ChangeEventArgs args) => ValueChanged.InvokeAsync(args.Value as string);

    private Task ResetAsync() => ValueChanged.InvokeAsync(null);
}
