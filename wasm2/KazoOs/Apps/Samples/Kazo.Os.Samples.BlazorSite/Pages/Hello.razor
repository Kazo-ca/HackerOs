@namespace Kazo.Os.Samples.BlazorSite.Pages
@page "/hello/{Name}"
@inherits HackComponentBase
@*
    A page with a route parameter that calls the site's own API through Site.Http: the request goes
    through the simulated network to the same site, as the renderer process.
*@
<HackPageTitle Title="@($"Hello {Name} - Blazor Sample Site")" />
<h1>Hello, @Name</h1>
@if (_greeting is null)
{
    <p id="greeting" class="pending">Asking the server…</p>
}
else
{
    <p id="greeting">@_greeting.Message <small>(server time @_greeting.At.ToString("HH:mm:ss"))</small></p>
}
@if (_error is not null)
{
    <p id="greeting-error" role="alert">@_error</p>
}
<p><a href="/">Home</a></p>
