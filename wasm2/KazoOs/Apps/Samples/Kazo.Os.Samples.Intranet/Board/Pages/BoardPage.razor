@namespace Kazo.Os.Samples.Intranet.Board.Pages
@page "/board"
@inherits KazoComponentBase
@*
    The task board: three columns of cards loaded from GET /api/tasks. Adding, moving and deleting
    a card call POST, PUT and DELETE through Site.Http (the renderer process, with the tab's cookies)
    and redraw without any page load.
*@
<KazoPageTitle Title="Board - Intranet" />
<div class="board-toolbar">
    <h1>Task board</h1>
    <form class="board-add" @onsubmit="AddAsync" @onsubmit:preventDefault>
        <input id="board-new-title" placeholder="New card…" @bind="_newTitle" @bind:event="oninput" maxlength="80" aria-label="Title of the new card" />
        <button id="board-add" class="board-button" type="submit" disabled="@(_busy || string.IsNullOrWhiteSpace(_newTitle))">Add</button>
    </form>
</div>
@if (_error is not null)
{
    <p class="board-error" id="board-error" role="alert">@_error</p>
}
@if (_tasks is null)
{
    <p class="board-muted" id="board-loading">Loading the board…</p>
}
else
{
    <div class="board-columns">
        @foreach (string column in BoardColumns.All)
        {
            <section class="board-column" id="column-@column" aria-label="@BoardColumns.Title(column)">
                <h2>@BoardColumns.Title(column) <span class="board-count">@_tasks.Count(task => task.Column == column)</span></h2>
                @foreach (BoardTask task in _tasks.Where(task => task.Column == column))
                {
                    <article class="board-card" id="task-@task.Id">
                        <a class="board-card-title" href="@($"/board/tasks/{task.Id}")">@task.Title</a>
                        <p class="board-muted">@(string.IsNullOrEmpty(task.Assignee) ? "unassigned" : "@" + task.Assignee)</p>
                        <div class="board-card-actions">
                            <button class="board-icon" title="Move left" disabled="@(_busy || column == BoardColumns.Todo)" @onclick="() => MoveAsync(task, -1)">◀</button>
                            <button class="board-icon" title="Move right" disabled="@(_busy || column == BoardColumns.Done)" @onclick="() => MoveAsync(task, 1)">▶</button>
                            <button class="board-icon danger" title="Delete" disabled="@_busy" @onclick="() => DeleteAsync(task)">✕</button>
                        </div>
                    </article>
                }
            </section>
        }
    </div>
}
