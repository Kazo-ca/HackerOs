@inherits Kazo.Os.AppSdk.Blazor.HackComponentBase

@*
    Settings > Language (ADR 0104): the language of this session as the process sees it, the user's
    choice (~/.config/locale.conf, or "follow the system language") and the system locale
    (/etc/locale.conf, read-only here). A change is written now and applies at the next sign-in.
*@
<div class="setting-group language-panel language-session">
    <h4>@L["Language.Session.Title"]</h4>
    <p class="setting-desc">
        @LocalizedMarkup.Format(L["Language.Session.Description"], LocalizedMarkup.Code("LANG"), LocalizedMarkup.Code("~/" + UserLocaleFileRelativePath))
    </p>
    <dl class="language-readout" aria-label="@L["Language.Session.Title"]">
        <dt>@L["Language.Session.Language"]</dt>
        <dd>@LanguageName(Context.Culture)</dd>
        <dt>LANG</dt>
        <dd><code>@(SessionLang ?? L["Language.Unset"].Value)</code></dd>
        @foreach ((string name, string value) in SessionOverrides)
        {
            <dt>@name</dt>
            <dd><code>@value</code></dd>
        }
        <dt>@L["Language.Session.Formats"]</dt>
        <dd>@FormatSample</dd>
    </dl>
</div>

<div class="setting-group language-panel">
    <h4>@L["Language.Choice.Title"]</h4>
    <p class="setting-desc">@L["Language.Choice.Description"]</p>

    @if (!_loaded)
    {
        <p class="setting-desc">@L["Common.Loading"]</p>
    }
    else
    {
        <div class="locale-options" role="radiogroup" aria-label="@L["Language.Choice.AriaLabel"]">
            <button type="button" role="radio" class="@OptionClass(null)"
                    aria-checked="@(ChosenLocale is null ? "true" : "false")"
                    disabled="@_isBusy"
                    @onclick="() => ChooseAsync(null)">
                <span class="locale-tag" aria-hidden="true">SYS</span>
                <span class="locale-text">
                    <span class="locale-name">@L["Language.FollowSystem"]</span>
                    <span class="locale-code">@L["Language.FollowSystem.Detail", Describe(SystemLocaleOrDefault)]</span>
                </span>
            </button>
            @foreach (string locale in HackLocale.AvailableLocales)
            {
                <button type="button" role="radio" class="@OptionClass(locale)"
                        aria-checked="@(IsChosen(locale) ? "true" : "false")"
                        disabled="@_isBusy"
                        @onclick="() => ChooseAsync(locale)">
                    <span class="locale-tag" aria-hidden="true">@LocaleTag(locale)</span>
                    <span class="locale-text">
                        <span class="locale-name">@LocaleName(locale)</span>
                        <span class="locale-code">@locale</span>
                    </span>
                </button>
            }
        </div>

        @if (NextSignInLocale is { } next && !SameLocale(next, SessionLang))
        {
            <p class="language-pending">
                <span class="language-prompt" aria-hidden="true">&gt;</span>
                @L["Language.Pending", Describe(next)]
            </p>
        }
    }

    @if (_message is not null)
    {
        <div class="@(_messageIsError ? "language-message is-error" : "language-message")" role="@(_messageIsError ? "alert" : "status")">
            <span>@_message</span>
            @if (!_messageIsError)
            {
                <span class="language-next-sign-in">@L["Language.NextSignIn"]</span>
            }
        </div>
    }
</div>

<div class="setting-group language-panel">
    <h4>@L["Language.System.Title"]</h4>
    <dl class="language-readout">
        <dt>LANG</dt>
        <dd><code>@(_systemLocale ?? L["Language.System.Unset", HackLocale.DefaultLocale].Value)</code></dd>
        <dt>@L["Language.Session.Language"]</dt>
        <dd>@LanguageName(HackLocale.ToLanguage(SystemLocaleOrDefault))</dd>
    </dl>
    <p class="setting-desc">
        @LocalizedMarkup.Format(L["Language.System.Description"], LocalizedMarkup.Code(SystemLocaleFilePath), LocalizedMarkup.Code("sudo localectl set-locale LANG=fr_CA.UTF-8"))
    </p>
    @if (_systemError is not null)
    {
        <p class="dialog-error" role="alert">@_systemError</p>
    }
</div>
