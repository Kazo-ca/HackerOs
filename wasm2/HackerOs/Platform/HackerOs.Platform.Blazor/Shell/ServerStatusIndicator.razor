@using HackerOs.AppSdk.Icons
@using HackerOs.Platform.Core.ServerConnection
@implements IAsyncDisposable

@*
    ADR 0134 §2: the optional server's state in the taskbar's notification area. Hidden while no
    server is configured; a click opens a small panel with the state, the address, the account and
    the "Identify", "Reconnect" and "Server settings" actions.
*@
@if (_presence.Status != ServerPresenceStatus.NotConfigured)
{
    <div class="server-status" @onkeydown="HandleKeyDown">
        <button type="button"
                class="server-status-trigger @StatusClass @(_isOpen ? "is-active" : "")"
                title="@Tooltip"
                aria-label="@Tooltip"
                aria-haspopup="dialog"
                aria-expanded="@_isOpen.ToString().ToLowerInvariant()"
                @onclick="TogglePanel">
            <HackerIcon Library="IconLibrary.Lucide" Name="@IconName" Size="17" Title="" class="server-status-icon" />
        </button>
        <span class="server-status-live" aria-live="polite" role="status">@StatusText</span>

        @if (_isOpen)
        {
            <div class="server-status-panel" role="dialog" aria-label="@L["Server.Panel"]">
                <h3 class="server-status-heading">@L["Server.Panel"]</h3>
                <dl class="server-status-facts">
                    <dt>@L["Server.State"]</dt>
                    <dd class="@StatusClass">@StatusText</dd>
                    <dt>@L["Server.Address"]</dt>
                    <dd>@_presence.ServerUrl</dd>
                    <dt>@L["Server.Account"]</dt>
                    <dd>@(_presence.AccountId is { } account ? account.ToString() : L["Server.NoAccount"])</dd>
                    @if (_lastSync is { } lastSync)
                    {
                        <dt>@L["Server.LastSync"]</dt>
                        <dd>@LocalTime(lastSync).ToString("g", System.Globalization.CultureInfo.CurrentCulture)</dd>
                    }
                    @if (!string.IsNullOrEmpty(_presence.Detail))
                    {
                        <dt>@L["Server.Detail"]</dt>
                        <dd class="server-status-detail">@_presence.Detail</dd>
                    }
                </dl>

                @if (_isIdentifying)
                {
                    <form class="server-status-form" @onsubmit="() => IdentifyAsync(createAccount: false)" @onsubmit:preventDefault>
                        <label for="server-status-login">@L["Server.AccountName"]</label>
                        <input id="server-status-login" type="text" autocomplete="username" maxlength="128"
                               disabled="@_isBusy" @bind="_login" @bind:event="oninput" />
                        <label for="server-status-password">@L["Server.Password"]</label>
                        <input id="server-status-password" type="password" autocomplete="current-password"
                               disabled="@_isBusy" @bind="_password" @bind:event="oninput" />
                        @if (!string.IsNullOrEmpty(_error))
                        {
                            <p class="server-status-error" role="alert">@_error</p>
                        }
                        <div class="server-status-actions">
                            <button type="submit" class="server-status-button is-primary" disabled="@(!CanIdentify)">@L["Server.LogIn"]</button>
                            <button type="button" class="server-status-button" disabled="@(!CanIdentify)"
                                    @onclick="() => IdentifyAsync(createAccount: true)">@L["Server.CreateAccount"]</button>
                            <button type="button" class="server-status-button" disabled="@_isBusy"
                                    @onclick="() => _isIdentifying = false">@L["Server.Cancel"]</button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="server-status-actions">
                        @if (_presence.Status == ServerPresenceStatus.ConnectedAnonymous)
                        {
                            <button type="button" class="server-status-button is-primary" @onclick="StartIdentify">
                                <HackerIcon Library="IconLibrary.Lucide" Name="log-in" Size="15" Title="" />
                                @L["Server.Identify"]
                            </button>
                        }
                        <button type="button" class="server-status-button" disabled="@_isBusy" @onclick="ReconnectAsync">
                            <HackerIcon Library="IconLibrary.Lucide" Name="refresh-cw" Size="15" Title="" />
                            @L["Server.Reconnect"]
                        </button>
                        @if (OnOpenSettings.HasDelegate)
                        {
                            <button type="button" class="server-status-button" @onclick="OpenSettingsAsync">
                                <HackerIcon Library="IconLibrary.Lucide" Name="settings" Size="15" Title="" />
                                @L["Server.Settings"]
                            </button>
                        }
                    </div>
                }
            </div>
        }
    </div>
}
