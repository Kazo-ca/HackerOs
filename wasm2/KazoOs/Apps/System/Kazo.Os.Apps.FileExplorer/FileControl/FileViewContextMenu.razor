@namespace Kazo.Os.Apps.FileExplorer.FileControl
@using MudBlazor
@using Microsoft.AspNetCore.Components.Web
@inherits Kazo.Os.AppSdk.Blazor.KazoComponentBase

@*
    Reusable context menu: default well-known items (open/rename/delete/new-folder/refresh) plus
    IFileViewContextMenuProvider customization, per FileViewControl.md#context-menu-customization (FV-008).
*@
<MudMenu @ref="_menu" PositionAtCursor="true">
    <ActivatorContent>
        @* MudMenu's UserAttributes splat lands on the outer .mud-menu wrapper (a role-less div,
           where aria-label would trip aria-prohibited-attr), not on the inner activator div
           that actually carries role="button" — so the accessible name has to come from text
           content inside ActivatorContent instead. This activator is a positioning anchor only
           (PositionAtCursor, opened programmatically via OpenAsync from right-click handlers
           elsewhere in FileView), never meant to be seen, hence the visually-hidden clip. *@
        <span class="visually-hidden">@Owner.L["Menu.Label"]</span>
    </ActivatorContent>
    <ChildContent>
        @if (_currentItems is not null)
        {
            @foreach (FileViewMenuItem menuItem in _currentItems.Items)
            {
                @if (menuItem.IsSeparatorBefore)
                {
                    <MudDivider />
                }
                <MudMenuItem OnClick="menuItem.OnActivate" Disabled="menuItem.IsDisabled">
                    <span class="file-view-context-menu-item">
                        @if (menuItem.Icon is not null)
                        {
                            <ShellIcon Icon="menuItem.Icon" Size="16" />
                        }
                        @menuItem.Label
                    </span>
                </MudMenuItem>
            }
        }
    </ChildContent>
</MudMenu>
