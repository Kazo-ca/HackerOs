@namespace HackerOs.Ecosystem
@using HackerOs.Simulation.Abstractions.Sessions
@implements IDisposable
@inject ILoginProgressTracker ProgressTracker
@inject IStringLocalizer<Strings> L

<section class="login-progress-surface" aria-busy="true" aria-label="@L["Progress.Label"]">
    <div class="progress-card">
        <div class="boot-logo" aria-hidden="true">
            <span class="logo-mark">H_</span>
        </div>

        <h1 class="system-title">KazoOS</h1>
        <p class="status-subtitle">@L["Progress.Subtitle"]</p>

        <div class="progress-bar-container" role="progressbar" aria-valuenow="@Snapshot.Percentage" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar-track">
                <div class="progress-bar-fill @GetProgressClass(Snapshot.Percentage)"></div>
            </div>
            <div class="progress-meta">
                <span class="step-label">@StepName(Snapshot.CurrentStepName)...</span>
                <span class="step-percentage">@Snapshot.Percentage%</span>
            </div>
        </div>

        @if (Snapshot.StepHistory.Count > 0)
        {
            <ul class="step-history-log" aria-label="@L["Progress.Completed"]">
                @foreach (string step in Snapshot.StepHistory)
                {
                    <li class="history-item">
                        <span class="check-mark" aria-hidden="true">✓</span>
                        <span class="history-text">@StepName(step)</span>
                    </li>
                }
            </ul>
        }
    </div>
</section>

@code {
    private LoginProgressSnapshot Snapshot => ProgressTracker.CurrentSnapshot;

    protected override void OnInitialized()
    {
        ProgressTracker.ProgressChanged += OnProgressChanged;
    }

    private void OnProgressChanged(LoginProgressSnapshot snapshot)
    {
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// A login step in the sign-in screen's language: the session service names its steps in
    /// English ("Loading Profile"); a known step has a <c>Progress.Step.*</c> text, any other is shown as is.
    /// </summary>
    private string StepName(string step)
    {
        if (string.IsNullOrWhiteSpace(step))
        {
            return step;
        }

        string key = "Progress.Step." + string.Concat(step.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(static word => char.ToUpperInvariant(word[0]) + word[1..]));
        LocalizedString text = L[key];
        return text.ResourceNotFound ? step : text.Value;
    }

    private static string GetProgressClass(int percentage) => percentage switch
    {
        <= 33 => "progress-33",
        <= 66 => "progress-66",
        <= 99 => "progress-99",
        _ => "progress-100"
    };

    public void Dispose()
    {
        ProgressTracker.ProgressChanged -= OnProgressChanged;
    }
}
