@using Kazo.Os.AppSdk.Blazor
@using Microsoft.AspNetCore.Components.Web
@using Kazo.Os.AppSdk.Globalization
@inherits WindowAppBase
@implements IAsyncDisposable
@implements IWindowCloseGuard

<div class="@RootClass" @ref="_root" tabindex="-1" @onkeydown="HandleKeyDownAsync">
    <div class="paint-toolbar" role="toolbar" aria-label="@L["Toolbar.AriaLabel"]">
        <div class="tool-group" aria-label="@L["Group.File"]">
            <button id="paint-btn-new" class="paint-btn" title="@L["Button.New.Tooltip"]" disabled="@IsBusy" @onclick="NewDocumentAsync">@L["Button.New"]</button>
            <button id="paint-btn-open" class="paint-btn" title="@L["Button.Open.Tooltip"]" disabled="@IsBusy" @onclick="OpenAsync">@L["Button.Open"]</button>
            <button id="paint-btn-save" class="paint-btn" title="@L["Button.Save.Tooltip"]" disabled="@IsBusy" @onclick="SaveAsync">@L["Button.Save"]</button>
            <button id="paint-btn-save-as" class="paint-btn" title="@L["Button.SaveAs.Tooltip"]" disabled="@IsBusy" @onclick="SaveAsAsync">@L["Button.SaveAs"]</button>
            <label for="paint-jpeg-quality" class="tool-label">@L["Label.JpegQuality"]</label>
            <input id="paint-jpeg-quality" type="number" class="quality-input" min="10" max="100" step="5" @bind="JpegQuality" />
        </div>
        <div class="tool-group" aria-label="@L["Group.History"]">
            <button id="paint-btn-undo" class="paint-btn" title="@L["Button.Undo.Tooltip"]" disabled="@(!_state.CanUndo || IsBusy)" @onclick="UndoAsync">@L["Button.Undo"]</button>
            <button id="paint-btn-redo" class="paint-btn" title="@L["Button.Redo.Tooltip"]" disabled="@(!_state.CanRedo || IsBusy)" @onclick="RedoAsync">@L["Button.Redo"]</button>
        </div>
        <div class="tool-group" aria-label="@L["Group.Image"]">
            <button id="paint-btn-rotate" class="paint-btn" disabled="@IsBusy" @onclick="RotateAsync">@L["Button.Rotate"]</button>
            <button id="paint-btn-grid" class="paint-btn @(_state.ShowGrid ? "active" : "")" aria-pressed="@(_state.ShowGrid ? "true" : "false")" @onclick="ToggleGridAsync">@L["Button.Grid"]</button>
            <button id="paint-btn-crop" class="paint-btn @(_state.CropMode ? "active" : "")" aria-pressed="@(_state.CropMode ? "true" : "false")" @onclick="ToggleCrop">@L["Button.Crop"]</button>
            <button id="paint-btn-pan" class="paint-btn @(_state.PanMode ? "active" : "")" aria-pressed="@(_state.PanMode ? "true" : "false")" @onclick="TogglePan">@L["Button.Pan"]</button>
        </div>
        <div class="tool-group" aria-label="@L["Group.Zoom"]">
            <button class="paint-btn" @onclick="ZoomIn">@L["Button.ZoomIn"]</button><button class="paint-btn" @onclick="ZoomOut">@L["Button.ZoomOut"]</button>
            <span class="zoom-label">@((int)(_state.Scale * 100))%</span>
        </div>
        <div class="tool-group" aria-label="@L["Group.Brush"]">
            <label for="paint-color" class="tool-label">@L["Label.Color"]</label><input id="paint-color" type="color" class="color-picker" @bind="_state.ActiveColor" />
            <label for="paint-size" class="tool-label">@L["Label.Size"]</label><input id="paint-size" type="range" class="size-range" min="1" max="50" @bind="_state.BrushSize" />
            <span class="size-label">@_state.BrushSize px</span>
        </div>
    </div>
    @if (_error is not null)
    {
        <div class="paint-error" role="alert">
            <span>@_error</span>
            <button class="paint-btn" @onclick="DismissError">@L["Button.Dismiss"]</button>
        </div>
    }
    <div class="paint-viewport @(_state.ShowGrid ? "grid-overlay" : "")" tabindex="0" aria-label="@L["Viewport.AriaLabel"]">
        <div class="canvas-frame">
            <canvas @ref="_canvas" class="paint-canvas" width="@_state.Width" height="@_state.Height" aria-label="@L["Canvas.AriaLabel"]"
                    @onpointerdown="StartDrawAsync" @onpointermove="DrawAsync" @onpointerup="StopDrawAsync" @onpointercancel="StopDrawAsync"></canvas>
        </div>
    </div>
    <div class="paint-statusbar">
        @if (_busyMessage is not null)
        {
            <span class="paint-busy" role="status">@_busyMessage</span>
        }
        <span>@L["Status.Canvas", _state.Width, _state.Height]</span>
        <span>@L["Status.Tool", L[_state.CropMode ? "Tool.Crop" : _state.PanMode ? "Tool.Pan" : "Tool.Brush"]]</span>
        <span id="paint-path">@(_path?.Value ?? L["Status.NotSaved"])</span>
    </div>
</div>
