@inherits Kazo.Os.AppSdk.Blazor.KazoComponentBase
@using Kazo.Os.AppSdk.Administration

@*
    Settings > Applications > Permissions (ADR 0049 section 7). Kept apart from the Installed Apps
    tab (ADR 0048) so the two evolve independently.
*@
<div class="permissions-panel">
    @if (!_isAvailable)
    {
        <p class="setting-desc">@L["Permissions.Unavailable"]</p>
    }
    else
    {
        <section class="setting-group permissions-policy">
            <h4>@L["Permissions.Policy.Title"]</h4>
            <p class="setting-desc">
                @LocalizedMarkup.Format(L["Permissions.Policy.Description"], LocalizedMarkup.Code("/etc/hackeros/security.config"))
            </p>
            <div class="policy-options" role="radiogroup" aria-label="@L["Permissions.Policy.AriaLabel"]">
                <button type="button" role="radio" class="@PolicyClass(KazoDangerousCapabilityPolicy.Prompt)"
                        aria-checked="@(_policy == KazoDangerousCapabilityPolicy.Prompt ? "true" : "false")"
                        disabled="@_isBusy"
                        @onclick="() => ChangePolicyAsync(KazoDangerousCapabilityPolicy.Prompt)">
                    @L["Permissions.Policy.Prompt"]
                </button>
                <button type="button" role="radio" class="@PolicyClass(KazoDangerousCapabilityPolicy.Block)"
                        aria-checked="@(_policy == KazoDangerousCapabilityPolicy.Block ? "true" : "false")"
                        disabled="@_isBusy"
                        @onclick="() => ChangePolicyAsync(KazoDangerousCapabilityPolicy.Block)">
                    @L["Permissions.Policy.Block"]
                </button>
            </div>
        </section>

        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="permissions-message" role="status">@_message</div>
        }

        @if (_overview.Count == 0)
        {
            <p class="setting-desc">@L["Permissions.Empty"]</p>
        }

        @foreach (KazoAppPermissionInfo app in _overview)
        {
            <section key="@app.AppId" class="setting-group permissions-app">
                <header class="permissions-app-header">
                    <span class="permissions-app-name">@app.AppName</span>
                    <code class="permissions-app-id">@app.AppId</code>
                    <span class="@(app.IsSystemApp ? "app-kind-badge system" : "app-kind-badge")">
                        @(app.IsSystemApp ? L["Permissions.SystemApp"] : L["Permissions.NonSystemApp"])
                    </span>
                </header>
                <ul class="permissions-capabilities">
                    @foreach (KazoCapabilityPermissionInfo capability in app.Capabilities)
                    {
                        <li key="@capability.Capability" class="permissions-capability">
                            <div class="permissions-capability-text">
                                <span class="permissions-capability-title">@capability.Title</span>
                                <code>@capability.Capability</code>
                                <span class="permissions-capability-risk">@capability.RiskDescription</span>
                            </div>
                            <span class="@StateClass(capability.State)">@StateLabel(capability.State)</span>
                            @if (!app.IsSystemApp)
                            {
                                <div class="permissions-actions">
                                    @if (capability.State == KazoPermissionState.DeniedByUser)
                                    {
                                        <button type="button" class="btn-secondary" disabled="@_isBusy"
                                                @onclick="() => RemoveOwnDenialAsync(app, capability)">@L["Permissions.RemoveDenial"]</button>
                                    }
                                    @if (capability.State is not KazoPermissionState.Allowed and not KazoPermissionState.BlockedByPolicy)
                                    {
                                        <button type="button" class="btn-danger" disabled="@_isBusy"
                                                @onclick="() => SetMachineDecisionAsync(app, capability, KazoPermissionDecision.Allow)">@L["Permissions.AllowMachine"]</button>
                                    }
                                    @if (capability.State == KazoPermissionState.Allowed)
                                    {
                                        <button type="button" class="btn-secondary" disabled="@_isBusy"
                                                @onclick="() => SetMachineDecisionAsync(app, capability, KazoPermissionDecision.Deny)">@L["Permissions.Revoke"]</button>
                                    }
                                    @if (capability.State == KazoPermissionState.DeniedByAdministrator)
                                    {
                                        <button type="button" class="btn-secondary" disabled="@_isBusy"
                                                @onclick="() => SetMachineDecisionAsync(app, capability, KazoPermissionDecision.Ask)">@L["Permissions.AskAgain"]</button>
                                    }
                                </div>
                            }
                        </li>
                    }
                </ul>
            </section>
        }
    }
</div>
