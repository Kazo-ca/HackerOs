@using HackerOs.AppSdk.Icons

<div class="launcher-overlay" @ref="_overlayElement" @onclick="CloseAsync">
    <section class="launcher-popover"
             role="dialog"
             aria-label="@L["Launcher.Title"]"
             @onclick:stopPropagation="true"
             @onkeydown="HandleDialogKeyDownAsync">
        <header class="launcher-header">
            <div class="launcher-brand" aria-hidden="true">
                <HackerIcon Library="IconLibrary.Lucide" Name="blocks" Size="22" Title="" />
                <span>HackerOS</span>
            </div>

            <div class="user-identity">
                <span class="user-avatar" aria-hidden="true">
                    <HackerIcon Library="IconLibrary.Lucide" Name="user-round" Size="28" Title="" />
                </span>
                <span class="user-copy">
                    <strong>@PrincipalDisplayName</strong>
                    <small>@PrincipalLoginName</small>
                    @if (IsGuestSession)
                    {
                        @* ADR 0187 section 5: a discreet reminder; Settings ▸ Users holds the request. *@
                        <button type="button" class="guest-create" @onclick="CreateAccountAsync">@L["Launcher.Guest.CreateAccount"]</button>
                    }
                </span>
                <button type="button"
                        class="close-button"
                        aria-label="@L["Launcher.Close"]"
                        title="@L["Common.Close"]"
                        @onclick="CloseAsync">
                    <HackerIcon Library="IconLibrary.Lucide" Name="x" Size="17" Title="" />
                </button>
            </div>
        </header>

        <div class="launcher-layout">
            <main class="launcher-main">
                <div class="launcher-scroll">
                    @if (!HasSearchQuery && _projection.PinnedApps.Count > 0)
                    {
                        <section class="pinned-section" aria-labelledby="launcher-pinned-heading">
                            <div class="section-heading">
                                <h2 id="launcher-pinned-heading">@L["Launcher.Pinned"]</h2>
                                <span>@_projection.PinnedApps.Count</span>
                            </div>
                            <ul class="pinned-list">
                                @for (int index = 0; index < _projection.PinnedApps.Count; index++)
                                {
                                    AppManifest app = _projection.PinnedApps[index];
                                    int pinnedIndex = index;
                                    <li class="pinned-row">
                                        <button type="button"
                                                class="app-launch-button"
                                                aria-label="@L["Launcher.LaunchApp", app.Name]"
                                                @attributes="AppMenuAttributes(app)"
                                                @onclick="() => LaunchAppAsync(app)">
                                            <span class="app-icon-shell" aria-hidden="true">
                                                <HackerIcon Library="IconLibrary.Lucide" Name="@GetAppIconName(app)" Size="20" Title="" />
                                            </span>
                                            <span class="app-copy">
                                                <strong>@app.Name</strong>
                                                <small>@app.Description</small>
                                            </span>
                                        </button>
                                        <div class="pin-order-controls">
                                            <button type="button"
                                                    class="icon-action"
                                                    disabled="@(pinnedIndex == 0 || _isUpdatingPreferences)"
                                                    aria-label="@L["Launcher.MoveAppUp", app.Name]"
                                                    title="@L["Launcher.MoveUp"]"
                                                    @onclick="() => MovePinnedAsync(app.Id, -1)">
                                                <HackerIcon Library="IconLibrary.Lucide" Name="chevron-up" Size="15" Title="" />
                                            </button>
                                            <button type="button"
                                                    class="icon-action"
                                                    disabled="@(pinnedIndex == _projection.PinnedApps.Count - 1 || _isUpdatingPreferences)"
                                                    aria-label="@L["Launcher.MoveAppDown", app.Name]"
                                                    title="@L["Launcher.MoveDown"]"
                                                    @onclick="() => MovePinnedAsync(app.Id, 1)">
                                                <HackerIcon Library="IconLibrary.Lucide" Name="chevron-down" Size="15" Title="" />
                                            </button>
                                            <button type="button"
                                                    class="icon-action is-pinned"
                                                    disabled="@(!CanManagePins)"
                                                    aria-label="@L["Launcher.UnpinApp", app.Name]"
                                                    aria-pressed="true"
                                                    title="@L["Launcher.Unpin"]"
                                                    @onclick="() => TogglePinAsync(app.Id)">
                                                <HackerIcon Library="IconLibrary.Lucide" Name="pin-off" Size="15" Title="" />
                                            </button>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </section>
                    }

                    <section class="programs-section" aria-labelledby="launcher-programs-heading">
                        <div class="section-heading">
                            <h2 id="launcher-programs-heading">@(HasSearchQuery ? L["Launcher.SearchResults"] : L["Launcher.AllPrograms"])</h2>
                            <span>@_projection.VisibleApps.Count</span>
                        </div>

                        @if (!HasSearchQuery && _projection.Categories.Count > 0)
                        {
                            <nav class="category-list" aria-label="@L["Launcher.Categories"]">
                                <button type="button"
                                        class="category-button @(string.IsNullOrEmpty(_selectedCategory) ? "is-active" : null)"
                                        aria-pressed="@(string.IsNullOrEmpty(_selectedCategory) ? "true" : "false")"
                                        @onclick="() => SelectCategory(null)">
                                    @L["Launcher.AllCategories"]
                                </button>
                                @foreach (string category in _projection.Categories)
                                {
                                    bool isSelected = StringComparer.OrdinalIgnoreCase.Equals(_selectedCategory, category);
                                    <button type="button"
                                            class="category-button @(isSelected ? "is-active" : null)"
                                            aria-pressed="@(isSelected ? "true" : "false")"
                                            @onclick="() => SelectCategory(category)">
                                        @FormatCategory(category)
                                    </button>
                                }
                            </nav>
                        }

                        <div id="launcher-app-list"
                             class="app-list"
                             role="grid"
                             aria-label="@(HasSearchQuery ? L["Launcher.SearchResultsList"] : L["Launcher.AvailableApps"])">
                            @if (_projection.VisibleApps.Count == 0)
                            {
                                <div class="empty-state" role="row">
                                    <div class="empty-state-content" role="gridcell">
                                        <HackerIcon Library="IconLibrary.Lucide" Name="search-x" Size="28" Title="" />
                                        <span role="status">@L["Launcher.NoMatch"]</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                @for (int index = 0; index < _projection.VisibleApps.Count; index++)
                                {
                                    AppManifest app = _projection.VisibleApps[index];
                                    bool isSelected = index == _selectedIndex;
                                    bool isPinned = IsPinned(app.Id);
                                    int currentIndex = index;
                                    <div id="@GetOptionId(app)"
                                         class="app-row @(isSelected ? "is-focused" : null)"
                                         role="row"
                                         aria-selected="@(isSelected ? "true" : "false")"
                                         @onmouseenter="() => SetSelectedIndex(currentIndex)">
                                        <div class="app-launch-cell" role="gridcell">
                                            <button type="button"
                                                    class="app-launch-button"
                                                    aria-label="@L["Launcher.LaunchApp", app.Name]"
                                                    @attributes="AppMenuAttributes(app)"
                                                    @onclick="() => LaunchAppAsync(app)">
                                                <span class="app-icon-shell" aria-hidden="true">
                                                    <HackerIcon Library="IconLibrary.Lucide" Name="@GetAppIconName(app)" Size="20" Title="" />
                                                </span>
                                                <span class="app-copy">
                                                    <strong>@app.Name</strong>
                                                    <small>@app.Description</small>
                                                </span>
                                            </button>
                                        </div>
                                        <div class="pin-cell" role="gridcell">
                                            <button type="button"
                                                    class="pin-toggle @(isPinned ? "is-pinned" : null)"
                                                    disabled="@(!CanManagePins)"
                                                    aria-label="@(isPinned ? L["Launcher.UnpinApp", app.Name] : L["Launcher.PinApp", app.Name])"
                                                    aria-pressed="@(isPinned ? "true" : "false")"
                                                    title="@(isPinned ? L["Launcher.Unpin"] : L["Launcher.Pin"])"
                                                    @onclick="() => TogglePinAsync(app.Id)">
                                                <HackerIcon Library="IconLibrary.Lucide" Name="@(isPinned ? "pin-off" : "pin")" Size="16" Title="" />
                                            </button>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </section>
                </div>

                <footer class="search-footer">
                    <div class="search-box">
                        <span class="search-icon" aria-hidden="true">
                            <HackerIcon Library="IconLibrary.Lucide" Name="search" Size="17" Title="" />
                        </span>
                        <input id="launcher-search"
                               @ref="_searchInputRef"
                               type="search"
                               class="search-input"
                               value="@_searchQuery"
                               placeholder="@L["Launcher.SearchPlaceholder"]"
                               autocomplete="off"
                               spellcheck="false"
                               role="combobox"
                               aria-label="@L["Launcher.SearchLabel"]"
                               aria-autocomplete="list"
                               aria-haspopup="grid"
                               aria-expanded="true"
                               aria-controls="launcher-app-list"
                               aria-activedescendant="@ActiveOptionId"
                               @oninput="HandleSearchInput"
                               @onkeydown="HandleSearchKeyDownAsync"
                               @onkeydown:stopPropagation="true" />
                        @if (HasSearchQuery)
                        {
                            <button type="button"
                                    class="clear-search-button"
                                    aria-label="@L["Launcher.ClearSearch"]"
                                    title="@L["Launcher.ClearSearchTitle"]"
                                    @onclick="ClearSearch">
                                <HackerIcon Library="IconLibrary.Lucide" Name="x" Size="15" Title="" />
                            </button>
                        }
                    </div>
                    <span class="visually-hidden" aria-live="polite">@SearchStatus</span>
                </footer>
            </main>

            <aside class="quick-panel" aria-label="@L["Launcher.QuickAccess"]">
                <h2>@L["Launcher.QuickAccess"]</h2>
                <button type="button"
                        class="quick-link"
                        disabled="@(FileExplorerApp is null)"
                        aria-label="@L["Launcher.OpenFileExplorer"]"
                        @onclick="() => LaunchQuickAppAsync(FileExplorerAppId)">
                    <span class="quick-icon" aria-hidden="true">
                        <HackerIcon Library="IconLibrary.Lucide" Name="folder" Size="22" Title="" />
                    </span>
                    <span>
                        <strong>@L["Launcher.FileExplorer"]</strong>
                        <small>@L["Launcher.FileExplorerHint"]</small>
                    </span>
                </button>
                <button type="button"
                        class="quick-link"
                        disabled="@(SettingsApp is null)"
                        aria-label="@L["Launcher.OpenSettings"]"
                        @onclick="() => LaunchQuickAppAsync(SettingsAppId)">
                    <span class="quick-icon" aria-hidden="true">
                        <HackerIcon Library="IconLibrary.Lucide" Name="settings" Size="22" Title="" />
                    </span>
                    <span>
                        <strong>@L["Launcher.Settings"]</strong>
                        <small>@L["Launcher.SettingsHint"]</small>
                    </span>
                </button>

                <div class="quick-panel-spacer"></div>
                <div class="session-summary">
                    <HackerIcon Library="IconLibrary.Lucide" Name="shield-check" Size="17" Title="" />
                    <span>@L["Launcher.LocalSession"]</span>
                </div>

                @if (HasPowerMenu)
                {
                    @* ADR 0195: the session's Power button, moved from the taskbar into the Start menu. *@
                    @* Its keys stay in it: an Escape reaching the desktop shell would close the Start menu with the Power menu open. *@
                    <div class="power-region" @onkeydown="HandlePowerKeyDownAsync" @onkeydown:stopPropagation="true">
                        @if (_isPowerMenuOpen)
                        {
                            <div id="launcher-power-menu" class="power-menu" role="menu" aria-label="@L["Launcher.Power.Menu"]">
                                @if (OnSignOut.HasDelegate)
                                {
                                    <button type="button" class="power-item" role="menuitem" @ref="_signOutItemRef" @onclick="SignOutAsync">
                                        <HackerIcon Library="IconLibrary.Lucide" Name="log-out" Size="17" Title="" />
                                        <span>@L["Launcher.Power.SignOut"]</span>
                                    </button>
                                }
                                <button type="button"
                                        class="power-item"
                                        role="menuitem"
                                        disabled
                                        aria-disabled="true"
                                        title="@SwitchUserHint">
                                    <HackerIcon Library="IconLibrary.Lucide" Name="users" Size="17" Title="" />
                                    <span>
                                        @L["Launcher.Power.SwitchUser"]
                                        <small>@SwitchUserHint</small>
                                    </span>
                                </button>
                                @if (OnRestart.HasDelegate)
                                {
                                    <button type="button" class="power-item" role="menuitem" @ref="_restartItemRef" @onclick="RestartAsync">
                                        <HackerIcon Library="IconLibrary.Lucide" Name="rotate-ccw" Size="17" Title="" />
                                        <span>@L["Launcher.Power.Restart"]</span>
                                    </button>
                                }
                            </div>
                        }
                        <button type="button"
                                class="power-trigger @(_isPowerMenuOpen ? "is-active" : null)"
                                aria-haspopup="menu"
                                aria-expanded="@(_isPowerMenuOpen ? "true" : "false")"
                                aria-controls="launcher-power-menu"
                                @ref="_powerTriggerRef"
                                @onclick="TogglePowerMenu">
                            <HackerIcon Library="IconLibrary.Lucide" Name="power" Size="17" Title="" />
                            <span>@L["Launcher.Power"]</span>
                        </button>
                    </div>
                }
            </aside>
        </div>
    </section>
</div>
