{
  "$schema": "http://json.schemastore.org/template",
  "author": "KazoOS",
  "classifications": [ "KazoOS", "Web", "App" ],
  "identity": "HackerOs.Templates.Site",
  "groupIdentity": "HackerOs.Templates.Site",
  "name": "KazoOS ASP.Hack site",
  "description": "A web site served inside KazoOS by ASP.Hack (WebAppDefinition), opened in the KazoOS browser.",
  "shortName": "hackeros-site",
  "sourceName": "HackerOs.Template.Site",
  "preferNameDirectory": true,
  "tags": { "language": "C#", "type": "project" },
  "symbols": {
    "appId": {
      "type": "parameter",
      "datatype": "text",
      "description": "Application id (reverse-DNS, lowercase), unique in the catalog.",
      "defaultValue": "com.example.my-app",
      "replaces": "com.example.template-app"
    },
    "publisherId": {
      "type": "parameter",
      "datatype": "text",
      "description": "Publisher id written in the manifest.",
      "defaultValue": "pub.example",
      "replaces": "pub.template"
    }
  }
}
