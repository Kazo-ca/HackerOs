<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../Packaging.props" />

  <PropertyGroup>
    <PackageId>Kazo.Os.Platform.WorkerHost</PackageId>
    <Description>Headless Kazo OS processes (commands, services) in Web Workers: worker pool, remote execution context and watchdog.</Description>
    <PackageTags>kazoos;platform;web-workers</PackageTags>
  </PropertyGroup>

  <!--
    ADR 0070/0071: headless processes (commands, services) in Web Workers.
    - Worker side: the OS inside a worker. A remote IAppExecutionContext whose gateways turn every
      SDK call into a message to the OS, the process table of the worker, its heartbeat and CPU meter,
      and the [JSExport] entry point the worker bootstrap calls (Browser/).
    - OS side: the worker pool (one worker per virtual core, the always-ready worker, overflow and
      ceiling), the dispatcher that serves remote calls through the process's trusted context, the
      watchdog and escalation step 4, and the measurements fed back to /proc.
    The JavaScript (worker creation, postMessage, terminate) lives in Kazo.Os.Infrastructure.Browser's
    wwwroot, never in a host (AGENTS.md).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- [JSExport]/[JSImport] generated marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Kazo.Os.App.Abstractions\Kazo.Os.App.Abstractions.csproj" />
    <ProjectReference Include="..\..\Shared\Kazo.Os.Simulation.Abstractions\Kazo.Os.Simulation.Abstractions.csproj" />
    <ProjectReference Include="..\..\Shared\Kazo.Os.AppSdk\Kazo.Os.AppSdk.csproj" />
    <ProjectReference Include="..\Kazo.Os.Platform.Core\Kazo.Os.Platform.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kazo.Os.Platform.WorkerHost.Tests" />
    <!-- ADR 0133: the window renderer tests build a WorkerWindowRun around a fake post. -->
    <InternalsVisibleTo Include="Kazo.Os.Platform.RemoteRendering.Tests" />
  </ItemGroup>

</Project>
