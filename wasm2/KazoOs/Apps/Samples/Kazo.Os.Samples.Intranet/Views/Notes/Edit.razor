@inherits HackView<Note>
@layout _Layout
@*
    The form of a new note (Create) and of an existing one (Edit). After a refused POST the
    controller renders it again with the posted values and the errors of ModelState.
*@
@{ ViewData.Title = IsNew ? "New note" : $"Edit {Model.Title}"; }
<section class="panel narrow">
    <h1>@(IsNew ? "New note" : "Edit note")</h1>
    <HackValidationSummary ModelOnly="true" />
    <HackForm Action="@(IsNew ? "Create" : "Edit")" RouteValues="@(IsNew ? null : HackRoute.Values(new { id = Model.Id }))" class="form" id="note-form">
        <div class="field">
            <label for="Title">Title</label>
            <input id="Title" name="Title" value="@Model.Title" maxlength="60" />
            <HackValidationMessage For="Title" />
        </div>
        <div class="field">
            <label for="Body">Text</label>
            <textarea id="Body" name="Body" rows="6" maxlength="500">@Model.Body</textarea>
            <HackValidationMessage For="Body" />
        </div>
        <div class="field check">
            <input type="checkbox" id="Pinned" name="Pinned" checked="@Model.Pinned" />
            <label for="Pinned">Pin at the top of the list</label>
        </div>
        <div class="actions">
            <button type="submit" class="button" id="note-save">Save</button>
            <HackLink Action="Index" class="button ghost">Cancel</HackLink>
        </div>
    </HackForm>
</section>

@code {
    private bool IsNew => Model.Id == 0;
}
