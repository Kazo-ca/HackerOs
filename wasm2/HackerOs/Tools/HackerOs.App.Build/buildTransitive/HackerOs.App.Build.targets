<Project>
  <!--
    HackerOs.App.Build (ADR 0098 §2): the same build integration as inside the Kazo OS repository,
    in package mode. A project referencing this package is an app (manifest.json generated after the
    build, SDK boundary checked on its HackerOs.* packages) unless it sets HackerOsAppHost to true,
    in which case it aggregates the apps of its packages into BuiltInApplications.json.
  -->
  <PropertyGroup>
    <HackerOsBuildFromPackage>true</HackerOsBuildFromPackage>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)../hackeros-build/HackerOs.Apps.targets" />
</Project>
