@using Kazo.Os.App.Abstractions
@using Kazo.Os.App.Abstractions.Policy
@using Kazo.Os.AppSdk
@using Kazo.Os.AppSdk.Blazor
@using Kazo.Os.Platform.Blazor.Dialogs
@using Kazo.Os.Platform.Blazor.Windows
@using Kazo.Os.Simulation.Abstractions
@using Kazo.Os.Simulation.Abstractions.FileSystem
@using Kazo.Os.Simulation.Abstractions.Gateways
@using Kazo.Os.Simulation.Abstractions.Processes
@using Kazo.Os.Simulation.Abstractions.Sessions
@using Kazo.Os.Windowing.Core
@using Kazo.Os.Windowing.Abstractions
@implements IDisposable

<section class="dialog-browser-scenario" data-status="ready">
    <nav aria-label="File dialog test controls">
        <button type="button" @onclick="OpenFilesAsync">Open filtered files</button>
        <button type="button" @onclick="SaveFileAsync">Save existing file</button>
        <button type="button" @onclick="SelectFolderAsync">Select or create folder</button>
        <button type="button" @onclick="OpenDeniedAsync">Open denied folder</button>
    </nav>
    <output role="status" data-dialog-result="@_result">@_result</output>
    <DesktopArea Windows="_runtime.Windows"
                 OnFocus="Focus"
                 OnMinimize="Ignore"
                 OnToggleMaximize="Ignore"
                 OnClose="Close"
                 OnGesture="Apply">
        <WindowContent Context="window">
            @if (window.Content is not null)
            {
                @window.Content
            }
            else
            {
                <button type="button" class="owner-content" data-app-id="@window.AppId">Dialog owner</button>
            }
        </WindowContent>
    </DesktopArea>
</section>

@code {
    private static readonly SessionId TestSessionId = SessionId.FromGuid(Guid.Parse("41000000-0000-0000-0000-000000000001"));
    private static readonly ProcessId OwnerProcessId = ProcessId.FromInt64(41);
    private static readonly Guid OwnerInstanceId = Guid.Parse("42000000-0000-0000-0000-000000000001");
    private readonly WindowRuntime _runtime = new(new WindowBounds(0, 0, 960, 640));
    private readonly FileDialogCoordinator _coordinator = new(TestSessionId, new HarnessHandleRegistry());
    private FileDialogWindowAdapter _adapter = null!;
    private HarnessExecutionContext _context = null!;
    private string _result = "Idle";

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        _context = new HarnessExecutionContext(TestSessionId, OwnerProcessId, OwnerInstanceId);
        _runtime.Apply(new CreateWindowCommand(new WindowRuntimeState(
            WindowId.FromGuid(Guid.Parse("43000000-0000-0000-0000-000000000001")),
            _context.Manifest.Id,
            WindowOwnerId.FromGuid(OwnerInstanceId),
            "Dialog Owner",
            null,
            new WindowBounds(80, 70, 360, 280),
            null,
            0,
            WindowVisualState.Normal,
            new WindowConstraints(true, 240, 180))));
        _adapter = new FileDialogWindowAdapter(_coordinator, _runtime);
        _adapter.Changed += AdapterChanged;
    }

    /// <inheritdoc />
    public void Dispose()
    {
        _adapter.Changed -= AdapterChanged;
        _adapter.Dispose();
        _coordinator.Dispose();
    }

    private async Task OpenFilesAsync()
    {
        _context.FileSystemGateway.DenyEnumeration = false;
        _result = "Pending";
        OpenFileDialogResult result = await _coordinator.OpenFileAsync(_context, new OpenFileDialogRequest
        {
            Title = "Choose text files",
            InitialDirectory = VirtualPath.Parse("/home/user"),
            AllowMultiple = true,
            Filters = [new FileDialogFilter("Text", [".txt"], ["text/markdown"])],
        });
        _result = result.Status == FileDialogStatus.Selected
            ? $"Selected:{string.Join(',', result.Resources.Select(resource => resource.Path.Value))}"
            : "Cancelled";
    }

    private async Task SaveFileAsync()
    {
        _context.FileSystemGateway.DenyEnumeration = false;
        _result = "Pending";
        SaveFileDialogResult result = await _coordinator.SaveFileAsync(_context, new SaveFileDialogRequest
        {
            Title = "Save report",
            InitialDirectory = VirtualPath.Parse("/home/user"),
            SuggestedFileName = "readme",
            DefaultExtension = ".txt",
            ConfirmOverwrite = true,
        });
        _result = result.Status == FileDialogStatus.Selected ? $"Saved:{result.Resource!.Path.Value}" : "Cancelled";
    }

    private async Task SelectFolderAsync()
    {
        _context.FileSystemGateway.DenyEnumeration = false;
        _result = "Pending";
        SelectFolderDialogResult result = await _coordinator.SelectFolderAsync(_context, new SelectFolderDialogRequest
        {
            Title = "Choose workspace",
            InitialDirectory = VirtualPath.Parse("/home/user"),
            AllowCreateFolder = true,
        });
        _result = result.Status == FileDialogStatus.Selected ? $"Folder:{result.Resource!.Path.Value}" : "Cancelled";
    }

    private async Task OpenDeniedAsync()
    {
        _context.FileSystemGateway.DenyEnumeration = true;
        _result = "Pending";
        OpenFileDialogResult result = await _coordinator.OpenFileAsync(_context, new OpenFileDialogRequest
        {
            Title = "Denied folder",
            InitialDirectory = VirtualPath.Parse("/protected"),
        });
        _result = result.Status == FileDialogStatus.Cancelled ? "DeniedCancelled" : "Unexpected";
    }

    private Task Focus(WindowId id) => Apply(new FocusWindowCommand(id));
    private Task Ignore(WindowId id) => Task.CompletedTask;

    private async Task Close(WindowId id)
    {
        WindowRuntimeState? window = _runtime.Windows.FirstOrDefault(w => w.Id == id);
        if (window?.OnRequestClose is { } onRequestClose)
        {
            await onRequestClose();
        }
        else
        {
            _runtime.Apply(new ForceWindowCloseCommand(id));
        }

        StateHasChanged();
    }

    private Task Apply(WindowCommand command)
    {
        _runtime.Apply(command);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void AdapterChanged() => InvokeAsync(StateHasChanged);

    private sealed class HarnessExecutionContext(
        SessionId sessionId,
        ProcessId processId,
        Guid instanceId) : IAppExecutionContext
    {
        public AppManifest Manifest { get; } = new()
        {
            Id = "org.hackeros.browser.dialog-owner",
            Name = "Dialog Owner",
            Version = "1.0.0",
            PublisherId = "org.hackeros",
            Description = "Browser file-dialog integration proof.",
            Kind = AppKind.Window,
            EntryPoint = new AppEntryPointManifest("Harness", "DialogOwner"),
            SdkCompatibility = new AppSdkCompatibilityManifest("1.0.0"),
            Presentation = new PresentationManifest("test", AppLaunchVisibility.Visible, []),
            Resources = AppResourceProfileManifest.None,
        };

        public Guid InstanceId { get; } = instanceId;
        public string UserId => "user";
        public AppAuthority UserAuthority => AppAuthority.User;
        public IReadOnlySet<string> GrantedCapabilities { get; } = new HashSet<string> { AppCapabilities.DialogFileOpen };
        public SessionId SessionId { get; } = sessionId;
        public ProcessId ProcessId { get; } = processId;
        public CancellationToken CancellationToken => CancellationToken.None;
        public ICapabilityChecker Capabilities { get; } = new AllowCapabilityChecker();
        public HarnessFileSystemGateway FileSystemGateway { get; } = new();
        public IAppFileSystemGateway FileSystem => FileSystemGateway;
        public IAppEventGateway Events => throw new NotSupportedException();
        public IAppNotificationGateway Notifications => throw new NotSupportedException();
        public IAppLoggingGateway Logging => throw new NotSupportedException();
        public IAppClockGateway Clock => throw new NotSupportedException();
        public IAppProcessGateway Processes => throw new NotSupportedException();
    }

    private sealed class AllowCapabilityChecker : ICapabilityChecker
    {
        public CapabilityPolicyEvaluation Evaluate(string capability, AppAuthority requiredAuthority = AppAuthority.User, CapabilityResourceCandidate? resourceCandidate = null) =>
            CapabilityPolicyEvaluation.DenyMissing(1);

        public void Require(string capability, AppAuthority requiredAuthority = AppAuthority.User, CapabilityResourceCandidate? resourceCandidate = null)
        {
        }
    }

    private sealed class HarnessFileSystemGateway : IAppFileSystemGateway
    {
        private static readonly DateTimeOffset Timestamp = new(2026, 8, 2, 0, 0, 0, TimeSpan.Zero);
        private readonly SortedSet<string> _folders = [];

        public bool DenyEnumeration { get; set; }

        public ValueTask<FileSystemResult<FileSystemDirectorySnapshot>> EnumerateAsync(FileSystemEnumerateRequest request, CancellationToken cancellationToken = default)
        {
            if (DenyEnumeration)
            {
                return ValueTask.FromResult(FileSystemResult<FileSystemDirectorySnapshot>.Failure(
                    new FileSystemError(FileSystemOperation.Enumerate, FileSystemErrorCode.PermissionDenied, request.Path)));
            }

            FileSystemTimestamps timestamps = new(Timestamp, Timestamp, Timestamp);
            FileSystemPermissions permissions = FileSystemPermissions.FromMode(0x1A4);
            List<FileSystemDirectoryItem> entries =
            [
                new(FileSystemEntryName.Parse(".private.txt"), new FileMetadata(FileSystemEntryId.FromGuid(Guid.Parse("44000000-0000-0000-0000-000000000004")), "user", "users", permissions, timestamps, 1, 16, "text/plain")),
                new(FileSystemEntryName.Parse("image.png"), new FileMetadata(FileSystemEntryId.FromGuid(Guid.Parse("44000000-0000-0000-0000-000000000001")), "user", "users", permissions, timestamps, 1, 128, "image/png")),
                new(FileSystemEntryName.Parse("notes.md"), new FileMetadata(FileSystemEntryId.FromGuid(Guid.Parse("44000000-0000-0000-0000-000000000002")), "user", "users", permissions, timestamps, 1, 64, "text/markdown")),
                new(FileSystemEntryName.Parse("readme.txt"), new FileMetadata(FileSystemEntryId.FromGuid(Guid.Parse("44000000-0000-0000-0000-000000000003")), "user", "users", permissions, timestamps, 1, 32, "text/plain")),
            ];
            entries.AddRange(_folders.Select((name, index) => new FileSystemDirectoryItem(
                FileSystemEntryName.Parse(name),
                new DirectoryMetadata(FileSystemEntryId.FromGuid(new Guid(45 + index, 0, 0, new byte[8])), "user", "users", FileSystemPermissions.FromMode(0x1ED), timestamps, 1))));
            return ValueTask.FromResult(FileSystemResult<FileSystemDirectorySnapshot>.Success(
                new FileSystemDirectorySnapshot(request.Path, 1 + _folders.Count, entries.OrderBy(entry => entry.Name.Value, StringComparer.Ordinal))));
        }

        public ValueTask<FileSystemResult<FileSystemContentReadHandle>> ReadAsync(FileSystemReadRequest request, CancellationToken cancellationToken = default) => throw new NotSupportedException();
        public ValueTask<FileSystemMutationResult> CreateAsync(FileSystemCreateRequest request, CancellationToken cancellationToken = default)
        {
            _folders.Add(request.Path.Value[(request.Path.Value.LastIndexOf('/') + 1)..]);
            return ValueTask.FromResult(new FileSystemMutationResult(FileSystemTransactionResult.Committed(
                Guid.NewGuid(), [FileSystemEntryId.FromGuid(Guid.NewGuid())])));
        }
        public ValueTask<FileSystemMutationResult> WriteAsync(FileSystemWriteRequest request, IFileSystemContentSource content, CancellationToken cancellationToken = default) => throw new NotSupportedException();
        public ValueTask<FileSystemMutationResult> MoveAsync(FileSystemMoveRequest request, CancellationToken cancellationToken = default) => throw new NotSupportedException();
        public ValueTask<FileSystemMutationResult> CopyAsync(FileSystemCopyRequest request, CancellationToken cancellationToken = default) => throw new NotSupportedException();
        public ValueTask<FileSystemMutationResult> DeleteAsync(FileSystemDeleteRequest request, CancellationToken cancellationToken = default) => throw new NotSupportedException();
        public ValueTask<FileSystemResult<FileSystemEntrySnapshot>> StatAsync(FileSystemStatRequest request, CancellationToken cancellationToken = default)
        {
            if (request.Path.Value.EndsWith("/readme.txt", StringComparison.Ordinal))
            {
                FileSystemTimestamps timestamps = new(Timestamp, Timestamp, Timestamp);
                FileMetadata metadata = new(FileSystemEntryId.FromGuid(Guid.Parse("44000000-0000-0000-0000-000000000003")), "user", "users", FileSystemPermissions.FromMode(0x1A4), timestamps, 1, 32, "text/plain");
                return ValueTask.FromResult(FileSystemResult<FileSystemEntrySnapshot>.Success(new FileSystemEntrySnapshot(request.Path, metadata)));
            }

            return ValueTask.FromResult(FileSystemResult<FileSystemEntrySnapshot>.Failure(
                new FileSystemError(FileSystemOperation.Stat, FileSystemErrorCode.NotFound, request.Path)));
        }
        public ValueTask<FileSystemMutationResult> SetPermissionsAsync(FileSystemSetPermissionsRequest request, CancellationToken cancellationToken = default) => throw new NotSupportedException();
        public IAppFileSystemGateway WithSelectedHandle(FileSystemSelectedResourceHandle handle) => this;
    }

    private sealed class HarnessHandleRegistry : IFileSystemSelectedResourceHandleRegistry
    {
        public FileSystemSelectedResourceHandle Issue(string appId, string userId, VirtualPath path, FileSystemHandleAccess access, TimeSpan validFor, ProcessId? issuedToProcessId = null)
        {
            DateTimeOffset issuedAt = new(2026, 8, 2, 0, 0, 0, TimeSpan.Zero);
            return new FileSystemSelectedResourceHandle(Guid.NewGuid(), appId, userId, path, access, issuedAt, issuedAt + validFor, 1);
        }

        public bool TryGet(Guid handleId, out FileSystemSelectedResourceHandle handle) { handle = null!; return false; }
        public bool Revoke(Guid handleId) => false;
        public int RevokeAllForProcess(ProcessId processId) => 0;
        public int RevokeAllForUser(string userId) => 0;
        public int RevokeAllForApp(string appId) => 0;
    }
}
