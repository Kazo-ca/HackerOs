@namespace HackerOs.Platform.Blazor.Display
@using HackerOs.AppSdk.Blazor.Display
@using HackerOs.Platform.Blazor.Security
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@implements IDisposable
@inject ScreenService ScreenService
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JSRuntime
@inject IServiceProvider Services
@*
    ADR 0178 §4, ADR 0180: the secondary screens and the « Restaurer les écrans » offer. Each screen
    is a display surface; its content is rendered here and moved into the screen's window: its
    desktop (ScreenContent, ADR 0178 §1), the slot the overlays move to when the user acts there
    (ADR 0179 §2), and a veil that sends the user to screen 1 while a secure dialog waits there.
*@

@foreach (SecondaryScreen screen in ScreenService.Screens)
{
    <DisplaySurfaceContent @key="screen.Surface.Id" Surface="screen.Surface">
        <div class="secondary-screen" data-display="@screen.Id.Number">
            <div class="secondary-screen-desktop">
                @if (ScreenContent is not null)
                {
                    @ScreenContent(screen)
                }
                else
                {
                    <div class="secondary-screen-number" aria-hidden="true">@screen.Id.Number</div>
                }
            </div>

            <div class="secondary-screen-overlays" data-screen-overlay-slot data-display="@screen.Id.Number"></div>

            @* ADR 0179 §6: this screen's number while « Autre écran ▸ Écran N » is highlighted. *@
            <ScreenIdentifyVeil Number="screen.Id.Number" />

            @if (IsSecureDialogShown)
            {
                <div class="secondary-screen-secure-veil" role="alertdialog" aria-modal="true" aria-labelledby="@($"secure-veil-{screen.Id.Number}")">
                    <div class="secondary-screen-secure-card">
                        <p id="@($"secure-veil-{screen.Id.Number}")">@L["Screens.SecureDialog.Message"]</p>
                        <button type="button" class="secondary-screen-secure-action" @onclick="FocusPrimaryAsync">@L["Screens.SecureDialog.Action"]</button>
                    </div>
                </div>
            }

            @if (ScreenService.IsPrimaryHidden)
            {
                <div class="secondary-screen-banner" role="status">@L["Screens.PrimaryHidden"]</div>
            }

            <button type="button"
                    class="secondary-screen-fullscreen"
                    title="@(screen.IsFullScreen ? L["Screens.ExitFullScreen"] : L["Screens.FullScreen"])"
                    aria-label="@(screen.IsFullScreen ? L["Screens.ExitFullScreen"] : L["Screens.FullScreen"])"
                    @onclick="() => ToggleFullScreenAsync(screen)">
                @(screen.IsFullScreen ? "⤡" : "⤢")
            </button>
        </div>
    </DisplaySurfaceContent>
}

@if (ScreenService.RestorableScreens.Count > 0)
{
    <aside class="screens-restore" role="region" aria-label="@L["Screens.Restore.Action"]">
        <p class="screens-restore-message">@L["Screens.Restore.Message"]</p>
        <div class="screens-restore-actions">
            <button type="button" id="screens-restore" class="screens-restore-primary" @onclick="RestoreAsync">@L["Screens.Restore.Action"]</button>
            <button type="button" id="screens-restore-dismiss" @onclick="DismissAsync">@L["Screens.Restore.Dismiss"]</button>
        </div>
    </aside>
}

@code {
    private const string OverlaysModulePath = "./_content/HackerOs.Platform.Blazor/screenOverlays.js";

    private DangerousCapabilityApprovalBroker? _approvals;
    private AdministratorAuthenticationBroker? _authentications;

    /// <summary>What a secondary screen shows (its desktop, ADR 0178 §1); its number without it.</summary>
    [Parameter]
    public RenderFragment<SecondaryScreen>? ScreenContent { get; set; }

    /// <summary>A secure dialog (ADR 0049) waits on screen 1: the other screens send the user there (ADR 0179 §2).</summary>
    private bool IsSecureDialogShown => _approvals?.Current is not null || _authentications?.Current is not null;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        ScreenService.Changed += OnChanged;
        _approvals = Services.GetService<DangerousCapabilityApprovalBroker>();
        _authentications = Services.GetService<AdministratorAuthenticationBroker>();
        if (_approvals is not null)
        {
            _approvals.Changed += OnChanged;
        }

        if (_authentications is not null)
        {
            _authentications.Changed += OnChanged;
        }
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ScreenService.StartAsync();
        }
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private Task ToggleFullScreenAsync(SecondaryScreen screen) => ScreenService.ToggleFullScreenAsync(screen.Id);

    private Task RestoreAsync() => ScreenService.RestoreScreensAsync();

    private Task DismissAsync() => ScreenService.DismissRestoreAsync();

    private async Task FocusPrimaryAsync()
    {
        try
        {
            await using IJSObjectReference module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", OverlaysModulePath);
            await module.InvokeVoidAsync("focusPrimary");
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or InvalidOperationException)
        {
            // No browser: the message still says where to go.
        }
    }

    /// <inheritdoc />
    public void Dispose()
    {
        ScreenService.Changed -= OnChanged;
        if (_approvals is not null)
        {
            _approvals.Changed -= OnChanged;
        }

        if (_authentications is not null)
        {
            _authentications.Changed -= OnChanged;
        }
    }
}
