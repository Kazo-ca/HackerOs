<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@(ViewData.Title ?? "Cshtml site")</title>
    <link rel="stylesheet" href="@Url.Content("~/css/site.css")" />
</head>
<body data-starts="@ViewData["Starts"]">
    <nav>@Html.ActionLink("Home", "Index", "Cshtml", HackRoute.Values(new { @class = "brand" }))</nav>
    <main>@RenderBody()</main>
    <footer>@Context.Request.Path</footer>
    @RenderSection("Scripts", required: false)
</body>
</html>
