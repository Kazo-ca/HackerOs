@namespace Kazo.Os.Platform.Blazor.Dialogs
@using Kazo.Os.App.Abstractions
@using Kazo.Os.AppSdk.Blazor.Files
@using Kazo.Os.Simulation.Abstractions.FileSystem
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@inject IStringLocalizer<Strings> L

<section class="file-dialog" role="dialog" aria-modal="true" aria-labelledby="@_titleId"
         tabindex="-1" @onkeydown="HandleKeyDown">
    <header>
        <MudIcon Icon="@Icons.Material.Filled.Save" />
        <h2 id="@_titleId">@(Presentation.Request.Title ?? L["FileDialog.SaveFile"])</h2>
    </header>

    <FileDialogBrowser Context="@Presentation.Context"
                       FileSystem="@Presentation.FileSystem"
                       InitialDirectory="@EffectiveInitialDirectory"
                       AllowFileSelection="false"
                       Features="KazoFileViewFeatures.CreateFolder | KazoFileViewFeatures.Rename"
                       DirectoryChanged="DirectoryChanged"
                       FileActivated="UseExistingName" />

    <label class="name-control">
        <span>@L["FileDialog.FileName"]</span>
        <input value="@_fileName" @oninput="ChangeName" aria-invalid="@(_error is not null ? "true" : "false")" />
    </label>

    @if (_error is not null)
    {
        <p class="error" role="alert">@_error</p>
    }

    @if (_confirmPath is VirtualPath conflictPath)
    {
        <div class="overwrite" role="alertdialog" aria-label="@L["FileDialog.ConfirmOverwrite"]">
            <span>@L["FileDialog.AlreadyExists", conflictPath.Value]</span>
            <button type="button" @onclick="RejectOverwrite">@L["Common.No"]</button>
            <button type="button" class="danger" @onclick="ConfirmOverwrite">@L["FileDialog.Replace"]</button>
        </div>
    }

    <footer>
        <button type="button" @onclick="Cancel">@L["Common.Cancel"]</button>
        <button type="button" class="primary" disabled="@_checking" @onclick="SaveAsync">@L["FileDialog.Save"]</button>
    </footer>
</section>

@code {
    /// <summary>Gets or sets the active save-file presentation.</summary>
    [Parameter, EditorRequired]
    public SaveFileDialogPresentation Presentation { get; set; } = null!;

    /// <summary>Gets or sets the owning session coordinator.</summary>
    [Parameter, EditorRequired]
    public FileDialogCoordinator Coordinator { get; set; } = null!;

    private readonly string _titleId = $"save-file-title-{Guid.NewGuid():N}";
    private VirtualPath _directory = VirtualPath.Parse("/");
    private VirtualPath? _confirmPath;
    private string _fileName = string.Empty;
    private string? _error;
    private bool _checking;
    private bool _initialized;

    private VirtualPath EffectiveInitialDirectory =>
        Presentation.Request.InitialDirectory ?? VirtualPath.Parse($"/home/{Presentation.UserId}");

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        // Only seed the file name and browsed directory once. This component re-renders (and
        // OnParametersSet re-runs) on every host shell render while the dialog is open — e.g. on
        // window focus changes — not only when Presentation actually changes; resetting _directory
        // unconditionally on every call silently discarded folder navigation and saved into the
        // initial directory regardless of where the user had browsed to.
        if (_initialized)
        {
            return;
        }

        _initialized = true;
        _fileName = Presentation.Request.SuggestedFileName ?? string.Empty;
        _directory = EffectiveInitialDirectory;
    }

    private void DirectoryChanged(VirtualPath directory) => _directory = directory;

    private void ChangeName(ChangeEventArgs args)
    {
        _fileName = args.Value?.ToString() ?? string.Empty;
        _error = null;
        _confirmPath = null;
    }

    private async Task SaveAsync()
    {
        _error = null;
        string candidate = _fileName;
        if (!string.IsNullOrEmpty(Presentation.Request.DefaultExtension)
            && !candidate.EndsWith(Presentation.Request.DefaultExtension, StringComparison.OrdinalIgnoreCase))
        {
            candidate += Presentation.Request.DefaultExtension;
        }

        FileSystemEntryName name;
        try
        {
            name = FileSystemEntryName.Parse(candidate);
        }
        catch (FormatException exception)
        {
            _error = exception.Message;
            return;
        }

        VirtualPath destination = Combine(_directory, name.Value);
        _checking = true;
        FileSystemResult<FileSystemEntrySnapshot> existing = await Presentation.FileSystem.StatAsync(
            new FileSystemStatRequest(destination));
        _checking = false;
        if (existing.Succeeded)
        {
            if (Presentation.Request.ConfirmOverwrite)
            {
                _confirmPath = destination;
                return;
            }

            Coordinator.SelectSave(Presentation.Id, destination);
        }
        else if (existing.Error?.Code == FileSystemErrorCode.NotFound)
        {
            Coordinator.SelectSave(Presentation.Id, destination);
        }
        else
        {
            _error = L["FileDialog.InspectFailed", existing.Error?.Code.ToString() ?? string.Empty];
        }
    }

    private void ConfirmOverwrite()
    {
        if (_confirmPath is VirtualPath path)
        {
            Coordinator.SelectSave(Presentation.Id, path);
        }
    }

    private void RejectOverwrite() => _confirmPath = null;

    // Double-click/Enter on an existing file takes its name; Save then asks before replacing it.
    private void UseExistingName(VirtualPath path)
    {
        _fileName = path.Value[(path.Value.LastIndexOf('/') + 1)..];
        _error = null;
        _confirmPath = null;
    }
    private void Cancel() => Coordinator.Cancel(Presentation.Id);
    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            Cancel();
        }
    }

    private static VirtualPath Combine(VirtualPath directory, string name) =>
        VirtualPath.Parse(directory.Value == "/" ? $"/{name}" : $"{directory.Value}/{name}");
}