@namespace Kazo.Os.Samples.BlazorSite.Pages
@page "/"
@inherits KazoComponentBase
@*
    The home page: a counter kept in the site's state (cascaded by the layout), so it keeps its
    value while the user navigates within the site (no reload) and loses it on Reload (a new
    renderer process).
*@
<KazoPageTitle Title="Home - Blazor Sample Site" />
<h1>Welcome</h1>
<p>This page is a Blazor component, drawn in the browser's page area by a renderer process of the site.</p>
<p class="counter">
    <button id="counter-button" class="site-button" @onclick="Increment">Click me</button>
    <span>Clicked <strong id="counter-value">@(State?.Clicks ?? 0)</strong> time(s)</span>
</p>
<p>Address: <code id="current-address">@Site?.Navigation.Uri</code></p>
<p><a id="link-hello" href="/hello/World">Say hello to the World</a></p>

@code {
    [CascadingParameter]
    private KazoWebSite? Site { get; set; }

    [CascadingParameter]
    private SiteState? State { get; set; }

    private void Increment()
    {
        if (State is not null)
        {
            State.Clicks++;
        }
    }
}
