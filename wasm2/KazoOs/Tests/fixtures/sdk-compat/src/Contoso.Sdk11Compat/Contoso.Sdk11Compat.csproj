<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    ADR 0114, ADR 0132 §1: a third-party app compiled once against the Kazo OS 1.1.0 packages, which
    uses what SDK 1.1 added (window title, password rule of HackUserAccounts). Its package, kept in
    ../../packages, is loaded by the current OS in the compatibility tests; it is never rebuilt
    against a newer SDK.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTrimmable>true</IsTrimmable>
    <IsPackable>true</IsPackable>
    <PackageId>Contoso.Sdk11Compat</PackageId>
    <Version>$(HackerOsVersion)</Version>
    <Authors>Contoso</Authors>
    <Description>Kazo OS SDK compatibility fixture: a window app and a command compiled against SDK $(HackerOsVersion), using the SDK 1.1 additions.</Description>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="HackerOsSdkCompiledAgainst" Value="$(HackerOsVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.13" />
    <PackageReference Include="Kazo.Os.AppSdk" Version="$(HackerOsVersion)" />
    <PackageReference Include="Kazo.Os.AppSdk.Blazor" Version="$(HackerOsVersion)" />
    <PackageReference Include="Kazo.Os.App.Build" Version="$(HackerOsVersion)" PrivateAssets="all" />
  </ItemGroup>

</Project>
