{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HackerOs": {
    "ResourceAccounting": {
      "Cpu": { "Enabled": true, "UnresponsiveThresholdMs": 5000 },
      "Memory": { "Enabled": true }
    },
    "ResourceLimits": { "Enabled": true },
    "CrossOriginIsolation": "auto"
  }
}
