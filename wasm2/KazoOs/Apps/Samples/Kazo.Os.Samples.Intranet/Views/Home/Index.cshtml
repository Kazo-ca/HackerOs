@model HomeViewModel
@{ ViewData.Title = "Home"; }
<section class="hero">
    <p class="prompt">$ finger @(Model.DisplayName ?? "guest")@@intranet.hack</p>
    <h1 id="welcome">@(Model.DisplayName is null ? "Welcome, stranger" : $"Welcome back, {Model.DisplayName}")</h1>
    <p>
        This intranet is an ASP.Hack site: a process of Kazo OS that listens on <code>intranet.hack:80</code>,
        started by the OS on the first request. Its pages are MVC views, its data comes from a REST API and
        its task board is a Blazor site drawn by the browser.
    </p>
    @if (Model.DisplayName is null)
    {
        <p>@Html.ActionLink("Choose a display name", "Profile", "Home", htmlAttributes: KazoRoute.Values(new { @class = "button", id = "choose-name" }))</p>
    }
</section>

<section class="stats" aria-label="Counters">
    <div class="stat">
        <span class="stat-value" id="note-count">@Model.NoteCount</span>
        <span class="stat-label">@Html.ActionLink("notes", "Index", "Notes")</span>
    </div>
    <div class="stat">
        <span class="stat-value" id="task-count">@Model.TaskCount</span>
        <span class="stat-label"><a href="/board">cards on the board</a></span>
    </div>
    <div class="stat">
        <span class="stat-value" id="site-health" data-health-url="@Url.Content("~/health")">…</span>
        <span class="stat-label">site process (<code>/health</code>)</span>
    </div>
</section>

<section class="news">
    <h2>Announcements</h2>
    @foreach (Announcement item in Model.News)
    {
        <article class="news-item news-@item.Severity">
            <header>
                <span class="badge">@item.Severity</span>
                <h3>@item.Title</h3>
                <time datetime="@item.PostedOn.ToString("yyyy-MM-dd")">@item.PostedOn.ToString("MMM d")</time>
            </header>
            <p>@item.Text</p>
        </article>
    }
</section>

@section Scripts {
    <script src="@Url.Content("~/js/health.js")"></script>
}
