@using Kazo.Os.Taskbar.Blazor
@using Kazo.Os.Windowing.Core
@using Kazo.Os.Windowing.Abstractions

<section class="taskbar-browser-scenario" data-status="ready">
    <nav class="scenario-controls" aria-label="Taskbar test controls">
        <button type="button" @onclick="AddWindow">Add window</button>
        <button type="button" @onclick="RemoveLastWindow">Remove last window</button>
        <button type="button" @onclick="ToggleClockPanel">Toggle clock panel</button>
        <button type="button" @onclick="TickClock">Tick clock</button>
        <button type="button" @onclick="ToggleWindowSourcePresence">Toggle window source</button>
        <button type="button" @onclick="ToggleLauncherPresence">Toggle launcher</button>
        <button type="button" @onclick="ToggleStatusSourcePresence">Toggle status source</button>
        <button type="button" @onclick="ToggleClockPanelSourcePresence">Toggle clock panel source</button>
        <button type="button" @onclick="ToggleSessionCommandsPresence">Toggle session commands</button>
    </nav>
    <output role="status" data-scenario-log="@_log">@_log</output>

    <div class="scenario-spacer"></div>

    <Taskbar WindowSource="@(_windowSourcePresent ? _windowSource : null)"
             Commands="_commands"
             Launcher="@(_launcherPresent ? _launcher : null)"
             StatusSource="@(_statusSourcePresent ? _statusSource : null)"
             ClockPanelSource="@(_clockPanelSourcePresent ? _clockPanelSource : null)"
             ClockPanelContent="@ClockPanelFragment"
             SessionCommands="@(_sessionCommandsPresent ? _sessionCommands : null)" />
</section>

@code {
    private readonly FakeWindowSource _windowSource = new();
    private readonly FakeLauncher _launcher = new();
    private readonly FakeStatusSource _statusSource = new();
    private readonly FakeClockPanelSource _clockPanelSource = new();
    private FakeCommands _commands = null!;
    private FakeSessionCommands _sessionCommands = null!;

    private static readonly RenderFragment ClockPanelFragment = builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "data-scenario-clock-panel", "ready");
        builder.AddContent(2, "Clock panel content owned by the scenario host, not the taskbar.");
        builder.CloseElement();
    };

    private bool _windowSourcePresent = true;
    private bool _launcherPresent = true;
    private bool _statusSourcePresent = true;
    private bool _clockPanelSourcePresent = true;
    private bool _sessionCommandsPresent = true;
    private string _log = "Idle";

    protected override void OnInitialized()
    {
        _commands = new FakeCommands(_windowSource, () => Log("Command dispatched"));
        _sessionCommands = new FakeSessionCommands(() => Log("Logout requested"));

        AddWindow();
        AddWindow();
    }

    private void Log(string message)
    {
        _log = message;
        StateHasChanged();
    }

    private int _nextWindowSeed = 1;

    private void AddWindow()
    {
        int seed = _nextWindowSeed++;
        _windowSource.Add(new TaskbarWindowItem(
            WindowId.FromGuid(Guid.Parse($"60000000-0000-0000-0000-{seed:D12}")),
            $"Scenario Window {seed}",
            IconAssetPath: null,
            IsFocused: seed == 1,
            IsMinimized: false));
        Log($"Added window {seed}");
    }

    private void RemoveLastWindow()
    {
        if (_windowSource.RemoveLast() is { } removed)
        {
            Log($"Removed {removed.Title}");
        }
    }

    private void ToggleClockPanel()
    {
        _clockPanelSource.Toggle();
        Log($"Clock panel open: {_clockPanelSource.IsOpen}");
    }

    private void TickClock()
    {
        _statusSource.UtcNow = _statusSource.UtcNow.AddSeconds(1);
        _statusSource.RaiseChanged();
        Log($"Clock ticked to {_statusSource.UtcNow:HH:mm:ss}");
    }

    private void ToggleWindowSourcePresence() { _windowSourcePresent = !_windowSourcePresent; Log($"Window source present: {_windowSourcePresent}"); }
    private void ToggleLauncherPresence() { _launcherPresent = !_launcherPresent; Log($"Launcher present: {_launcherPresent}"); }
    private void ToggleStatusSourcePresence() { _statusSourcePresent = !_statusSourcePresent; Log($"Status source present: {_statusSourcePresent}"); }
    private void ToggleClockPanelSourcePresence() { _clockPanelSourcePresent = !_clockPanelSourcePresent; Log($"Clock panel source present: {_clockPanelSourcePresent}"); }
    private void ToggleSessionCommandsPresence() { _sessionCommandsPresent = !_sessionCommandsPresent; Log($"Session commands present: {_sessionCommandsPresent}"); }

    private sealed class FakeWindowSource : ITaskbarWindowSource
    {
        private readonly List<TaskbarWindowItem> _items = [];

        public IReadOnlyList<TaskbarWindowItem> Windows => _items;

        public event Action? Changed;

        public void Add(TaskbarWindowItem item)
        {
            _items.Add(item);
            Changed?.Invoke();
        }

        public TaskbarWindowItem? RemoveLast()
        {
            if (_items.Count == 0)
            {
                return null;
            }

            TaskbarWindowItem removed = _items[^1];
            _items.RemoveAt(_items.Count - 1);
            Changed?.Invoke();
            return removed;
        }

        public void ReplaceAll(Func<TaskbarWindowItem, TaskbarWindowItem> transform)
        {
            for (int i = 0; i < _items.Count; i++)
            {
                _items[i] = transform(_items[i]);
            }

            Changed?.Invoke();
        }

        public void ReplaceOne(WindowId id, Func<TaskbarWindowItem, TaskbarWindowItem> transform)
        {
            int index = _items.FindIndex(item => item.Id == id);
            if (index >= 0)
            {
                _items[index] = transform(_items[index]);
                Changed?.Invoke();
            }
        }
    }

    private sealed class FakeCommands(FakeWindowSource windows, Action onDispatched) : ITaskbarCommandDispatcher
    {
        public void Activate(WindowId id)
        {
            windows.ReplaceAll(item => item with { IsFocused = item.Id == id, IsMinimized = item.Id == id ? false : item.IsMinimized });
            onDispatched();
        }

        public void Minimize(WindowId id)
        {
            windows.ReplaceOne(id, item => item with { IsFocused = false, IsMinimized = true });
            onDispatched();
        }

        public void Restore(WindowId id)
        {
            windows.ReplaceOne(id, item => item with { IsMinimized = false });
            onDispatched();
        }

        public void Close(WindowId id) => onDispatched();
    }

    private sealed class FakeLauncher : ITaskbarLauncher
    {
        public bool IsOpen { get; private set; }

        public event Action? Changed;

        public void Toggle()
        {
            IsOpen = !IsOpen;
            Changed?.Invoke();
        }
    }

    private sealed class FakeStatusSource : ITaskbarStatusSource
    {
        public DateTimeOffset UtcNow { get; set; } = new(2026, 8, 13, 9, 0, 0, TimeSpan.Zero);

        public event Action? Changed;

        public void RaiseChanged() => Changed?.Invoke();
    }

    private sealed class FakeClockPanelSource : ITaskbarClockPanelSource
    {
        public bool IsOpen { get; private set; }

        public event Action? Changed;

        public void Toggle()
        {
            IsOpen = !IsOpen;
            Changed?.Invoke();
        }
    }

    private sealed class FakeSessionCommands(Action onLogout) : ITaskbarSessionCommands
    {
        public void RequestLogout() => onLogout();
    }
}
