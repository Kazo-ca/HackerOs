@inherits WindowAppBase

<div class="compat-window">
    <header class="compat-header">@WindowTitle</header>
    <main class="compat-body">
        <p>Compiled against SDK <strong>@CompatInfo.CompiledAgainst</strong>, running on SDK <strong>@HackerOsSdk.Version</strong>.</p>
        <p>Signed in as <strong>@AppContext.UserId</strong>.</p>
        <button class="compat-button" @onclick="SaveAsync">Save note</button>
        <p class="compat-status">@_status</p>
    </main>
</div>

@code {
    private string _status = "Nothing saved";

    // SDK 1.1 (ADR 0117): the window names itself before it is first shown.
    protected override async Task OnAppInitializedAsync() =>
        await SetWindowTitleAsync(FormatWindowTitle("note.txt"));

    // Writes then reads back a file of the home folder, and marks the document saved in the title.
    private async Task SaveAsync()
    {
        await HackerOs.AppSdk.IO.HackFile.WriteAllTextAsync("~/sdk11-window.txt", "saved by SDK 1.1");
        _status = "Read back: " + await HackerOs.AppSdk.IO.HackFile.ReadAllTextAsync("~/sdk11-window.txt");
        await SetWindowTitleAsync(FormatWindowTitle("sdk11-window.txt"));
    }
}
