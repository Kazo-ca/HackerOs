<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    ADR 0228: a third-party app compiled once against the Kazo OS 3.0.0 packages (Kazo.Os.*), the
    first SDK after the rename of HackerOS. It uses the SDK 2.0 additions under their new names (the
    file control contract KazoFileView, a file menu entry registered with [RegisterFileContextMenu],
    KazoFileOperations). Its package, kept in
    ../../packages, is loaded by the current OS in the compatibility tests; it is never rebuilt
    against a newer SDK.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTrimmable>true</IsTrimmable>
    <IsPackable>true</IsPackable>
    <PackageId>Contoso.Sdk3Compat</PackageId>
    <Version>$(KazoOsVersion)</Version>
    <Authors>Contoso</Authors>
    <Description>Kazo OS SDK compatibility fixture: a window app and a command compiled against SDK $(KazoOsVersion), using the SDK 3.0 additions.</Description>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="KazoOsSdkCompiledAgainst" Value="$(KazoOsVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.13" />
    <PackageReference Include="Kazo.Os.AppSdk" Version="$(KazoOsVersion)" />
    <PackageReference Include="Kazo.Os.AppSdk.Blazor" Version="$(KazoOsVersion)" />
    <PackageReference Include="Kazo.Os.App.Build" Version="$(KazoOsVersion)" PrivateAssets="all" />
  </ItemGroup>

</Project>
