@namespace Kazo.Os.Platform.Blazor.Dialogs
@using Kazo.Os.App.Abstractions
@using Kazo.Os.AppSdk
@using Kazo.Os.AppSdk.Blazor.ContextMenus
@using Kazo.Os.AppSdk.Blazor.Files
@using Kazo.Os.AppSdk.Files
@using Kazo.Os.Simulation.Abstractions.FileSystem
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@inject IStringLocalizer<Strings> L
@implements IDisposable

@*
    The file view of the Open / Save / Choose folder dialogs (ADR 0157): the OS file control
    (kazoos.file-view) shown with the requesting app's rights, under a breadcrumb the dialog owns.
    Without a provider of the contract (no File Explorer, a test host), the platform's own
    VirtualFolderBrowser takes its place, so the dialogs always work.
*@
<div class="file-dialog-browser">
    @if (Context is null)
    {
        <div class="file-dialog-view">@Fallback</div>
    }
    else
    {
        @if (_controller is not null)
        {
            <nav class="file-dialog-toolbar" aria-label="@L["FolderBrowser.CurrentFolder"]">
                <button type="button"
                        class="toolbar-button"
                        title="@L["FileDialog.Up"]"
                        aria-label="@L["FileDialog.Up"]"
                        disabled="@(_currentDirectory.Value == "/")"
                        @onclick="NavigateUpAsync">
                    <MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" />
                </button>
                <div class="breadcrumbs">
                    @foreach (FileDialogBreadcrumb breadcrumb in FileDialogBreadcrumb.For(_currentDirectory))
                    {
                        <button type="button"
                                class="breadcrumb"
                                disabled="@(breadcrumb.Path == _currentDirectory)"
                                @onclick="() => NavigateAsync(breadcrumb.Path)">@breadcrumb.Label</button>
                    }
                </div>
                @if (CanCreateFolder)
                {
                    @* The control's own "New folder" (ADR 0175): a folder named "New folder", in rename. *@
                    <button type="button"
                            class="toolbar-button new-folder"
                            title="@L["FileDialog.NewFolder"]"
                            aria-label="@L["FileDialog.NewFolder"]"
                            disabled="@(!_controller.CanExecute(KazoFileMenuItems.NewFolder))"
                            @onclick="CreateFolderAsync">
                        <MudIcon Icon="@Icons.Material.Filled.CreateNewFolder" Size="Size.Small" />
                        <span class="toolbar-label">@L["FileDialog.NewFolder"]</span>
                    </button>
                }
                <div class="view-modes" role="group" aria-label="@L["FileDialog.View"]">
                    <button type="button"
                            class="toolbar-button"
                            title="@L["FileDialog.ViewDetails"]"
                            aria-label="@L["FileDialog.ViewDetails"]"
                            aria-pressed="@(_mode == KazoFileViewMode.Details ? "true" : "false")"
                            @onclick="() => SetMode(KazoFileViewMode.Details)">
                        <MudIcon Icon="@Icons.Material.Filled.ViewList" Size="Size.Small" />
                    </button>
                    <button type="button"
                            class="toolbar-button"
                            title="@L["FileDialog.ViewIcons"]"
                            aria-label="@L["FileDialog.ViewIcons"]"
                            aria-pressed="@(_mode == KazoFileViewMode.Icons ? "true" : "false")"
                            @onclick="() => SetMode(KazoFileViewMode.Icons)">
                        <MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Small" />
                    </button>
                </div>
            </nav>
        }

        @if (_error is not null)
        {
            <div class="browser-error" role="alert">
                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small" />
                <span>@_error</span>
            </div>
        }

        <div class="file-dialog-view">
            <CascadingValue TValue="IAppExecutionContext" Value="Context" IsFixed="true">
                @if (_menus is not null)
                {
                    <CascadingValue TValue="IKazoMenuHost" Value="_menus" IsFixed="true">
                        @FileView
                    </CascadingValue>
                }
                else
                {
                    @FileView
                }
            </CascadingValue>
        </div>
    }
</div>

@code {
    /// <summary>The OS file control, with the platform's browser in its place when no app provides it.</summary>
    private RenderFragment FileView => @<KazoFileView InitialDirectory="@InitialDirectory.Value"
                                                       Mode="_mode"
                                                       ModeChanged="_modeChanged"
                                                       Features="Features"
                                                       AllowMultiSelect="AllowMultipleSelection"
                                                       OpenOnTap="_openOnTap"
                                                       Filter="_filter"
                                                       Opening="_opening"
                                                       Navigated="_navigated"
                                                       SelectionChanged="_selectionChanged"
                                                       ErrorOccurred="_errorOccurred"
                                                       ControllerChanged="_controllerChanged">
        <Unavailable Context="reason">@Fallback</Unavailable>
    </KazoFileView>;

    /// <summary>The platform's own browser: the dialogs' view when the contract has no provider.</summary>
    private RenderFragment Fallback => @<VirtualFolderBrowser @ref="_fallback"
                                                              FileSystem="FileSystem"
                                                              InitialDirectory="InitialDirectory"
                                                              AllowFileSelection="AllowFileSelection"
                                                              AllowDirectorySelection="AllowDirectorySelection"
                                                              AllowMultipleSelection="AllowMultipleSelection"
                                                              FileFilter="_fallbackFilter"
                                                              DirectoryChanged="_fallbackDirectoryChanged"
                                                              SelectionChanged="SelectionChanged"
                                                              FileActivated="_fallbackFileActivated" />;
}
