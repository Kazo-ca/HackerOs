@namespace HackerOs.Apps.FileExplorer.FileControl.Icons
@inherits HackerOs.AppSdk.Blazor.HackComponentBase

@*
    Renders one ShellIconDescriptor regardless of its Kind, so callers never branch on icon kind
    themselves. Skeleton for FV-007 — see doc/wasm/dev/old/Global-FileView-And-MessagingSystem/FileViewControl.md.
*@
<span class="shell-icon" data-kind="@Icon?.Kind">
    @if (Icon is { Kind: ShellIconKind.Vector, LibraryOrPath: not null, Name: not null } vectorIcon
        && Enum.TryParse<IconLibrary>(vectorIcon.LibraryOrPath, out IconLibrary library))
    {
        <HackerIcon Library="library" Name="@vectorIcon.Name" Size="Size" />
    }
    else if (Icon is { Kind: ShellIconKind.Png, LibraryOrPath: not null })
    {
        <img class="shell-icon-raster" src="@Icon.LibraryOrPath" alt="" width="@Size" height="@Size" />
    }
</span>

@code {
    /// <summary>The icon to render.</summary>
    [Parameter] public ShellIconDescriptor? Icon { get; set; }

    /// <summary>The rendered width/height in pixels. Defaults to 20, matching <c>HackerIcon</c>.</summary>
    [Parameter] public int Size { get; set; } = 20;
}
