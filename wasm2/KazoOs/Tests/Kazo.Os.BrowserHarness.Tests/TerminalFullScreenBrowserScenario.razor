@using Kazo.Os.AppSdk
@using Kazo.Os.AppSdk.Terminal
@implements IAsyncDisposable

<section class="terminal-harness" aria-label="Terminal full-screen browser harness">
    @if (_active)
    {
        <TerminalScreen @ref="_screen" Frame="_frame" OnKey="PostKeyAsync" />
    }
    <output id="terminal-full-screen-result" data-status="@_status">@_text</output>
</section>

@code {
    private readonly CancellationTokenSource _cancellation = new();
    private TerminalFullScreenSession? _session;
    private TerminalScreen? _screen;
    private TerminalScreenFrame? _frame;
    private Task? _commandTask;
    private string _text = string.Empty;
    private string _status = "starting";
    private bool _active;

    /// <inheritdoc />
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _session = new TerminalFullScreenSession(ApplyScreenStateAsync);
            _commandTask = RunCommandAsync(_session, _cancellation.Token);
        }
        else if (_active && _screen is not null)
        {
            _ = _screen.FocusAsync();
        }

        return Task.CompletedTask;
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _cancellation.Cancel();
        if (_commandTask is not null)
        {
            try
            {
                await _commandTask;
            }
            catch (OperationCanceledException)
            {
            }
        }
        if (_session is not null)
            await _session.DisposeAsync();
        _cancellation.Dispose();
    }

    private Task PostKeyAsync(TerminalKeyEvent keyEvent)
    {
        _session?.TryPostKey(keyEvent);
        return Task.CompletedTask;
    }

    private Task ApplyScreenStateAsync(TerminalScreenFrame? frame, bool active) =>
        InvokeAsync(() =>
        {
            _frame = frame;
            _active = active;
            StateHasChanged();
        });

    private async Task RunCommandAsync(
        IFullScreenTerminalSession screen, CancellationToken cancellationToken)
    {
        await screen.EnterAlternateScreenAsync(cancellationToken);
        _status = "editing";
        try
        {
            while (true)
            {
                await screen.RenderAsync(new TerminalScreenFrame(
                    ["Kazo OS full-screen terminal", _text, "Ctrl+X Exit"],
                    new TerminalCursor(_text.Length, 1),
                    "Interactive terminal editor test"), cancellationToken);
                TerminalKeyEvent key = await screen.ReadKeyAsync(cancellationToken);
                if (key.Control && string.Equals(key.Text, "x", StringComparison.OrdinalIgnoreCase))
                    break;
                if (key.Key is TerminalKey.Backspace && _text.Length > 0)
                    _text = _text[..^1];
                else if (key.Key is TerminalKey.Character && !key.Control && key.Text is not null)
                    _text += key.Text;
            }
        }
        finally
        {
            await screen.LeaveAlternateScreenAsync(CancellationToken.None);
        }

        await InvokeAsync(() =>
        {
            _status = "exited";
            StateHasChanged();
        });
    }
}
