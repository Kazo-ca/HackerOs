@inherits Kazo.Os.AppSdk.Blazor.KazoComponentBase
@using Kazo.Os.AppSdk.Icons
@implements IDisposable

@*
    Quick open (Ctrl+P), VS Code's "Go to File...": a box at the top of the editor area that
    ranks the open folder's files as you type; Enter or a click opens the file, Escape closes.
*@
@if (_open)
{
    <div class="quick-open-backdrop" @onclick="CloseAsync"></div>
    <div class="quick-open" role="dialog" aria-label="@L["QuickOpen.Label"]">
        <input @ref="_input"
               id="code-quick-open-input"
               class="quick-open-input"
               type="text"
               placeholder="@L["QuickOpen.Placeholder"]"
               aria-label="@L["QuickOpen.Placeholder"]"
               aria-controls="code-quick-open-list"
               spellcheck="false"
               autocomplete="off"
               value="@_text"
               @oninput="OnInput"
               @onkeydown="OnKeyDownAsync"
               @onkeyup="OnKeyUpAsync" />
        <ul class="quick-open-list" id="code-quick-open-list" role="listbox" aria-label="@L["QuickOpen.Files"]">
            @if (_loading)
            {
                <li class="quick-open-note">@L["QuickOpen.Listing"]</li>
            }
            else if (_matches.Count == 0)
            {
                <li class="quick-open-note">@L["QuickOpen.NoMatch"]</li>
            }
            else
            {
                @for (int i = 0; i < _matches.Count; i++)
                {
                    CodeEditorWorkspaceFile file = _matches[i];
                    int index = i;
                    <li class="quick-open-item @(index == _selected ? "is-selected" : null)"
                        role="option"
                        aria-selected="@(index == _selected ? "true" : "false")"
                        @onmouseenter="() => _selected = index"
                        @onclick="() => PickAsync(file)">
                        <KazoIcon Library="IconLibrary.Lucide" Name="file-code" Size="15" />
                        <span class="item-name">@file.Name</span>
                        <span class="item-directory">@file.Directory</span>
                    </li>
                }
            }
        </ul>
    </div>
}
