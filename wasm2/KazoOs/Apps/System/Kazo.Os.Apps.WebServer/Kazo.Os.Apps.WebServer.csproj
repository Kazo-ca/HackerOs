<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="../../../Platform/Packaging.props" />

  <PropertyGroup>
    <PackageId>Kazo.Os.Apps.WebServer</PackageId>
    <Description>The base Kazo OS kazowebd web server and Web Server Manager app, to include in an OS host (ProjectReference or PackageReference, optionally IsSystemApp).</Description>
    <PackageTags>kazoos;app</PackageTags>
  </PropertyGroup>

  <!--
    ADR 0077 / ADR 0080: the hosted static sites. Two apps in one assembly, like nginx and its
    control tools in one package: the kazowebd service (KazoWebdApp) and the Web Server Manager window
    (WebServerManagerApp). Being in the same assembly makes kazowebd a companion service of the
    Manager, which may start and stop it without services.manage (IAppServiceControlGateway rule).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\Kazo.Os.App.Abstractions\Kazo.Os.App.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\Shared\Kazo.Os.AppSdk\Kazo.Os.AppSdk.csproj" />
    <ProjectReference Include="..\..\..\Shared\Kazo.Os.AppSdk.Blazor\Kazo.Os.AppSdk.Blazor.csproj" />
    <ProjectReference Include="..\..\..\Shared\Kazo.Os.Simulation.Abstractions\Kazo.Os.Simulation.Abstractions.csproj" />
  </ItemGroup>

</Project>
