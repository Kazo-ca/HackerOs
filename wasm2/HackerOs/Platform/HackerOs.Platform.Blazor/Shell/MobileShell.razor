@using HackerOs.MobileShell.Blazor
@using HackerOs.Platform.Blazor.Security
@using HackerOs.Platform.Blazor.Windows
@using HackerOs.Platform.Core.Discovery
@using HackerOs.Platform.Core.Lifecycle
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject WindowRuntime WindowRuntime
@* ADR 0171 §3: the session's file and basic dialogs become windows here too (only the desktop created the adapter). *@
@inject HackerOs.Platform.Blazor.Dialogs.FileDialogWindowAdapter FileDialogAdapter
@inject AppLifecycleOrchestrator Orchestrator
@inject WindowCloseCoordinator CloseCoordinator
@inject WindowCloseGuardRegistry CloseGuards
@inject AppBackHandlerRegistry BackHandlers
@inject WindowAppEventDispatcher WindowEvents
@inject AppWindowGatewayFactory WindowGateways
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<Strings> L
@inject IServiceProvider Services

<div class="mobile-shell" @ref="_shellRoot">
    <div class="mobile-shell-workspace">
        <div class="mobile-home-layer" hidden="@HasActiveMobileWindow">
            <MobileHomeScreen IsDrawerOpen="_isDrawerOpen" OnDrawerChanged="SetDrawerAsync" OnAppSelected="LaunchMobileAppAsync" />
        </div>
        <div class="mobile-app-layer" hidden="@(!HasActiveMobileWindow)">
        <SingleSurfaceArea Windows="WindowRuntime.Windows"
                           OnFocus="HandleFocus"
                           OnGesture="HandleGesture"
                           WindowOverlay="UnresponsiveWindowOverlay.ForWindow">
            <WindowContent Context="window">
                @if (window.Content is not null)
                {
                    @window.Content
                }
                else if (Orchestrator.TryGetRunningInstance(AppInstanceId.FromGuid(window.OwnerInstanceId.Value), out AppDescriptor? descriptor, out IAppExecutionContext? context))
                {
                    <WindowAppRenderer Window="window"
                                       Descriptor="descriptor"
                                       AppContext="context"
                                       CloseGuards="CloseGuards"
                                       BackHandlers="BackHandlers"
                                       WindowEvents="WindowEvents"
                                       WindowGateways="WindowGateways" />
                }
                else
                {
                    <div class="window-content-placeholder">@window.Title</div>
                }
            </WindowContent>
        </SingleSurfaceArea>
        </div>
        @if (_mobileLaunchError is not null) { <p class="mobile-launch-error" role="alert">@_mobileLaunchError</p> }
        @* ADR 0127 §2: samples which windows stop answering their inputs. *@
        <WindowResponsivenessHost />
        <button type="button"
                class="mobile-shade-handle"
                data-shell-gesture="shade"
                aria-label="@ShadeName"
                title="@ShadeName"
                aria-expanded="@(_isShadeOpen ? "true" : "false")"
                @onclick="ToggleShade">
            <span class="mobile-shade-grabber" aria-hidden="true"></span>
            @if (UnreadNotifications > 0)
            {
                <span class="mobile-shade-attention" aria-hidden="true"></span>
            }
        </button>
    </div>

    @if (_isShadeOpen)
    {
        <div class="mobile-shade-backdrop" @onclick="CloseShade">
            <div class="mobile-shade-panel" @onclick:stopPropagation="true">
                <ClockPanel OnClose="CloseShade" />
            </div>
        </div>
    }

    @if (_showRecent)
    {
        <MobileRecentSurface Items="MobileRecentProjection.BuildItems(WindowRuntime.Windows)"
                              OnActivate="ActivateRecent"
                              OnClose="CloseRecentItem"
                              OnDismiss="CloseRecent" />
    }

    <MobileSystemNavigationBar Commands="_systemNavigationCommands" />

    @* ADR 0049: secure-desktop approval, above every app screen and the navigation bar. *@
    @* ADR 0101: synchronization conflicts and the session's periodic sync. *@
    @* ADR 0150 §6: the OS context menu, as a sheet at the bottom (long press). *@
    <HackerOs.Platform.Blazor.ContextMenus.ContextMenuOverlay Presentation="HackerOs.Platform.Blazor.ContextMenus.ContextMenuPresentation.Sheet" />

    <HackerOs.Platform.Blazor.Sync.SyncConflictOverlay />
    <DangerousCapabilityApprovalOverlay />
    <AdministratorAuthenticationOverlay />
</div>

@code {
    /// <summary>
    /// Mobile counterpart to <see cref="DesktopShell"/> (<c>MOB-008</c>/<c>MOB-009</c>/<c>MOB-010</c>):
    /// a single full-screen surface, the Android-inspired system navigation bar, and a swipe-down
    /// notification shade reusing <see cref="ClockPanel"/> (notifications, calendar, and the
    /// Auto/Desktop/Mobile toggle) — Mobile's equivalent of the Desktop taskbar clock, since Mobile
    /// has no taskbar to anchor it to. Reachable from the running app via <c>App.razor</c> once
    /// <c>UiPlatformPreferenceService.Current.ActivePlatform</c> is Mobile.
    /// </summary>
    private MobileNavigationCommandsAdapter _navigationCommands = null!;
    private MobileNavigationHistory _navigationHistory = null!;
    private TaskbarCommandDispatcherAdapter _windowCommands = null!;
    private IJSObjectReference? _module;
    private DotNetObjectReference<MobileShell>? _selfReference;
    private bool _isShadeOpen;
    private bool _showRecent;
    private NotificationAttention? _notificationAttention;

    /// <summary>Gets the notifications not looked at yet: the dot on the shade handle (ADR 0196).</summary>
    private int UnreadNotifications => _notificationAttention?.UnreadCount ?? 0;

    /// <summary>Gets the shade handle's name and tooltip, which give the unread count (ADR 0196).</summary>
    private string ShadeName => UnreadNotifications switch
    {
        0 => L["Mobile.Shade"],
        1 => L["Mobile.ShadeWithOneUnread"],
        int count => L["Mobile.ShadeWithUnread", count],
    };

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        WindowRuntime.StateChanged += Rerender;
        FileDialogAdapter.Changed += Rerender;
        _navigationHistory = new MobileNavigationHistory(WindowRuntime);
        _windowCommands = new TaskbarCommandDispatcherAdapter(WindowRuntime, CloseCoordinator, CloseGuards);
        _navigationCommands = new MobileNavigationCommandsAdapter(
            WindowRuntime,
            BackHandlers,
            _navigationHistory,
            id => CloseCoordinator.CloseAsync(id, cancellationToken => CloseGuards.ConfirmCloseAsync(id, cancellationToken)),
            () => _isShadeOpen || _showRecent || _isDrawerOpen,
            CloseOverlays,
            ToggleRecent);
        InitializeMobileHome();
        // ADR 0196: the shade handle's dot counts the notifications not looked at yet; opening the shade reads them.
        if (Services.GetService(typeof(INotificationQueue)) is INotificationQueue notifications
            && Services.GetService(typeof(ISimulationClock)) is ISimulationClock clock)
        {
            ISessionService? sessions = Services.GetService(typeof(ISessionService)) as ISessionService;
            _notificationAttention = new NotificationAttention(notifications, () => sessions?.CurrentPrincipal?.UserId, clock);
            _notificationAttention.Changed += Rerender;
        }

        // ADR 0186 §4.5: the sign-in notification of unseen changes.
        _ = PostWhatsNewAsync();
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // ADR 0196: the shade lists the notifications, so they are read while it is open.
        if (_notificationAttention is not null && _notificationAttention.IsViewing != _isShadeOpen)
        {
            _notificationAttention.IsViewing = _isShadeOpen;
        }

        if (!firstRender)
        {
            return;
        }

        _module = await JSRuntime.InvokeAsync<IJSObjectReference>(
            "import",
            "./_content/HackerOs.Platform.Blazor/mobileGestures.js");
        // Shared browser gesture plumbing serves the shade, navigation and Home components.
        _selfReference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("attachMobileGestures", _shellRoot, _selfReference,
            "data-shell-gesture", nameof(ReportShellGestureAsync));
        await _module.InvokeVoidAsync("observeMobileWorkspace", _shellRoot, _selfReference);
    }

    /// <summary>Posts the sign-in notification of unseen changes, then shows its dot at once.</summary>
    private async Task PostWhatsNewAsync()
    {
        await WhatsNewSignInNotice.PostAsync(Services);
        _notificationAttention?.Refresh();
    }

    /// <summary>Invoked from JS when a downward swipe past the open threshold is detected on the handle.</summary>
    [JSInvokable]
    public void OnSwipeDownDetected() => OpenShade();

    private void ToggleShade()
    {
        if (_isShadeOpen)
        {
            CloseShade();
        }
        else
        {
            OpenShade();
        }
    }

    private void OpenShade()
    {
        _isDrawerOpen = false;
        _showRecent = false;
        _isShadeOpen = true;
        StateHasChanged();
    }

    private void CloseShade()
    {
        _isShadeOpen = false;
        StateHasChanged();
    }

    private void ToggleRecent()
    {
        _showRecent = !_showRecent;
        StateHasChanged();
    }

    private void CloseRecent()
    {
        _showRecent = false;
        StateHasChanged();
    }

    /// <summary>Closes any shell-owned overlay, for <see cref="MobileNavigationCommandsAdapter"/>'s Back step 0.</summary>
    private void CloseOverlays()
    {
        _isDrawerOpen = false;
        _isShadeOpen = false;
        _showRecent = false;
        StateHasChanged();
    }

    private void ActivateRecent(WindowId id)
    {
        // Same restore-then-focus shape TaskbarWindowInteraction.HandleClick already uses for a
        // minimized item; Focus() throws if called on a still-minimized window.
        WindowRuntimeState? window = WindowRuntime.Windows.FirstOrDefault(w => w.Id == id);
        if (window is { VisualState: WindowVisualState.Minimized })
        {
            _windowCommands.Restore(id);
        }

        _windowCommands.Activate(id);
        CloseRecent();
    }

    private void CloseRecentItem(WindowId id) => _windowCommands.Close(id);

    private void Rerender() => InvokeAsync(StateHasChanged);

    private void HandleFocus(WindowId id) => WindowRuntime.Apply(new FocusWindowCommand(id));

    private void HandleGesture(WindowCommand command)
    {
        try
        {
            WindowRuntime.Apply(command);
        }
        catch (InvalidOperationException)
        {
            // Same defense-in-depth as DesktopShell.HandleGesture: a policy-issued command
            // (SingleSurfaceArea's own Minimize/Maximize) racing a just-closed window should not
            // raise an unhandled exception through the render loop.
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        WindowRuntime.StateChanged -= Rerender;
        FileDialogAdapter.Changed -= Rerender;
        _mobileProcessObserver?.Dispose();
        if (_notificationAttention is not null)
        {
            _notificationAttention.Changed -= Rerender;
            _notificationAttention.Dispose();
        }
        _navigationHistory.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("detachMobileGestures", _shellRoot);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _selfReference?.Dispose();
    }
}
