<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../Platform/Packaging.props" />

  <PropertyGroup>
    <PackageId>Kazo.Os.Server.Contracts</PackageId>
    <PackageTags>kazoos;server;contracts</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Shared contracts used by both server and browser client; no Blazor/UI dependency. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <RootNamespace>Kazo.Os.Server.Contracts</RootNamespace>
    <AssemblyName>Kazo.Os.Server.Contracts</AssemblyName>
    <Description>Shared API versioning, sync record envelope, and proxy request/response contracts for the optional Kazo OS server. Referenced by both the ASP.NET Core server and the browser client adapter.</Description>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>

  <!-- No reference to Kazo.Os.App.Abstractions or platform projects intentionally:
       this library must remain independently deployable on the server host. -->

</Project>
