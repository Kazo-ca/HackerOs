<Project>
  <!-- Debug profile: the Kazo OS packages become projects of the submodule (ADR 0176 §5, ADR 0207). -->
  <Import Project="$(KazoOsSourceRoot)build/Kazo.Os.ExternalSource.targets"
          Condition="'$(KazoOsUseSource)' == 'true' and Exists('$(KazoOsSourceRoot)build/Kazo.Os.ExternalSource.targets')" />

  <!-- ADR 0176 §3: the submodule is mandatory, it gives the Kazo OS version. -->
  <Target Name="_KazoOsRequireSubmodule"
          BeforeTargets="_GenerateRestoreProjectSpec;CollectPackageReferences;PrepareForBuild"
          Condition="!Exists('$(KazoOsSourceRoot)build/Versions.props')">
    <Error Code="KOSAPP0070"
           Text="The Kazo OS submodule is missing ($(KazoOsSourceRoot)build/Versions.props not found). Run: git submodule update --init" />
  </Target>
</Project>
