@using Kazo.Os.AppSdk.Icons
@using Kazo.Os.AppSdk.Apps

@*
    The icon the shell draws for an app (ADR 0232 §2): the icon pack's image of the app, else the app's
    declared image (ADR 0164), else the pack's image of its category, else the shared Lucide icon of
    its category (ADR 0160 §6).
*@
@if (ImageUrl is { } url)
{
    <img class="@(Fill ? "shell-app-icon-image is-fill" : "shell-app-icon-image")" src="@url" alt="" width="@Size" height="@Size" draggable="false" />
}
else
{
    <KazoIcon Library="IconLibrary.Lucide" Name="@KazoAppIcons.LucideName(App.Id, App.Presentation.Category)" Size="Size" Title="" />
}
