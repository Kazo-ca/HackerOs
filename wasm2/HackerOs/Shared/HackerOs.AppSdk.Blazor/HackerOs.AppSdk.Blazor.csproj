<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="../../Platform/Packaging.props" />

  <PropertyGroup>
    <PackageId>HackerOs.AppSdk.Blazor</PackageId>
    <Description>Kazo OS App SDK for window apps: HackComponentBase, window base classes, dialogs and Blazor helpers.</Description>
    <PackageTags>hackeros;app-sdk;blazor</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HackerOs.AppSdk\HackerOs.AppSdk.csproj" />
    <ProjectReference Include="..\HackerOs.AppSdk.Icons\HackerOs.AppSdk.Icons.csproj" />
    <ProjectReference Include="..\HackerOs.Simulation.Abstractions\HackerOs.Simulation.Abstractions.csproj" />
  </ItemGroup>

</Project>
