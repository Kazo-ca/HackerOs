@namespace Kazo.Os.Samples.BlazorSite.Layout
@inherits KazoSiteLayoutBase
@*
    The site's layout: a header with site links (KazoNavLink keeps the active one marked) and the
    page's body. Links are intercepted by the browser's page area: no reload. The layout lives as
    long as the renderer process, so the SiteState it cascades survives the pages.
*@
<CascadingValue TValue="SiteState" Value="_state" IsFixed="true">
<div class="site">
    <header class="site-header">
        <span class="site-brand">Blazor Sample Site</span>
        <nav class="site-nav" aria-label="Site">
            <KazoNavLink id="nav-home" href="/" Match="NavLinkMatch.All">Home</KazoNavLink>
            <KazoNavLink id="nav-hello" href="/hello/KazoOS">Hello</KazoNavLink>
            <KazoNavLink id="nav-crash" href="/crash">Crash</KazoNavLink>
            <a id="nav-external" href="https://hackersearch.net">Leave the site</a>
        </nav>
    </header>
    <main class="site-body">
        @Body
    </main>
    <footer class="site-footer">Drawn by the Kazo OS browser as a renderer process of this site.</footer>
</div>
</CascadingValue>
