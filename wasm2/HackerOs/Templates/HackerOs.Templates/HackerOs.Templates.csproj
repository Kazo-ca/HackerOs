<Project Sdk="Microsoft.NET.Sdk">

  <!--
    HackerOs.Templates (ADR 0098 §6): the dotnet new templates of HackerOS, packed locally by
    build/pack-local.sh with every other package:

      hackeros-window    window app (Blazor component over WindowAppBase)
      hackeros-command   terminal command (TerminalAppBase)
      hackeros-service   background service started at login (ServiceAppBase)
      hackeros-site      ASP.Hack site (WebAppDefinition)
      hackeros-host      Blazor WebAssembly host running HackerOs.Ecosystem.Host with the base apps
      hackeros-solution  a whole app repository (ADR 0176, ADR 0207): app, host, tests, HackerOS
                         submodule (sources in Debug, packages in Release), CI and the Hack Store
                         publishing workflow. Its projects take $(HackerOsVersion) from the submodule.

    Each template has .template.config/ide.host.json (icon, parameter labels) for Visual Studio and
    Rider (ADR 0176 §7).

    Each template project declares <HackerOsVersion>0.0.0-dev</HackerOsVersion>; packing stages
    content/ under obj/ and writes this repository's $(HackerOsVersion) there, so a generated
    project references exactly the packages packed with it. The content is never compiled here.
    Tests/HackerOs.Templates.E2E.Tests runs dotnet new and dotnet build for each one against the
    local feed.
  -->
  <Import Project="..\..\Platform\Packaging.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>HackerOs.Templates</PackageId>
    <PackageType>Template</PackageType>
    <Description>dotnet new templates for HackerOS: window app, terminal command, service, ASP.Hack site, host and app repository solution.</Description>
    <PackageTags>hackeros;dotnet-new;templates</PackageTags>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <!-- No assembly, so nothing for the public API analyzer to track. -->
    <NoWarn>$(NoWarn);NU5128;NU5100;RS0016;RS0017;RS0037</NoWarn>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_HackerOsPackTemplates</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <_HackerOsTemplateSource Include="content/**" Exclude="content/**/bin/**;content/**/obj/**" />
    <None Include="@(_HackerOsTemplateSource)" />
  </ItemGroup>

  <Target Name="_HackerOsPackTemplates">
    <PropertyGroup>
      <_HackerOsTemplateStage>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'template-content'))</_HackerOsTemplateStage>
    </PropertyGroup>
    <RemoveDir Directories="$(_HackerOsTemplateStage)" />
    <Copy SourceFiles="@(_HackerOsTemplateSource)" DestinationFiles="@(_HackerOsTemplateSource->'$(_HackerOsTemplateStage)%(RecursiveDir)%(Filename)%(Extension)')" />
    <ItemGroup>
      <_HackerOsStagedProject Include="$(_HackerOsTemplateStage)**/*.csproj" />
    </ItemGroup>
    <XmlPoke XmlInputPath="%(_HackerOsStagedProject.Identity)" Query="/Project/PropertyGroup/HackerOsVersion" Value="$(HackerOsVersion)" />
    <ItemGroup>
      <_HackerOsStagedFile Include="$(_HackerOsTemplateStage)**" />
      <TfmSpecificPackageFile Include="@(_HackerOsStagedFile)" PackagePath="content/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

</Project>
