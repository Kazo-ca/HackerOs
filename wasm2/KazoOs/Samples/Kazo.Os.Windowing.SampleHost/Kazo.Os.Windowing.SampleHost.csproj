<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Development uses source projects. CI sets this property to true to prove that the same
         host restores, builds, and publishes from the isolated local NuGet feed only. -->
    <UseLocalHackerOsPackages Condition="'$(UseLocalHackerOsPackages)' == ''">false</UseLocalHackerOsPackages>
    <KazoOsLocalPackageVersion Condition="'$(KazoOsLocalPackageVersion)' == ''">$(KazoOsVersion)</KazoOsLocalPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalHackerOsPackages)' != 'true'">
    <!--
      Deliberately only the seven projects in the desktop package dependency closure. No
      Kazo.Os.Ecosystem, app projects, Platform.Core, or Simulation.Abstractions: this project
      is EXT-WIN-011's proof that the extracted themes, window engine, chrome, icons, and taskbar
      are consumable by a host with no knowledge of Kazo OS's process/app model.
    -->
    <ProjectReference Include="..\..\Shared\Kazo.Os.Theming.Abstractions\Kazo.Os.Theming.Abstractions.csproj" />
    <ProjectReference Include="..\..\Platform\Kazo.Os.Theming.Blazor\Kazo.Os.Theming.Blazor.csproj" />
    <ProjectReference Include="..\..\Platform\Kazo.Os.Windowing.Abstractions\Kazo.Os.Windowing.Abstractions.csproj" />
    <ProjectReference Include="..\..\Platform\Kazo.Os.Windowing.Core\Kazo.Os.Windowing.Core.csproj" />
    <ProjectReference Include="..\..\Platform\Kazo.Os.Windowing.Blazor\Kazo.Os.Windowing.Blazor.csproj" />
    <ProjectReference Include="..\..\Shared\Kazo.Os.AppSdk.Icons\Kazo.Os.AppSdk.Icons.csproj" />
    <ProjectReference Include="..\..\Platform\Kazo.Os.Taskbar.Blazor\Kazo.Os.Taskbar.Blazor.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalHackerOsPackages)' == 'true'">
    <!-- Keep every directly consumed package explicit. This catches missing packages and incorrect
         transitive versions instead of allowing a ProjectReference to hide packaging defects. -->
    <PackageReference Include="Kazo.Os.Theming.Abstractions" Version="$(KazoOsLocalPackageVersion)" />
    <PackageReference Include="Kazo.Os.Theming.Blazor" Version="$(KazoOsLocalPackageVersion)" />
    <PackageReference Include="Kazo.Os.Windowing.Abstractions" Version="$(KazoOsLocalPackageVersion)" />
    <PackageReference Include="Kazo.Os.Windowing.Core" Version="$(KazoOsLocalPackageVersion)" />
    <PackageReference Include="Kazo.Os.Windowing.Blazor" Version="$(KazoOsLocalPackageVersion)" />
    <PackageReference Include="Kazo.Os.AppSdk.Icons" Version="$(KazoOsLocalPackageVersion)" />
    <PackageReference Include="Kazo.Os.Taskbar.Blazor" Version="$(KazoOsLocalPackageVersion)" />
  </ItemGroup>

</Project>
