@using HackerOs.App.Abstractions
@using HackerOs.AppSdk
@using HackerOs.AppSdk.Blazor
@using HackerOs.AppSdk.Icons
@using HackerOs.AppSdk.Blazor.Components
@using HackerOs.AppSdk.Components
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@inherits WindowAppBase
@implements IAsyncDisposable
@implements IWindowCloseGuard

@*
    The editor's workbench, laid out as VS Code's: menu bar; activity bar (Explorer, Search);
    resizable side bar; the editor group (tabs, breadcrumbs, Monaco filling the rest); the
    resizable bottom dock (Status log, the Terminal app's embedded terminals, Problems); the
    status bar (cursor position, language). Sizes and keyboard
    shortcuts are handled by CodeEditorWindow.razor.js; everything else is C#.
*@
<section class="code-editor" @ref="_root" aria-label="@L["App.Name"]">
    @* MudMenu's activator wrapper is itself the focusable role="button" element, so the titles
       are plain text calling the menu context (a nested <button> would be nested-interactive). *@
    <header class="menubar" aria-label="@L["Menu.Label"]">
        <MudMenu Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Class="menu">
            <ActivatorContent><span class="menu-title" id="code-menu-file" @onclick="context.ToggleAsync">@L["Menu.File"]</span></ActivatorContent>
            <ChildContent>
                <MudMenuItem OnClick="NewDocumentAsync"><span class="menu-entry"><span>@L["Menu.File.NewTextFile"]</span><kbd>Ctrl+N</kbd></span></MudMenuItem>
                <MudMenuItem OnClick="NewFileInFolderAsync" Disabled="@(_workspace is null)"><span class="menu-entry"><span>@L["Menu.File.NewFileInFolder"]</span></span></MudMenuItem>
                <MudDivider />
                <MudMenuItem OnClick="OpenFileAsync"><span class="menu-entry"><span>@L["Menu.File.OpenFile"]</span><kbd>Ctrl+O</kbd></span></MudMenuItem>
                <MudMenuItem OnClick="OpenFolderAsync"><span class="menu-entry"><span>@L["Menu.File.OpenFolder"]</span></span></MudMenuItem>
                <MudMenuItem OnClick="CloseFolder" Disabled="@(_workspace is null)"><span class="menu-entry"><span>@L["Menu.File.CloseFolder"]</span></span></MudMenuItem>
                <MudDivider />
                <MudMenuItem OnClick="SaveActiveAsync" Disabled="@(ActiveDocument is null)"><span class="menu-entry"><span>@L["Menu.File.Save"]</span><kbd>Ctrl+S</kbd></span></MudMenuItem>
                <MudMenuItem OnClick="SaveActiveAsAsync" Disabled="@(ActiveDocument is null)"><span class="menu-entry"><span>@L["Menu.File.SaveAs"]</span><kbd>Ctrl+Shift+S</kbd></span></MudMenuItem>
                <MudMenuItem OnClick="SaveAllAsync" Disabled="@(_dirtyCount == 0)"><span class="menu-entry"><span>@L["Menu.File.SaveAll"]</span></span></MudMenuItem>
                <MudDivider />
                <MudMenuItem OnClick="CloseActiveAsync" Disabled="@(ActiveDocument is null)"><span class="menu-entry"><span>@L["Menu.File.CloseEditor"]</span><kbd>Ctrl+W</kbd></span></MudMenuItem>
                <MudMenuItem OnClick="CloseAllAsync" Disabled="@(_session.Documents.Count == 0)"><span class="menu-entry"><span>@L["Menu.File.CloseAllEditors"]</span></span></MudMenuItem>
            </ChildContent>
        </MudMenu>
        <MudMenu Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Class="menu">
            <ActivatorContent><span class="menu-title" id="code-menu-edit" @onclick="context.ToggleAsync">@L["Menu.Edit"]</span></ActivatorContent>
            <ChildContent>
                <MudMenuItem OnClick="@(() => RunEditorActionAsync("undo"))" Disabled="@(ActiveDocument is null)"><span class="menu-entry"><span>@L["Menu.Edit.Undo"]</span><kbd>Ctrl+Z</kbd></span></MudMenuItem>
                <MudMenuItem OnClick="@(() => RunEditorActionAsync("redo"))" Disabled="@(ActiveDocument is null)"><span class="menu-entry"><span>@L["Menu.Edit.Redo"]</span><kbd>Ctrl+Y</kbd></span></MudMenuItem>
                <MudDivider />
                <MudMenuItem OnClick="@(() => RunEditorActionAsync("actions.find"))" Disabled="@(ActiveDocument is null)"><span class="menu-entry"><span>@L["Menu.Edit.Find"]</span><kbd>Ctrl+F</kbd></span></MudMenuItem>
                <MudMenuItem OnClick="@(() => RunEditorActionAsync("editor.action.startFindReplaceAction"))" Disabled="@(ActiveDocument is null)"><span class="menu-entry"><span>@L["Menu.Edit.Replace"]</span><kbd>Ctrl+H</kbd></span></MudMenuItem>
                <MudMenuItem OnClick="ShowSearchAsync"><span class="menu-entry"><span>@L["Menu.Edit.FindInFolder"]</span><kbd>Ctrl+Shift+F</kbd></span></MudMenuItem>
                <MudDivider />
                <MudMenuItem OnClick="@(() => RunEditorActionAsync("editor.action.commentLine"))" Disabled="@(ActiveDocument is null)"><span class="menu-entry"><span>@L["Menu.Edit.ToggleLineComment"]</span><kbd>Ctrl+/</kbd></span></MudMenuItem>
                <MudMenuItem OnClick="@(() => RunEditorActionAsync("editor.action.formatDocument"))" Disabled="@(ActiveDocument is null)"><span class="menu-entry"><span>@L["Menu.Edit.FormatDocument"]</span><kbd>Shift+Alt+F</kbd></span></MudMenuItem>
            </ChildContent>
        </MudMenu>
        <MudMenu Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Class="menu">
            <ActivatorContent><span class="menu-title" id="code-menu-view" @onclick="context.ToggleAsync">@L["Menu.View"]</span></ActivatorContent>
            <ChildContent>
                <MudMenuItem OnClick="@(() => RunEditorActionAsync("editor.action.quickCommand"))" Disabled="@(ActiveDocument is null)"><span class="menu-entry"><span>@L["Menu.View.CommandPalette"]</span><kbd>F1</kbd></span></MudMenuItem>
                <MudDivider />
                <MudMenuItem OnClick="ShowExplorer"><span class="menu-entry"><span>@L["Menu.View.Explorer"]</span><kbd>Ctrl+Shift+E</kbd></span></MudMenuItem>
                <MudMenuItem OnClick="ShowSearchAsync"><span class="menu-entry"><span>@L["Menu.View.Search"]</span><kbd>Ctrl+Shift+F</kbd></span></MudMenuItem>
                <MudMenuItem OnClick="ToggleSidebar"><span class="menu-entry"><span>@L["Menu.View.ToggleSideBar"]</span><kbd>Ctrl+B</kbd></span></MudMenuItem>
                <MudMenuItem OnClick="ToggleTerminalPanel"><span class="menu-entry"><span>@L["Menu.View.Terminal"]</span><kbd>Ctrl+`</kbd></span></MudMenuItem>
                <MudMenuItem OnClick="TogglePanel"><span class="menu-entry"><span>@(_showPanel ? L["Menu.View.HidePanel"] : L["Menu.View.ShowPanel"])</span><kbd>Ctrl+J</kbd></span></MudMenuItem>
                <MudMenuItem OnClick="() => ShowDockView(DockView.Status)"><span class="menu-entry"><span>@L["Menu.View.StatusLog"]</span></span></MudMenuItem>
                <MudMenuItem OnClick="() => ShowDockView(DockView.Problems)"><span class="menu-entry"><span>@L["Menu.View.Problems"]</span></span></MudMenuItem>
                <MudDivider />
                <MudMenuItem OnClick="ToggleMinimap"><span class="menu-entry"><span>@(_minimap ? L["Menu.View.HideMinimap"] : L["Menu.View.ShowMinimap"])</span></span></MudMenuItem>
                <MudMenuItem OnClick="ToggleWordWrap"><span class="menu-entry"><span>@(_wordWrap ? L["Menu.View.DisableWordWrap"] : L["Menu.View.WordWrap"])</span><kbd>Alt+Z</kbd></span></MudMenuItem>
            </ChildContent>
        </MudMenu>
        <MudMenu Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Class="menu">
            <ActivatorContent><span class="menu-title" id="code-menu-go" @onclick="context.ToggleAsync">@L["Menu.Go"]</span></ActivatorContent>
            <ChildContent>
                <MudMenuItem OnClick="QuickOpenAsync"><span class="menu-entry"><span>@L["Menu.Go.GoToFile"]</span><kbd>Ctrl+P</kbd></span></MudMenuItem>
                <MudMenuItem OnClick="@(() => RunEditorActionAsync("editor.action.gotoLine"))" Disabled="@(ActiveDocument is null)"><span class="menu-entry"><span>@L["Menu.Go.GoToLine"]</span><kbd>Ctrl+G</kbd></span></MudMenuItem>
                <MudDivider />
                <MudMenuItem OnClick="@(() => CycleTabAsync(1))" Disabled="@(_session.Documents.Count < 2)"><span class="menu-entry"><span>@L["Menu.Go.NextEditor"]</span><kbd>Ctrl+Tab</kbd></span></MudMenuItem>
                <MudMenuItem OnClick="@(() => CycleTabAsync(-1))" Disabled="@(_session.Documents.Count < 2)"><span class="menu-entry"><span>@L["Menu.Go.PreviousEditor"]</span><kbd>Ctrl+Shift+Tab</kbd></span></MudMenuItem>
            </ChildContent>
        </MudMenu>
        <span class="menubar-title">@WindowTitle</span>
    </header>

    <div class="workbench-body">
        <nav class="activity-bar" aria-label="@L["Activity.Label"]">
            <button type="button" id="code-activity-explorer"
                    class="activity-button @(_sidebarVisible && _view == SideView.Explorer ? "is-active" : null)"
                    title="@L["Activity.Explorer.Title"]" aria-label="@L["Activity.Explorer"]"
                    aria-pressed="@(_sidebarVisible && _view == SideView.Explorer ? "true" : "false")"
                    @onclick="() => ToggleView(SideView.Explorer)">
                <HackerIcon Library="IconLibrary.Lucide" Name="files" Size="22" />
            </button>
            <button type="button" id="code-activity-search"
                    class="activity-button @(_sidebarVisible && _view == SideView.Search ? "is-active" : null)"
                    title="@L["Activity.Search.Title"]" aria-label="@L["Activity.Search"]"
                    aria-pressed="@(_sidebarVisible && _view == SideView.Search ? "true" : "false")"
                    @onclick="() => ToggleView(SideView.Search)">
                <HackerIcon Library="IconLibrary.Lucide" Name="search" Size="22" />
            </button>
            <span class="activity-spacer"></span>
            <button type="button" id="code-toggle-terminal"
                    class="activity-button @(_showPanel && _dockView == DockView.Terminal ? "is-active" : null)"
                    title="@L["Activity.Terminal.Title"]" aria-label="@L["Activity.Terminal"]"
                    aria-pressed="@(_showPanel && _dockView == DockView.Terminal ? "true" : "false")"
                    @onclick="ToggleTerminalPanel">
                <HackerIcon Library="IconLibrary.Lucide" Name="terminal" Size="22" />
            </button>
        </nav>

        @* Both views stay rendered while the side bar is open, so switching keeps the tree's
           expansion and the search results, as VS Code does. *@
        <aside class="side-bar @(_sidebarVisible ? null : "is-hidden")" aria-label="@L["SideBar.Label"]">
            <div class="side-view @(_view == SideView.Explorer ? "is-active" : null)">
                <CodeEditorExplorer @ref="_explorer"
                                    Workspace="_workspace"
                                    OnOpenFile="OpenFromWorkspaceAsync"
                                    OnPreviewFile="PreviewFromWorkspaceAsync"
                                    OnOpenFolder="OpenFolderAsync"
                                    OnFindInFolder="FindInFolderAsync"
                                    OnOpenInTerminal="OpenInTerminalAsync"
                                    OnRenamed="OnWorkspaceRenamed"
                                    OnError="OnExplorerError" />
            </div>
            <div class="side-view @(_view == SideView.Search ? "is-active" : null)">
                <CodeEditorSearchView @ref="_search"
                                      Workspace="_workspace"
                                      OpenContent="OpenDocumentContent"
                                      BeforeSearch="FlushEditorAsync"
                                      OnOpenMatch="NavigateAsync"
                                      OnOpenFolder="OpenFolderAsync" />
            </div>
        </aside>
        <div class="sidebar-splitter @(_sidebarVisible ? null : "is-hidden")" data-resizes=".side-bar"
             role="separator" aria-orientation="vertical" aria-label="@L["SideBar.Resize"]"></div>

        <div class="main-column">
            <div class="editor-group">
                @* Not a full ARIA tablist pattern (no tabpanel counterparts, no arrow-key roving
                   tabindex), and each tab carries its own close button, which the tablist/tab
                   pattern doesn't allow (axe aria-required-children). aria-pressed communicates
                   the active document without claiming a pattern this widget doesn't implement. *@
                <nav class="tab-strip @(_session.Documents.Count == 0 ? "is-empty" : null)" aria-label="@L["Tabs.Label"]">
                    @foreach (CodeEditorDocument document in _session.Documents)
                    {
                        bool active = document.Id == _session.ActiveDocumentId;
                        string? hint = TabHint(document);
                        <div class="tab-shell @(active ? "is-active" : null) @(IsDirty(document) ? "is-dirty" : null)"
                             @key="document.Id"
                             title="@(document.Path?.Value ?? document.Title)"
                             @onmouseup="args => OnTabMouseUpAsync(args, document.Id)">
                            <button class="tab-select"
                                    aria-pressed="@(active ? "true" : "false")"
                                    @onclick="() => ActivateDocumentAsync(document.Id)">
                                <HackerIcon Library="IconLibrary.Lucide" Name="file-code" Size="14" />
                                <span class="tab-name">@document.Title</span>
                                @if (hint is not null)
                                {
                                    <span class="tab-hint">@hint</span>
                                }
                            </button>
                            <button class="tab-close"
                                    aria-label="@L["Tabs.CloseNamed", document.Title]"
                                    title="@L["Tabs.Close"]"
                                    @onclick="() => CloseDocumentAsync(document.Id)">
                                <span class="dirty-dot" aria-hidden="true">●</span>
                                <span class="close-x" aria-hidden="true">×</span>
                            </button>
                        </div>
                    }
                </nav>

                @if (ActiveDocument is { } current)
                {
                    <div class="breadcrumbs" aria-label="@L["Breadcrumbs.Label"]">
                        @foreach (string segment in Breadcrumbs(current))
                        {
                            <span class="crumb">@segment</span>
                        }
                    </div>
                }

                @* Errors stay above the editor until dismissed; other messages go to the status bar
                   and the dock's Status tab only. *@
                @if (_statusIsError && !string.IsNullOrWhiteSpace(_statusMessage))
                {
                    <div class="editor-message is-error" role="alert">
                        <span>@_statusMessage</span>
                        <button type="button" class="message-close" aria-label="@L["Message.Dismiss"]" @onclick="ClearStatus">×</button>
                    </div>
                }

                <div class="editor-area">
                    <div class="editor-host @(ActiveDocument is null ? "is-empty" : null)" @ref="_editorHost"></div>
                    @if (ActiveDocument is null)
                    {
                        <div class="watermark">
                            <div class="watermark-logo" aria-hidden="true">&lt;/&gt;</div>
                            <dl class="watermark-shortcuts">
                                <dt>@L["Watermark.GoToFile"]</dt><dd><kbd>Ctrl</kbd>+<kbd>P</kbd></dd>
                                <dt>@L["Watermark.FindInFolder"]</dt><dd><kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>F</kbd></dd>
                                <dt>@L["Watermark.NewTextFile"]</dt><dd><kbd>Ctrl</kbd>+<kbd>N</kbd></dd>
                                <dt>@L["Watermark.OpenFile"]</dt><dd><kbd>Ctrl</kbd>+<kbd>O</kbd></dd>
                                <dt>@L["Watermark.ToggleTerminal"]</dt><dd><kbd>Ctrl</kbd>+<kbd>`</kbd></dd>
                            </dl>
                            <div class="watermark-actions">
                                <button type="button" id="code-new" class="link-button" @onclick="NewDocumentAsync">@L["Watermark.NewFile"]</button>
                                <button type="button" id="code-open" class="link-button" @onclick="OpenFileAsync">@L["Menu.File.OpenFile"]</button>
                                <button type="button" id="code-open-folder" class="link-button" @onclick="OpenFolderAsync">@L["Menu.File.OpenFolder"]</button>
                            </div>
                        </div>
                    }
                </div>

                <CodeEditorQuickOpenPalette @ref="_quickOpen"
                                            Workspace="_workspace"
                                            OnPick="OnQuickOpenPickAsync"
                                            OnClosed="FocusEditorAsync" />
            </div>

            @if (_showPanel)
            {
                <div class="panel-splitter" data-resizes=".bottom-dock"
                     role="separator" aria-orientation="horizontal" aria-label="@L["Panel.Resize"]"></div>
            }
            @* The dock stays rendered while hidden, so its terminals keep their shells and screens. *@
            <section class="bottom-dock @(_showPanel ? null : "is-hidden")" aria-label="@L["Panel.Label"]">
                <header class="panel-header">
                    <nav class="dock-tabs" aria-label="@L["Panel.Views"]">
                        <button type="button" id="code-dock-status" class="dock-tab @(_dockView == DockView.Status ? "is-active" : null)"
                                aria-pressed="@(_dockView == DockView.Status ? "true" : "false")" @onclick="() => ShowDockView(DockView.Status)">
                            @L["Panel.Status"]
                            @if (_statusLog.Any(entry => entry.IsError))
                            {
                                <span class="dock-badge is-error">@_statusLog.Count(entry => entry.IsError)</span>
                            }
                        </button>
                        <button type="button" id="code-dock-terminal" class="dock-tab @(_dockView == DockView.Terminal ? "is-active" : null)"
                                aria-pressed="@(_dockView == DockView.Terminal ? "true" : "false")" @onclick="() => ShowDockView(DockView.Terminal)">
                            @L["Panel.Terminal"]
                        </button>
                        <button type="button" id="code-dock-problems" class="dock-tab @(_dockView == DockView.Problems ? "is-active" : null)"
                                aria-pressed="@(_dockView == DockView.Problems ? "true" : "false")" @onclick="() => ShowDockView(DockView.Problems)">
                            @L["Panel.Problems"]
                            <span class="dock-badge">0</span>
                        </button>
                    </nav>
                    @if (_dockView == DockView.Terminal)
                    {
                        <nav class="terminal-tabs" aria-label="@L["Terminals.Label"]">
                            @foreach (TerminalTab tab in _terminalTabs)
                            {
                                <div class="terminal-tab-shell @(tab.Id == _activeTerminalTabId ? "is-active" : null)" @key="tab.Id">
                                    <button class="terminal-tab-select"
                                            title="@(tab.Terminal?.WorkingDirectory ?? tab.Options.WorkingDirectory)"
                                            aria-pressed="@(tab.Id == _activeTerminalTabId ? "true" : "false")"
                                            @onclick="() => ActivateTerminalTab(tab.Id)">
                                        <HackerIcon Library="IconLibrary.Lucide" Name="terminal" Size="13" />
                                        <span>@tab.Number: @tab.Label</span>
                                    </button>
                                    <button class="terminal-tab-close"
                                            aria-label="@L["Terminals.KillNumbered", tab.Number]"
                                            title="@L["Terminals.Kill"]"
                                            @onclick="() => CloseTerminalTab(tab.Id)">×</button>
                                </div>
                            }
                        </nav>
                    }
                    <span class="panel-actions">
                        @if (_dockView == DockView.Terminal)
                        {
                            <button type="button" class="panel-button" aria-label="@L["Terminals.New"]" title="@L["Terminals.New"]" @onclick="() => AddTerminalTab()">+</button>
                            <button type="button" class="panel-button" aria-label="@L["Terminals.Clear"]" title="@L["Terminals.Clear"]" @onclick="ClearActiveTerminalAsync">
                                <HackerIcon Library="IconLibrary.Lucide" Name="eraser" Size="14" />
                            </button>
                        }
                        else if (_dockView == DockView.Status)
                        {
                            <button type="button" class="panel-button" aria-label="@L["Panel.ClearStatusLog"]" title="@L["Panel.ClearStatusLog"]" @onclick="ClearStatusLog">
                                <HackerIcon Library="IconLibrary.Lucide" Name="eraser" Size="14" />
                            </button>
                        }
                        <button type="button" class="panel-button" aria-label="@L["Menu.View.HidePanel"]" title="@L["Panel.Hide.Title"]" @onclick="TogglePanel">×</button>
                    </span>
                </header>

                <div class="dock-view dock-status @(_dockView == DockView.Status ? "is-active" : null)" role="log" aria-label="@L["Panel.StatusLog"]">
                    <dl class="status-facts">
                        <dt>@L["Facts.Folder"]</dt><dd>@(_workspace?.Root.Value ?? L["Facts.None"])</dd>
                        <dt>@L["Facts.File"]</dt><dd>@(ActiveDocument?.Path?.Value ?? ActiveDocument?.Title ?? L["Facts.None"])</dd>
                        <dt>@L["Facts.Language"]</dt><dd>@(ActiveDocument is null ? "-" : SyntaxModeLabel(ActiveDocument.SyntaxMode))</dd>
                        <dt>@L["Facts.Editors"]</dt><dd>@(L["Facts.EditorsValue", Strings.Count(L, "Facts.Open", _session.Documents.Count), Strings.Count(L, "Facts.Unsaved", _dirtyCount)])</dd>
                        <dt>@L["Facts.Terminals"]</dt><dd>@_terminalTabs.Count</dd>
                    </dl>
                    <ol class="status-log">
                        @if (_statusLog.Count == 0)
                        {
                            <li class="status-empty">@L["StatusLog.Empty"]</li>
                        }
                        @for (int i = _statusLog.Count - 1; i >= 0; i--)
                        {
                            StatusEntry entry = _statusLog[i];
                            <li class="status-entry @(entry.IsError ? "is-error" : null)">
                                <time datetime="@entry.Time.ToString("O")">@TimeZoneInfo.ConvertTime(entry.Time, AppContext.TimeZone).ToString("HH:mm:ss", AppContext.FormatCulture)</time>
                                <span class="status-level">@(entry.IsError ? L["StatusLog.Error"] : L["StatusLog.Info"])</span>
                                <span>@entry.Message</span>
                            </li>
                        }
                    </ol>
                </div>

                <div class="dock-view dock-terminal @(_dockView == DockView.Terminal ? "is-active" : null)">
                    @foreach (TerminalTab tab in _terminalTabs)
                    {
                        <div class="terminal-instance @(tab.Id == _activeTerminalTabId ? "is-active" : null)" @key="tab.Id">
                            @* The Terminal app's own terminal, embedded by contract (ADR 0063). *@
                            <HackEmbeddedComponent TController="IHackTerminal"
                                                   Contract="@HackComponentContracts.Terminal"
                                                   Options="tab.Options"
                                                   ControllerChanged="terminal => OnTerminalReady(tab, terminal)" />
                        </div>
                    }
                </div>

                <div class="dock-view dock-problems @(_dockView == DockView.Problems ? "is-active" : null)">
                    <p class="problems-empty">@L["Problems.Empty"]</p>
                </div>
            </section>
        </div>
    </div>

    <footer class="statusbar" role="group" aria-label="@L["StatusBar.Label"]">
        <span class="status-left">
            @if (_workspace is not null)
            {
                <span class="status-item" title="@_workspace.Root.Value">
                    <HackerIcon Library="IconLibrary.Lucide" Name="folder-open" Size="13" />
                    @_workspace.Name
                </span>
            }
            @if (!_statusIsError && !string.IsNullOrWhiteSpace(_statusMessage))
            {
                <button type="button" class="status-item status-message" title="@L["StatusBar.ShowStatusLog"]"
                        @onclick="() => ShowDockView(DockView.Status)">@_statusMessage</button>
            }
            @if (_dirtyCount > 0)
            {
                <span class="status-item" title="@L["StatusBar.UnsavedEditors"]">
                    <HackerIcon Library="IconLibrary.Lucide" Name="circle-dot" Size="13" />
                    @(Strings.Count(L, "StatusBar.Unsaved", _dirtyCount))
                </span>
            }
        </span>
        <span class="status-right">
            @if (ActiveDocument is not null)
            {
                <CodeEditorCursorStatus @ref="_cursorStatus" />
                <span class="status-item">UTF-8</span>
                <span class="status-item">LF</span>
                <label class="status-item language-label" for="code-language">
                    <span class="visually-hidden">@L["StatusBar.LanguageMode"]</span>
                    <select id="code-language"
                            class="language-select"
                            value="@ActiveDocument.SyntaxMode"
                            @onchange="ChangeSyntaxModeAsync">
                        @foreach (CodeEditorSyntaxMode mode in Enum.GetValues<CodeEditorSyntaxMode>())
                        {
                            <option value="@mode">@SyntaxModeLabel(mode)</option>
                        }
                    </select>
                </label>
            }
        </span>
    </footer>
</section>
