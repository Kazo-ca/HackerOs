@using Kazo.Os.App.Abstractions
@using Kazo.Os.AppSdk
@using Kazo.Os.AppSdk.Blazor
@using Kazo.Os.AppSdk.Blazor.ContextMenus
@using Kazo.Os.AppSdk.Icons
@using Microsoft.AspNetCore.Components.Web
@using Kazo.Os.AppSdk.Diagnostics
@using Kazo.Os.AppSdk.Threading
@using Kazo.Os.Simulation.Abstractions
@using Kazo.Os.Simulation.Abstractions.FileSystem
@using Kazo.Os.Simulation.Abstractions.Processes
@inherits WindowAppBase

<div class="sample-window-container">
    <header class="sample-window-header">
        <span class="sample-window-title">Sample Window App (SDK 1.0)</span>
    </header>

    <div class="sample-window-body">
        <section class="sample-section">
            <h3>File Dialogs & VFS Gateway</h3>
            <div class="button-row">
                <button class="sample-btn" @onclick="OpenFileAsync">Open File...</button>
                <button class="sample-btn" @onclick="SaveFileAsync">Save As...</button>
            </div>
            <div class="output-box">@_fileStatus</div>
        </section>

        <section class="sample-section">
            <h3>Window Events</h3>
            <div class="output-box" data-sample-window-state>
                @(IsWindowActive ? "Active" : "Inactive") · @WindowState@(WindowSize is { } size ? $" · {size.Width:0}×{size.Height:0}" : string.Empty)
            </div>
            <ul class="event-log" data-sample-window-events>
                @foreach (string entry in _windowEvents)
                {
                    <li>@entry</li>
                }
            </ul>
        </section>

        <section class="sample-section" data-sample-background>
            <h3>Background Task (HackBackground)</h3>
            <div class="button-row">
                <label class="sample-label">
                    Primes below
                    <input class="sample-input" type="number" min="1000" step="1000000" @bind="_primeLimit" disabled="@IsTaskRunning" />
                </label>
                <button class="sample-btn" @onclick="StartPrimeCountAsync" disabled="@IsTaskRunning">Start</button>
                <button class="sample-btn" @onclick="CancelPrimeCount" disabled="@(!IsTaskRunning)">Cancel</button>
                <button class="sample-btn sample-btn-danger" @onclick="KillPrimeCountAsync" disabled="@(_taskPid is null)">Kill</button>
            </div>
            <progress class="sample-progress" max="1" value="@_taskProgress.Fraction"></progress>
            <div class="output-box" data-sample-background-status>@_taskStatus</div>
        </section>

        <section class="sample-section" data-sample-context-menu>
            <h3>Context Menu (ADR 0150)</h3>
            @* Drawn by the OS: right click, long press, the Menu key or Shift+F10 on a note. *@
            <HackContextMenu Name="sample-notes" Opening="OnNotesMenuOpening">
                <HackMenuItem Id="open" Title="Open" Icon="FileIcon" OnClick="@(item => ShowNote(item, "opened"))" />
                <HackMenuGroup>
                    <HackMenuItem Id="copy-name" Title="Copy name" Shortcut="Ctrl+C" OnClick="@(item => ShowNote(item, "name copied"))" />
                    <HackMenuItem Id="label" Title="Label" Icon="TagIcon">
                        <HackMenuItem Id="label-red" Title="Red" OnClick="@(item => LabelNote(item, "red"))" />
                        <HackMenuItem Id="label-green" Title="Green" OnClick="@(item => LabelNote(item, "green"))" />
                        <HackMenuGroup>
                            <HackMenuItem Id="label-more" Title="More colours">
                                <HackMenuItem Id="label-blue" Title="Blue" OnClick="@(item => LabelNote(item, "blue"))" />
                                <HackMenuItem Id="label-amber" Title="Amber" OnClick="@(item => LabelNote(item, "amber"))" />
                            </HackMenuItem>
                        </HackMenuGroup>
                    </HackMenuItem>
                </HackMenuGroup>
                <HackMenuGroup>
                    <HackMenuItem Id="delete" Title="Delete" Icon="TrashIcon" Shortcut="Del" OnClick="DeleteNote" />
                </HackMenuGroup>
            </HackContextMenu>
            <ul class="sample-notes" @attributes="@(Menus.Attach(NotesAreaMenu))">
                @foreach (SampleNote note in _notes)
                {
                    <li class="sample-note" tabindex="0" data-sample-note="@note.Name" @attributes="@(Menus.Attach("sample-notes", note))">
                        <span>@note.Name</span>
                        @if (note.Label is { } label)
                        {
                            <span class="sample-note-label">@label</span>
                        }
                    </li>
                }
            </ul>
            <div class="button-row">
                <button class="sample-btn" data-sample-menu-button @onclick="OpenNotesAreaMenuAsync">⋯ Menu from code</button>
            </div>
            <div class="output-box" data-sample-context-menu-status>@_menuStatus</div>
        </section>

        <section class="sample-section">
            <h3>Capability Check</h3>
            <div class="button-row">
                <button class="sample-btn" @onclick="TestCapabilityAccessAsync">Test Private Storage</button>
            </div>
            <div class="output-box">@_capabilityStatus</div>
        </section>
    </div>
</div>

@code {
    private readonly List<string> _windowEvents = [];

    // ADR 0150: the notes of the context menu demo, and a second menu defined in C#.
    private const string NotesAreaMenu = "sample-notes-area";
    private static readonly HackIcon FileIcon = HackIcons.Vector(IconLibrary.Lucide, "file-text");
    private static readonly HackIcon TagIcon = HackIcons.Vector(IconLibrary.Lucide, "tag");
    private static readonly HackIcon TrashIcon = HackIcons.Vector(IconLibrary.Lucide, "trash-2");
    private readonly List<SampleNote> _notes = [new("readme.md"), new("todo.txt"), new("ideas.txt")];
    private string _menuStatus = "Right-click a note, or the empty area below the notes.";
    private int _created;

    protected override void OnAppInitialized()
    {
        // The same model as the markup, built in C#: called again at each opening. The window's
        // closing removes it; disposing the result would remove it sooner.
        _ = Menus.Define(NotesAreaMenu, menu => menu
            .Item("new-note", "New note", _ =>
            {
                _notes.Add(new SampleNote($"note-{++_created}.txt"));
                _menuStatus = $"Created note-{_created}.txt.";
                return Task.CompletedTask;
            }, icon: HackIcons.Vector(IconLibrary.Lucide, "file-plus"))
            .Group(group => group
                .Submenu("sort", "Sort by", sort => sort
                    .Item("sort-name", "Name", _ => SortNotesAsync())
                    .Item("sort-none", "Nothing yet", _ => Task.CompletedTask, isDisabled: true))));
    }

    private sealed class SampleNote(string name)
    {
        public string Name { get; } = name;

        public string? Label { get; set; }
    }

    private void ShowNote(object? item, string action) =>
        _menuStatus = item is SampleNote note ? $"{note.Name}: {action}." : action;

    private void LabelNote(object? item, string label)
    {
        if (item is SampleNote note)
        {
            note.Label = label;
            _menuStatus = $"{note.Name} labelled {label}.";
        }
    }

    private void DeleteNote(object? item)
    {
        if (item is SampleNote note && _notes.Remove(note))
        {
            _menuStatus = $"{note.Name} deleted.";
        }
    }

    private Task SortNotesAsync()
    {
        _notes.Sort((left, right) => string.CompareOrdinal(left.Name, right.Name));
        _menuStatus = "Sorted by name.";
        return Task.CompletedTask;
    }

    /// <summary>The readme cannot be deleted: its entry is shown disabled for it only.</summary>
    private void OnNotesMenuOpening(HackMenuOpeningEventArgs args)
    {
        if (args.Item is SampleNote { Name: "readme.md" })
        {
            args.Menu.Disable("delete");
        }
    }

    private Task OpenNotesAreaMenuAsync(MouseEventArgs args) =>
        Menus.OpenAsync(NotesAreaMenu, null, args.ClientX, args.ClientY);
    private string _fileStatus = "No file operation performed.";

    // ADR 0095 §1: the window manager's events, newest first, at most eight.
    protected override void OnWindowActivated() => RecordWindowEvent("activated");

    protected override void OnWindowDeactivated() => RecordWindowEvent("deactivated");

    protected override void OnWindowStateChanged(HackWindowState previous, HackWindowState current) =>
        RecordWindowEvent($"{previous} → {current}");

    protected override void OnWindowResized(HackWindowSize size) =>
        RecordWindowEvent($"resized to {size.Width:0}×{size.Height:0}");

    private void RecordWindowEvent(string entry)
    {
        _windowEvents.Insert(0, entry);
        if (_windowEvents.Count > 8)
        {
            _windowEvents.RemoveAt(_windowEvents.Count - 1);
        }

        StateHasChanged();
    }
    private string _capabilityStatus = "Click button to test capability access.";

    // ADR 0128: the prime count runs as a child process (sample-window-app:CountPrimes), in a Web
    // Worker when the host has some; the window only awaits it and shows its reports.
    private int _primeLimit = 3_000_000;
    private CancellationTokenSource? _taskCancel;
    private HackBackgroundProgress _taskProgress;
    private long? _taskPid;
    private string _taskStatus = "Counts primes off the window's thread: watch it in ps or the task manager.";

    private bool IsTaskRunning => _taskCancel is not null;

    private async Task StartPrimeCountAsync()
    {
        _taskCancel = new CancellationTokenSource();
        _taskProgress = default;
        _taskStatus = "Starting…";
        // Delivered on the renderer's synchronization context, at most ten times a second.
        Progress<HackBackgroundProgress> progress = new(report =>
        {
            _taskProgress = report;
            _taskPid ??= ParsePid(report.Message);
            _taskStatus = report.ToString();
            StateHasChanged();
        });

        try
        {
            PrimeCountResult result = await HackBackground.RunAsync<PrimeCountInput, PrimeCountResult>(
                SampleJobs.CountPrimes,
                new PrimeCountInput(Math.Max(1000, _primeLimit)),
                progress,
                cancellationToken: _taskCancel.Token);
            _taskStatus = $"{result.Count} primes below {_primeLimit}; the largest is {result.Largest}.";
        }
        catch (HackProcessKilledException exception)
        {
            // kill -9, the task manager, or the Kill button: the task's process is gone, the window is not.
            _taskStatus = $"The task's process was killed ({exception.Reason}).";
        }
        catch (OperationCanceledException)
        {
            _taskStatus = "Cancelled.";
        }
        catch (HackBackgroundJobException exception)
        {
            _taskStatus = $"The task failed: {exception.OriginalTypeName}: {exception.Message}";
        }
        finally
        {
            _taskCancel.Dispose();
            _taskCancel = null;
            _taskPid = null;
        }
    }

    private void CancelPrimeCount() => _taskCancel?.Cancel();

    private async Task KillPrimeCountAsync()
    {
        if (_taskPid is not { } pid)
        {
            return;
        }

        try
        {
            // A parent may kill its own children without the process-management capability (ADR 0140).
            await AppContext.Processes.KillAsync(ProcessId.FromInt64(pid));
        }
        catch (Exception exception) when (exception is KeyNotFoundException or InvalidOperationException)
        {
            // It ended in the meantime.
        }
    }

    /// <summary>The task reports "pid N · …": its process id, so the window can kill it.</summary>
    private static long? ParsePid(string? message) =>
        message is not null && message.StartsWith("pid ", StringComparison.Ordinal)
            && long.TryParse(message.AsSpan(4, message.IndexOf(' ', 4) is var end and > 4 ? end - 4 : message.Length - 4), out long pid)
            ? pid
            : null;

    private async Task OpenFileAsync()
    {
        try
        {
            OpenFileDialogResult result = await base.OpenFileAsync(new OpenFileDialogRequest
            {
                Title = "Open Sample File",
                Filters = [new FileDialogFilter("Text files", [".txt", ".json", ".md"], ["text/plain", "application/json"])]
            });

            if (result.Status == FileDialogStatus.Selected && result.Resources.Count > 0)
            {
                _fileStatus = $"Selected: {result.Resources[0].Path}";
            }
            else
            {
                _fileStatus = "File selection cancelled.";
            }
        }
        catch (Exception ex)
        {
            _fileStatus = $"Error: {ex.Message}";
        }
    }

    private async Task SaveFileAsync()
    {
        try
        {
            SaveFileDialogResult result = await base.SaveFileAsync(new SaveFileDialogRequest
            {
                Title = "Save Sample File",
                SuggestedFileName = "sample.txt",
                DefaultExtension = ".txt"
            });

            if (result.Status == FileDialogStatus.Selected && result.Resource is not null)
            {
                _fileStatus = $"Save destination: {result.Resource.Path}";
            }
            else
            {
                _fileStatus = "Save cancelled.";
            }
        }
        catch (Exception ex)
        {
            _fileStatus = $"Error: {ex.Message}";
        }
    }

    private async Task TestCapabilityAccessAsync()
    {
        try
        {
            VirtualPath privatePath = VirtualPath.Parse("/etc/hackeros/protected.conf");
            FileSystemResult<FileSystemContentReadHandle> result = await AppContext.FileSystem.ReadAsync(new FileSystemReadRequest(privatePath));

            if (result.Succeeded)
            {
                _capabilityStatus = "Access granted to system path.";
            }
            else
            {
                _capabilityStatus = $"Capability denied or error: {result.Error?.Code}";
            }
        }
        catch (Exception ex)
        {
            _capabilityStatus = $"Exception: {ex.Message}";
        }
    }
}
