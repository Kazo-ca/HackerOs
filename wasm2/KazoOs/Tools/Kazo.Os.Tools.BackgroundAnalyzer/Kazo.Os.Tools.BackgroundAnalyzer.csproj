<Project Sdk="Microsoft.NET.Sdk">

  <!--
    KazoBackground analyzer (ADR 0128 section 2, ADR 0140): a Roslyn analyzer that refuses, at build
    time, a background task the OS could not run in a Web Worker: a lambda or an instance method, a
    method of another assembly or of a generic type, an input or result type no
    [assembly: KazoWireContext] context declares (KOSBGnnnn). Shipped in the Kazo.Os.AppSdk package
    (analyzers/dotnet/cs); in-repo apps get it through build/Kazo.Os.Apps.targets.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Release tracking of the KOSBG rules (RS2008). -->
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>
