@using Kazo.Os.Apps.HackPaint
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JavaScript

<section class="hack-paint-proof" aria-label="Hack Paint browser contract">
    <h1>Hack Paint canvas contract</h1>
    <div role="toolbar" aria-label="Hack Paint proof actions">
        <button @onclick="DrawAsync">Draw pixel</button>
        <button @onclick="UndoAsync">Undo</button>
        <button @onclick="RedoAsync">Redo</button>
        <button @onclick="CropAsync">Crop</button>
        <button @onclick="PanAsync">Pan</button>
    </div>
    <canvas id="hack-paint-canvas" @ref="_canvas" width="@_state.Width" height="@_state.Height" aria-label="Hack Paint canvas"></canvas>
    <output id="hack-paint-result" data-status="@_status" data-size="@($"{_state.Width}x{_state.Height}")" data-pan="@($"{_state.PanX},{_state.PanY}")">@_status</output>
</section>

@code {
    private readonly PaintCanvasState _state = new();
    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private string _status = "starting";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _state.NewDocument(16, 16);
        _module = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./_content/Kazo.Os.Apps.HackPaint/HackPaintWindow.razor.js");
        await RenderAsync();
        _status = "ready";
        StateHasChanged();
    }

    private async Task DrawAsync() { _state.DrawLine(2, 2, 8, 2, "#ff0000", 1); _status = "drawn"; await RenderAsync(); }
    private async Task UndoAsync() { _state.Undo(); _status = "undone"; await RenderAsync(); }
    private async Task RedoAsync() { _state.Redo(); _status = "redone"; await RenderAsync(); }
    private async Task CropAsync() { _state.Crop(1, 1, 8, 8); _status = "cropped"; await RenderAsync(); }
    private async Task PanAsync() { _state.PanBy(5, -3); _status = "panned"; await _module!.InvokeVoidAsync("setViewport", _canvas, _state.PanX, _state.PanY, _state.Scale); }
    private Task RenderAsync() => _module!.InvokeVoidAsync("renderRgba", _canvas, _state.Width, _state.Height, _state.GetCurrentBuffer()).AsTask();
    public async ValueTask DisposeAsync() { if (_module is not null) await _module.DisposeAsync(); }
}
