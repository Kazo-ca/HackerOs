@using Kazo.Os.AppSdk.Files
@inherits Kazo.Os.AppSdk.Blazor.KazoComponentBase

@*
    Settings > Desktop (ADR 0160 §8): the [view] group of ~/.config/hackeros/desktop.config. The desktop
    follows the file and redraws its icons as soon as it changes. Behavior lives in DesktopPanel.razor.cs.
*@
@if (!_loaded)
{
    <p class="setting-desc">@L["Common.Loading"]</p>
}
else
{
    <div class="setting-group desk-panel">
        <h4 id="desk-size-title">@L["Desktop.IconSize.Title"]</h4>
        <p class="setting-desc">
            @LocalizedMarkup.Format(L["Desktop.Description"], LocalizedMarkup.Code("~/Desktop"), LocalizedMarkup.Code("~/.config/hackeros/desktop.config"))
        </p>
        <div class="desk-options" role="radiogroup" aria-labelledby="desk-size-title">
            @foreach (KazoDesktopIconSize size in IconSizes)
            {
                <button type="button" role="radio" class="@OptionClass(_options.IconSize == size)"
                        aria-checked="@(_options.IconSize == size ? "true" : "false")"
                        disabled="@_isBusy"
                        @onclick="() => SaveAsync(_options with { IconSize = size })">
                    <span class="desk-sample desk-sample-@size.ToString().ToLowerInvariant()" aria-hidden="true"></span>
                    <span class="desk-label">@L["Desktop.IconSize." + size]</span>
                </button>
            }
        </div>
    </div>

    <div class="setting-group desk-panel">
        <h4 id="desk-layout-title">@L["Desktop.Layout.Title"]</h4>
        <p class="setting-desc">@L["Desktop.Layout.Description"]</p>
        <div class="desk-options" role="group" aria-labelledby="desk-layout-title">
            <button type="button" role="switch" class="@OptionClass(_options.AutoArrange)"
                    aria-checked="@(_options.AutoArrange ? "true" : "false")" disabled="@_isBusy"
                    @onclick="() => SaveAsync(_options with { AutoArrange = !_options.AutoArrange })">
                <span class="desk-tag" aria-hidden="true">@OnOff(_options.AutoArrange)</span>
                <span class="desk-label">@L["Desktop.AutoArrange"]</span>
            </button>
            <button type="button" role="switch" class="@OptionClass(_options.AlignToGrid)"
                    aria-checked="@(_options.AlignToGrid ? "true" : "false")" disabled="@_isBusy"
                    @onclick="() => SaveAsync(_options with { AlignToGrid = !_options.AlignToGrid })">
                <span class="desk-tag" aria-hidden="true">@OnOff(_options.AlignToGrid)</span>
                <span class="desk-label">@L["Desktop.AlignToGrid"]</span>
            </button>
            <button type="button" role="switch" class="@OptionClass(_options.ShowHome)"
                    aria-checked="@(_options.ShowHome ? "true" : "false")" disabled="@_isBusy"
                    @onclick="() => SaveAsync(_options with { ShowHome = !_options.ShowHome })">
                <span class="desk-tag" aria-hidden="true">@OnOff(_options.ShowHome)</span>
                <span class="desk-label">@L["Desktop.ShowHome"]</span>
            </button>
            <button type="button" role="switch" class="@OptionClass(_options.ShowTrash)"
                    aria-checked="@(_options.ShowTrash ? "true" : "false")" disabled="@_isBusy"
                    @onclick="() => SaveAsync(_options with { ShowTrash = !_options.ShowTrash })">
                <span class="desk-tag" aria-hidden="true">@OnOff(_options.ShowTrash)</span>
                <span class="desk-label">@L["Desktop.ShowTrash"]</span>
            </button>
        </div>
    </div>

    <div class="setting-group desk-panel">
        <h4 id="desk-sort-title">@L["Desktop.Sort.Title"]</h4>
        <p class="setting-desc">@L["Desktop.Sort.Description"]</p>
        <div class="desk-options" role="radiogroup" aria-labelledby="desk-sort-title">
            @foreach (KazoDesktopSort sort in Sorts)
            {
                <button type="button" role="radio" class="@OptionClass(_options.Sort == sort)"
                        aria-checked="@(_options.Sort == sort ? "true" : "false")"
                        disabled="@_isBusy"
                        @onclick="() => SortAsync(sort)">
                    <span class="desk-label">@L["Desktop.Sort." + sort]</span>
                </button>
            }
        </div>
        <button type="button" class="btn-secondary desk-reset" disabled="@_isBusy" @onclick="ResetPositionsAsync">
            @L["Desktop.ResetPositions"]
        </button>
    </div>
}

@if (_message is not null)
{
    <div class="@(_messageIsError ? "desk-message is-error" : "desk-message")" role="@(_messageIsError ? "alert" : "status")">@_message</div>
}
