<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../../Platform/Packaging.props" />

  <PropertyGroup>
    <PackageId>HackerOs.Commands</PackageId>
    <Description>The built-in KazoOS terminal commands (ls, cat, grep, curl, nano...), one lazy-loaded assembly.</Description>
    <PackageTags>hackeros;app;commands</PackageTags>
  </PropertyGroup>

  <!--
    ADR 0051: every built-in terminal command lives in this single project, one folder per command
    (Cat/CatApp.cs + Cat/CatCommand.cs, namespace HackerOs.Commands.Cat). Each [AppManifest] class
    produces manifests/<appId>.json (ADR 0047); the host references this project once, with
    IsSystemApp="true", and lazy-loads the whole assembly on first use.
    ADR 0055/0056: only abstractions and the SDK; the network commands go through HackDns,
    HackPing, HackHttpClient and HackTcpClient, never Platform Core or the server contracts.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\HackerOs.App.Abstractions\HackerOs.App.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\Shared\HackerOs.AppSdk\HackerOs.AppSdk.csproj" />
    <ProjectReference Include="..\..\..\Shared\HackerOs.Simulation.Abstractions\HackerOs.Simulation.Abstractions.csproj" />
  </ItemGroup>

</Project>
