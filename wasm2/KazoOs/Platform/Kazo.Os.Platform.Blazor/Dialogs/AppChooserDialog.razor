@using Microsoft.AspNetCore.Components.Web
@using Kazo.Os.AppSdk.Blazor
@inject IStringLocalizer<Strings> L

@*
    The OS app chooser (ADR 0096, section 5): the "Open with" list shown when several apps can handle
    a file, a URI or an app-defined intent and none is the default. One radio per app, keyboard
    navigable (arrows move, Enter opens, Escape cancels), and an "Always use this app" box.
*@
<div class="app-chooser-dialog" role="dialog" aria-modal="true" aria-labelledby="@_headingId">
    <p id="@_headingId" class="app-chooser-content">@(string.IsNullOrWhiteSpace(Presentation.Request.Content) ? L["Dialog.ChooseApp"] : Presentation.Request.Content)</p>
    <div class="app-chooser-list" role="radiogroup" aria-label="@L["Dialog.Applications"]" @onkeydown="HandleKeyDown">
        @foreach (AppChooserOption option in Presentation.Request.Candidates)
        {
            <button type="button"
                    role="radio"
                    class="app-chooser-option @(option.AppId == _selected ? "selected" : "")"
                    aria-checked="@(option.AppId == _selected ? "true" : "false")"
                    @onclick="() => _selected = option.AppId"
                    @ondblclick="() => Open(option.AppId)">
                <span class="app-chooser-mark" aria-hidden="true">@(option.AppId == _selected ? "▣" : "□")</span>
                <span class="app-chooser-name">@option.Name</span>
                @if (!string.IsNullOrWhiteSpace(option.Description))
                {
                    <span class="app-chooser-description">@option.Description</span>
                }
                <span class="app-chooser-id">@option.AppId</span>
            </button>
        }
    </div>
    @if (Presentation.Request.OfferAlwaysUse)
    {
        <label class="app-chooser-always">
            <input type="checkbox" @bind="_alwaysUse" />
            <span>@L["Dialog.AlwaysUse"]</span>
        </label>
    }
    <footer class="app-chooser-actions">
        <button type="button" class="primary" disabled="@(_selected is null)" @onclick="() => Open(_selected)">@L["Common.Open"]</button>
        <button type="button" @onclick="HandleCancel">@L["Common.Cancel"]</button>
    </footer>
</div>

@code {
    private readonly string _headingId = $"app-chooser-{Guid.NewGuid():N}";
    private string? _selected;
    private bool _alwaysUse;

    [Parameter]
    [EditorRequired]
    public AppChooserPresentation Presentation { get; set; } = default!;

    [Parameter]
    [EditorRequired]
    public DialogCoordinator Coordinator { get; set; } = default!;

    protected override void OnInitialized() =>
        _selected = Presentation.Request.Candidates.FirstOrDefault()?.AppId;

    private void Open(string? appId)
    {
        if (appId is not null)
        {
            Coordinator.SelectApp(Presentation.Id, appId, _alwaysUse);
        }
    }

    private void HandleCancel() => Coordinator.Cancel(Presentation.Id);

    /// <summary>Arrow keys move the choice, Enter opens it, Escape cancels, like a list box.</summary>
    private void HandleKeyDown(KeyboardEventArgs e)
    {
        IReadOnlyList<AppChooserOption> options = Presentation.Request.Candidates;
        int index = options.ToList().FindIndex(option => option.AppId == _selected);
        switch (e.Key)
        {
            case "ArrowDown" when options.Count > 0:
                _selected = options[Math.Min(options.Count - 1, index + 1)].AppId;
                break;
            case "ArrowUp" when options.Count > 0:
                _selected = options[Math.Max(0, index - 1)].AppId;
                break;
            case "Enter":
                Open(_selected);
                break;
            case "Escape":
                HandleCancel();
                break;
        }
    }
}
