@namespace HackerOs.Apps.FileExplorer.FileControl
@using Microsoft.AspNetCore.Components.Web
@inherits HackerOs.AppSdk.Blazor.HackComponentBase

@*
    Sortable Details-mode table (FV-002). Reuses FileExplorerState's sort-key semantics (Name/Kind/Size/
    Modified) so migrating FileExplorerWindow onto FileView is behavior-preserving (see integrationPlan.md
    Phase 4). Inline rename swaps the "name" cell's label for a textbox in place — no dialog (FV-005).
*@
<table class="file-view-details" role="grid" aria-multiselectable="@(Owner.AllowMultiSelect ? "true" : "false")">
    <thead>
        <tr role="row">
            @foreach (FileViewColumn column in EffectiveColumns)
            {
                <th role="columnheader"
                    scope="col"
                    aria-sort="@AriaSort(column.Key)"
                    @attributes="GetHeaderAttributes(column)"
                    @onclick="() => ToggleSort(column.Key)">
                    @column.Header
                    @if (_sortColumnKey == column.Key)
                    {
                        <span aria-hidden="true">@(_sortDescending ? "▼" : "▲")</span>
                    }
                </th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (FileViewItem item in SortedItems)
        {
            <tr role="row"
                @key="item.FullPath.Value"
                data-item-path="@item.FullPath.Value"
                class="entry-row @(item.IsSelected ? "selected" : null) @(item.IsCut ? "cut" : null) @(item.IsDimmed ? "dimmed" : null)"
                data-drop-target="@(item.IsDirectory && Owner.AllowDragDrop ? "true" : null)"
                tabindex="@(IsTabStop(item) ? 0 : -1)"
                draggable="@(Owner.AllowDragDrop ? "true" : "false")"
                @onclick="@(args => OnRowClickAsync(item, args))"
                @ondblclick="@(() => OnRowDoubleClickAsync(item))"
                @attributes="Owner.MenuAttributesFor(item)"
                @oncontextmenu="@(args => OnRowContextMenuAsync(item, args))"
                @oncontextmenu:preventDefault="Owner.UsesOwnMenu"
                @oncontextmenu:stopPropagation="true"
                @onkeydown="@(args => OnRowKeyDownAsync(item, args))"
                @ondragstart="@(args => OnRowDragStartAsync(item, args))"
                @ondragover:preventDefault="@(item.IsDirectory && Owner.AllowDragDrop)"
                @ondrop="@(args => OnRowDropAsync(item, args))"
                @ondrop:stopPropagation="@item.IsDirectory">
                @foreach (FileViewColumn column in EffectiveColumns)
                {
                    <td role="gridcell" class="@("file-view-details-column-"+ column.Key)">
                        @if (column.Key == NameColumnKey)
                        {

                            <ShellIconLabel Icon="ResolveIcon(item)" Size="16">
                            @if (item.IsRenaming)
                            {
                                <input class="file-view-rename-input"
                                       value="@GetRenameBuffer(item)"
                                       @oninput="@(args => SetRenameBuffer(item, args.Value?.ToString() ?? string.Empty))"
                                       @onkeydown="@(args => OnRenameKeyDownAsync(item, args))"
                                       @onkeydown:stopPropagation="true"
                                       @onblur="@(() => CommitRenameAsync(item))"
                                       @onclick:stopPropagation="true" />
                            }
                            else
                            {
                                <span>@item.Label</span>
                            }
                            </ShellIconLabel>
                        }
                        else
                        {
                            @FormatValue(column, item)
                        }
                    </td>
                }
            </tr>
        }
        @if (Owner.EmptyText is { } emptyText)
        {
            @* ADR 0185 §2: inside the list, under the headers; the row is not an item, the view's drop and menu stay. *@
            <tr class="file-view-empty-row" role="row">
                <td role="gridcell" class="file-view-empty" colspan="@EffectiveColumns.Count">@emptyText</td>
            </tr>
        }
    </tbody>
</table>
