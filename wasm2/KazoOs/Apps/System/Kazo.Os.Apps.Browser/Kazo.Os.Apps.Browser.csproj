<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="../../../Platform/Packaging.props" />

  <PropertyGroup>
    <PackageId>Kazo.Os.Apps.Browser</PackageId>
    <Description>The base Kazo OS web browser app, to include in an OS host (ProjectReference or PackageReference, optionally IsSystemApp).</Description>
    <PackageTags>hackeros;app</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.11.0" />
    <!-- HTML parser of the page loader (ADR 0075 §2, questionnaire 7). Browser app only. -->
    <PackageReference Include="AngleSharp" Version="1.8.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Injected as text into each page's isolated frame, never served to the host (ADR 0075 §3). -->
    <EmbeddedResource Include="Bridge\PageBridge.js" LogicalName="Kazo.Os.Apps.Browser.Bridge.PageBridge.js" />
    <Content Remove="Bridge\PageBridge.js" />
    <None Remove="Bridge\PageBridge.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\Kazo.Os.App.Abstractions\Kazo.Os.App.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\Shared\Kazo.Os.AppSdk.Blazor\Kazo.Os.AppSdk.Blazor.csproj" />
    <!-- ADR 0084: Blazor sites drawn in the page area (HackWebSiteView, IHackWebSiteHost). -->
    <ProjectReference Include="..\..\..\Shared\Kazo.Os.AppSdk.Web.Blazor\Kazo.Os.AppSdk.Web.Blazor.csproj" />
  </ItemGroup>

</Project>
