@namespace Kazo.Os.Windowing.Blazor
@using Kazo.Os.Windowing.Core
@implements IDisposable

<DesktopArea Windows="Runtime.Windows"
             WindowContent="WindowContent"
             OnFocus="HandleFocus"
             OnMinimize="HandleMinimize"
             OnToggleMaximize="HandleToggleMaximize"
             OnClose="HandleClose"
             OnGesture="HandleGesture" />

@code {
    private WindowRuntime? _subscribed;

    /// <summary>Gets or sets the window runtime this surface renders and drives.</summary>
    [Parameter, EditorRequired]
    public WindowRuntime Runtime { get; set; } = null!;

    /// <summary>Gets or sets content rendered for each window snapshot.</summary>
    [Parameter]
    public RenderFragment<WindowRuntimeState>? WindowContent { get; set; }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_subscribed, Runtime))
        {
            return;
        }

        if (_subscribed is not null)
        {
            _subscribed.StateChanged -= Rerender;
        }

        Runtime.StateChanged += Rerender;
        _subscribed = Runtime;
    }

    private void Rerender() => InvokeAsync(StateHasChanged);

    private void HandleFocus(WindowId id) => Runtime.Apply(new FocusWindowCommand(id));

    private void HandleMinimize(WindowId id) => Runtime.Apply(new MinimizeWindowCommand(id));

    private void HandleToggleMaximize(WindowId id)
    {
        WindowRuntimeState? window = Runtime.Windows.FirstOrDefault(candidate => candidate.Id == id);
        if (window is not null)
        {
            Runtime.Apply(window.VisualState == WindowVisualState.Maximized
                ? new RestoreWindowCommand(id)
                : new MaximizeWindowCommand(id));
        }
    }

    private void HandleClose(WindowId id) => Runtime.Apply(new ForceWindowCloseCommand(id));

    private void HandleGesture(WindowCommand command) => Runtime.Apply(command);

    /// <inheritdoc />
    public void Dispose()
    {
        if (_subscribed is not null)
        {
            _subscribed.StateChanged -= Rerender;
        }
    }
}
