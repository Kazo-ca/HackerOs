<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Development uses source projects. CI sets this property to true to prove that the same
         host restores, builds, and publishes from the isolated local NuGet feed only. -->
    <UseLocalHackerOsPackages Condition="'$(UseLocalHackerOsPackages)' == ''">false</UseLocalHackerOsPackages>
    <HackerOsLocalPackageVersion Condition="'$(HackerOsLocalPackageVersion)' == ''">$(HackerOsVersion)</HackerOsLocalPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalHackerOsPackages)' != 'true'">
    <!--
      Deliberately only the seven projects in the desktop package dependency closure. No
      HackerOs.Ecosystem, app projects, Platform.Core, or Simulation.Abstractions: this project
      is EXT-WIN-011's proof that the extracted themes, window engine, chrome, icons, and taskbar
      are consumable by a host with no knowledge of Kazo OS's process/app model.
    -->
    <ProjectReference Include="..\..\Shared\HackerOs.Theming.Abstractions\HackerOs.Theming.Abstractions.csproj" />
    <ProjectReference Include="..\..\Platform\HackerOs.Theming.Blazor\HackerOs.Theming.Blazor.csproj" />
    <ProjectReference Include="..\..\Platform\HackerOs.Windowing.Abstractions\HackerOs.Windowing.Abstractions.csproj" />
    <ProjectReference Include="..\..\Platform\HackerOs.Windowing.Core\HackerOs.Windowing.Core.csproj" />
    <ProjectReference Include="..\..\Platform\HackerOs.Windowing.Blazor\HackerOs.Windowing.Blazor.csproj" />
    <ProjectReference Include="..\..\Shared\HackerOs.AppSdk.Icons\HackerOs.AppSdk.Icons.csproj" />
    <ProjectReference Include="..\..\Platform\HackerOs.Taskbar.Blazor\HackerOs.Taskbar.Blazor.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalHackerOsPackages)' == 'true'">
    <!-- Keep every directly consumed package explicit. This catches missing packages and incorrect
         transitive versions instead of allowing a ProjectReference to hide packaging defects. -->
    <PackageReference Include="HackerOs.Theming.Abstractions" Version="$(HackerOsLocalPackageVersion)" />
    <PackageReference Include="HackerOs.Theming.Blazor" Version="$(HackerOsLocalPackageVersion)" />
    <PackageReference Include="HackerOs.Windowing.Abstractions" Version="$(HackerOsLocalPackageVersion)" />
    <PackageReference Include="HackerOs.Windowing.Core" Version="$(HackerOsLocalPackageVersion)" />
    <PackageReference Include="HackerOs.Windowing.Blazor" Version="$(HackerOsLocalPackageVersion)" />
    <PackageReference Include="HackerOs.AppSdk.Icons" Version="$(HackerOsLocalPackageVersion)" />
    <PackageReference Include="HackerOs.Taskbar.Blazor" Version="$(HackerOsLocalPackageVersion)" />
  </ItemGroup>

</Project>
