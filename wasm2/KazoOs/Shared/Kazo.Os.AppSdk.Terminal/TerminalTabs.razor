@namespace Kazo.Os.AppSdk.Terminal
@using Kazo.Os.AppSdk
@using Kazo.Os.AppSdk.Globalization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JavaScript

@*
    Tabbed console (ADR 0058, section 4): each tab is one TerminalPanel, so one hsh process child
    of the host app, with its own directory, environment, history and $?. Closing a tab ends its
    shell and the commands still running in it; closing the last one raises OnLastTabClosed so
    the host can close its window. Shortcuts follow gnome-terminal.
*@
<div class="terminal-tabs" @ref="_rootRef" @onkeydown="HandleKeyDownAsync">
    <div class="terminal-tab-strip" role="group" aria-label="@L["Tabs.Label"]">
        @foreach (TerminalTabState tab in _tabs.Tabs)
        {
            bool active = tab == _tabs.Active;
            <div class="terminal-tab @(active ? "is-active" : null)" @key="tab.Id">
                <button class="terminal-tab-select"
                        aria-current="@(active ? "true" : null)"
                        title="@tab.Title"
                        @onclick="() => ActivateAsync(tab)">@tab.Title</button>
                <button class="terminal-tab-close"
                        aria-label="@L["Tabs.CloseNamed", tab.Title]"
                        title="@L["Tabs.CloseHint"]"
                        @onclick="() => CloseTabAsync(tab)">×</button>
            </div>
        }
        <button class="terminal-tab-add"
                aria-label="@L["Tabs.New"]"
                title="@L["Tabs.NewHint"]"
                @onclick="() => OpenTabAsync()">+</button>
    </div>
    <div class="terminal-tab-panels">
        @foreach (TerminalTabState tab in _tabs.Tabs)
        {
            <div class="terminal-tab-panel @(tab == _tabs.Active ? "is-active" : null)" @key="tab.Id">
                <TerminalPanel @ref="tab.Panel"
                               AppContext="AppContext"
                               CallerAppId="@CallerAppId"
                               InitialCwd="@tab.InitialCwd"
                               OnExitRequested="() => CloseTabAsync(tab)"
                               OnTitleChanged="title => SetTitle(tab, title)" />
            </div>
        }
    </div>
</div>

@code {
    /// <summary>Gets or sets the host app's execution context; every tab's shell is a child of its process.</summary>
    [Parameter, EditorRequired]
    public IAppExecutionContext AppContext { get; set; } = default!;

    /// <summary>Gets the tab strip's labels in the host app's language (ADR 0104).</summary>
    private Microsoft.Extensions.Localization.IStringLocalizer<Strings> L => AppContext.GetLocalizer<Strings>();

    /// <summary>Gets or sets the app id of the hosting app, passed to each <see cref="TerminalPanel"/>.</summary>
    [Parameter]
    public string CallerAppId { get; set; } = "org.hackeros.terminal";

    /// <summary>Gets or sets the first tab's starting directory; <see langword="null"/> for the host's directory.</summary>
    [Parameter]
    public string? InitialCwd { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the last tab closes (its close button, Ctrl+Shift+W,
    /// <c>exit</c> or Ctrl+D): the console window closes with it.
    /// </summary>
    [Parameter]
    public EventCallback OnLastTabClosed { get; set; }

    private readonly TerminalTabSet _tabs = new();
    private TerminalTabState? _focusPending;
    private ElementReference _rootRef;
    private IJSObjectReference? _module;
    private IJSObjectReference? _shortcutTrap;

    protected override void OnInitialized()
    {
        // The first tab, opened in the requested directory.
        _tabs.Open(InitialCwd);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JavaScript.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/Kazo.Os.AppSdk.Terminal/TerminalTabs.razor.js");
                _shortcutTrap = await _module.InvokeAsync<IJSObjectReference>("trapTabShortcuts", _rootRef);
            }
            catch (Exception)
            {
                // Headless test DOM: the shortcuts still work, the browser simply keeps its own too.
            }
        }

        if (_focusPending is { Panel: { } panel })
        {
            _focusPending = null;
            await panel.FocusAsync();
        }
    }

    /// <summary>
    /// Opens a tab after the active one, in the active tab's directory (Ctrl+Shift+T, as
    /// gnome-terminal), and makes it active.
    /// </summary>
    public Task OpenTabAsync()
    {
        string? directory = _tabs.Active?.Panel?.WorkingDirectory ?? InitialCwd;
        _focusPending = _tabs.Open(directory);
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>Closes the active tab, ending its shell (Ctrl+Shift+W).</summary>
    public Task CloseActiveTabAsync() => _tabs.Active is { } active ? CloseTabAsync(active) : Task.CompletedTask;

    /// <summary>Activates the tab <paramref name="offset"/> positions away, wrapping around (Ctrl+PgUp / Ctrl+PgDn).</summary>
    /// <param name="offset"><c>-1</c> for the previous tab, <c>+1</c> for the next one.</param>
    public Task SwitchTabAsync(int offset)
    {
        if (_tabs.Switch(offset))
        {
            _focusPending = _tabs.Active;
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    private Task ActivateAsync(TerminalTabState tab)
    {
        _tabs.Activate(tab);
        _focusPending = tab;
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Removes a tab: Blazor disposes its <see cref="TerminalPanel"/>, which ends the tab's
    /// shell and its commands. Closing the last tab raises <see cref="OnLastTabClosed"/>.
    /// </summary>
    private async Task CloseTabAsync(TerminalTabState tab)
    {
        TerminalTabState? previouslyActive = _tabs.Active;
        if (!_tabs.Close(tab))
        {
            return;
        }

        StateHasChanged();
        if (_tabs.Active is null)
        {
            await OnLastTabClosed.InvokeAsync();
        }
        else if (_tabs.Active != previouslyActive)
        {
            _focusPending = _tabs.Active;
        }
    }

    private void SetTitle(TerminalTabState tab, string title)
    {
        tab.Title = title;
        StateHasChanged();
    }

    private Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (!args.CtrlKey || args.AltKey || args.MetaKey)
        {
            return Task.CompletedTask;
        }

        return (args.Key, args.ShiftKey) switch
        {
            ("T" or "t", true) => OpenTabAsync(),
            ("W" or "w", true) => CloseActiveTabAsync(),
            ("PageUp", false) => SwitchTabAsync(-1),
            ("PageDown", false) => SwitchTabAsync(1),
            _ => Task.CompletedTask
        };
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        // Under InteractiveServer the circuit may already be gone (page reload, closed tab): the
        // browser-side listener and module went with it, as TerminalPanel also assumes.
        try
        {
            if (_shortcutTrap is not null)
            {
                try
                {
                    await _shortcutTrap.InvokeVoidAsync("dispose");
                }
                catch (JSException)
                {
                    // The element is already gone with its listener.
                }

                await _shortcutTrap.DisposeAsync();
            }

            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Nothing left to release on the browser side.
        }
    }
}
