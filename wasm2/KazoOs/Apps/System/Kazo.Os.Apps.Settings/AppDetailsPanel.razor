@inherits Kazo.Os.AppSdk.Blazor.HackComponentBase
@using Kazo.Os.App.Abstractions
@using Kazo.Os.AppSdk.Administration
@using Kazo.Os.AppSdk.Apps
@using Kazo.Os.AppSdk.ServiceProcess

@*
    Settings > Application: the page of one app (ADR 0096, section 4), opened by
    ShowAppSettingsIntent for an app that has no settings page of its own (`settings --app=<id>`).
    Identity, declared and dangerous capabilities, the file types it handles, its service state and
    start mode for a Service app, and its install row (uninstall/reinstall, reusing InstalledAppsPanel).
*@
<div class="app-details" aria-live="polite">
    @if (_app is null)
    {
        <section class="setting-group">
            <h4>@L["Details.Title"]</h4>
            <p class="setting-desc">@(_loaded ? L["Details.NotFound", AppId] : L["Common.Loading"])</p>
        </section>
    }
    else
    {
        <section class="setting-group app-identity-card">
            <header class="app-details-header">
                <span class="app-details-mark" aria-hidden="true">▤</span>
                <div>
                    <h4>@_app.Name</h4>
                    <p class="app-details-meta"><code>@_app.Id</code> · v@(_app.Version) · @_app.PublisherId · @KindLabel(_app.Kind)</p>
                </div>
                @if (_app.IsSystemApp)
                {
                    <span class="app-details-badge">@L["Apps.SystemBadge"]</span>
                }
            </header>
            @if (!string.IsNullOrWhiteSpace(_app.Description))
            {
                <p class="setting-desc">@_app.Description</p>
            }
        </section>

        <section class="setting-group">
            <h4>@L["Details.Capabilities"]</h4>
            @if (_app.Capabilities.Count == 0)
            {
                <p class="setting-desc">@L["Details.NoCapability"]</p>
            }
            else
            {
                <p class="setting-desc">@L["Details.CapabilitiesDescription"]</p>
                <ul class="capability-list">
                    @foreach (string capability in _app.Capabilities.Order(StringComparer.Ordinal))
                    {
                        HackCapabilityPermissionInfo? dangerous = _permissions?.Capabilities.FirstOrDefault(entry => entry.Capability == capability);
                        <li class="capability-item @(dangerous is null ? "" : dangerous.IsGranted ? "is-granted" : "is-refused")">
                            <code>@capability</code>
                            @if (dangerous is not null)
                            {
                                <span class="capability-state">@StateLabel(dangerous.State)</span>
                            }
                        </li>
                    }
                </ul>
            }
        </section>

        @if (_app.FileHandlers.Count > 0)
        {
            <section class="setting-group">
                <h4>@L["Details.FileTypes"]</h4>
                <ul class="handler-list">
                    @foreach (HackAppFileHandler handler in _app.FileHandlers)
                    {
                        <li>
                            <span class="handler-type">@DescribeHandler(handler)</span>
                            <span class="handler-actions">@string.Join(", ", handler.Actions)</span>
                        </li>
                    }
                </ul>
            </section>
        }

        @if (_app.Kind == AppKind.Service)
        {
            <section class="setting-group">
                <h4>@L["Details.Service"]</h4>
                @if (_service is null)
                {
                    <p class="setting-desc">@(_serviceMessage ?? L["Details.ReadingService"])</p>
                }
                else
                {
                    <p class="setting-desc">
                        @L["Details.State"] <strong>@ServiceStatusLabel(_service.Status)</strong>@(_service.ProcessId is { } pid ? L["Details.Pid", pid].Value : "")
                    </p>
                    <div class="service-actions">
                        <label class="start-mode">
                            <span>@L["Details.StartMode"]</span>
                            <select value="@(_service.StartType?.ToString() ?? "")" disabled="@_isBusy" @onchange="ChangeStartModeAsync" aria-label="@L["Details.StartMode"]">
                                @foreach (ServiceStartMode mode in Enum.GetValues<ServiceStartMode>())
                                {
                                    <option value="@mode">@StartModeLabel(mode)</option>
                                }
                            </select>
                        </label>
                        <button type="button" class="apps-btn" disabled="@(_isBusy || _service.Status == HackServiceControllerStatus.Running)" @onclick="StartServiceAsync">@L["Details.Start"]</button>
                        <button type="button" class="apps-btn" disabled="@(_isBusy || _service.Status == HackServiceControllerStatus.Stopped)" @onclick="StopServiceAsync">@L["Details.Stop"]</button>
                    </div>
                    @if (!string.IsNullOrEmpty(_serviceMessage))
                    {
                        <p class="apps-message" role="status">@_serviceMessage</p>
                    }
                }
            </section>
        }

        <InstalledAppsPanel OnlyAppId="@_app.Id" />
    }
</div>
