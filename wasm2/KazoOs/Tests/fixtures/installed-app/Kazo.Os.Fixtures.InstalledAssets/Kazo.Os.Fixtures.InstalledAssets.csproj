<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!--
    Test package of ADR 0206, not part of the solution: build/publish-trimmed.sh packs it with
    `dotnet build -c Release -t:HackerOsPack`, and Kazo.Os.TrimmedPublish.E2E.Tests installs it with
    hackpkg from a GitHub address the browser answers locally. Its wwwroot/ holds a module, a Web
    Worker that loads a second script by a relative importScripts, and an image. ADR 0221: the second
    script, the collocated ProbeWindow.razor.js and the scoped CSS (ProbeWindow.razor.css) are not
    declared; HackerOsPack adds them to the package. ADR 0222: Resources/ProbeStrings.fr.resx gives
    the satellite lib/fr/Kazo.Os.Fixtures.InstalledAssets.resources.dll, which HackerOsPack packs too.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <HackerOsAppProject>true</HackerOsAppProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Shared\Kazo.Os.App.Abstractions\Kazo.Os.App.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\..\Shared\Kazo.Os.AppSdk\Kazo.Os.AppSdk.csproj" />
    <ProjectReference Include="..\..\..\..\Shared\Kazo.Os.AppSdk.Blazor\Kazo.Os.AppSdk.Blazor.csproj" />
  </ItemGroup>
</Project>
