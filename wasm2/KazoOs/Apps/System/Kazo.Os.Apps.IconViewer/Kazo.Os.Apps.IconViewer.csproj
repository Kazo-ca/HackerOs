<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="../../../Platform/Packaging.props" />

  <PropertyGroup>
    <PackageId>Kazo.Os.Apps.IconViewer</PackageId>
    <Description>The base Kazo OS icon viewer app, to include in an OS host (ProjectReference or PackageReference, optionally IsSystemApp).</Description>
    <PackageTags>kazoos;app</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\Kazo.Os.App.Abstractions\Kazo.Os.App.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\Shared\Kazo.Os.AppSdk.Blazor\Kazo.Os.AppSdk.Blazor.csproj" />
    <ProjectReference Include="..\..\..\Shared\Kazo.Os.AppSdk.Icons\Kazo.Os.AppSdk.Icons.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kazo.Os.Apps.IconViewer.Tests" />
  </ItemGroup>

</Project>
