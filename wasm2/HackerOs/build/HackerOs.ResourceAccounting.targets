<Project>
  <!--
    ADR 0066: optional resource accounting, chosen at build time. Imported explicitly at the end of
    each host project (OS/HackerOs.Ecosystem, test/test, Server/HackerOs.Server).

      <HackerOsCpuAccounting>false</HackerOsCpuAccounting>       measured CPU time (ADR 0067)
      <HackerOsMemoryAccounting>false</HackerOsMemoryAccounting> measured memory (ADR 0068)

    Both default to true. With both false, the host does not reference
    HackerOs.Platform.ResourceAccounting: the measuring code is not in the binary. Each property
    also becomes a RuntimeHostConfigurationOption read with AppContext.TryGetSwitch, so a measurement
    switched off at build is ignored at startup even while the other one keeps the assembly.

    The service composition lives in HackerOs.Ecosystem, which test/test and the server reference:
    set the properties in a Directory.Build.props or on the command line (-p:HackerOsCpuAccounting=false)
    to switch the whole graph; a property set only in a host's .csproj only changes that host's
    runtime switch (see doc/wasm/dev/resource-accounting.md).
  -->
  <PropertyGroup>
    <HackerOsCpuAccounting Condition="'$(HackerOsCpuAccounting)' == ''">true</HackerOsCpuAccounting>
    <HackerOsMemoryAccounting Condition="'$(HackerOsMemoryAccounting)' == ''">true</HackerOsMemoryAccounting>
    <HackerOsResourceAccountingIncluded>false</HackerOsResourceAccountingIncluded>
    <HackerOsResourceAccountingIncluded Condition="'$(HackerOsCpuAccounting)' == 'true' or '$(HackerOsMemoryAccounting)' == 'true'">true</HackerOsResourceAccountingIncluded>
    <!-- Lets the composition code (#if HACKEROS_RESOURCE_ACCOUNTING) compile without the project. -->
    <DefineConstants Condition="'$(HackerOsResourceAccountingIncluded)' == 'true'">$(DefineConstants);HACKEROS_RESOURCE_ACCOUNTING</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="HackerOs.ResourceAccounting.Cpu.IsSupported"
                                    Value="$([System.String]::Copy('$(HackerOsCpuAccounting)').ToLowerInvariant())"
                                    Trim="true" />
    <RuntimeHostConfigurationOption Include="HackerOs.ResourceAccounting.Memory.IsSupported"
                                    Value="$([System.String]::Copy('$(HackerOsMemoryAccounting)').ToLowerInvariant())"
                                    Trim="true" />
  </ItemGroup>

  <ItemGroup Condition="'$(HackerOsResourceAccountingIncluded)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)../Platform/HackerOs.Platform.ResourceAccounting/HackerOs.Platform.ResourceAccounting.csproj" />
  </ItemGroup>
</Project>
