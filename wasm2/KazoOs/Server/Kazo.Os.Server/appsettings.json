{
  "ConnectionStrings": {
    "KazoOsDb": "Data Source=kazoos.db"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5000",
      "https://localhost:7000",
      "https://kazo-ca.github.io"
    ]
  },
  "BlobStorage": {
    "Root": "blobs"
  },
  "ServerBackup": {
    "Root": "backups"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KazoOs": {
    "CrossOriginIsolation": "auto",
    "Proxy": {
      "Enabled": true,
      "Http": { "AllowedPorts": [ 80, 443 ] },
      "Tcp": { "AllowedPorts": [ 80, 443 ] },
      "Udp": { "AllowedPorts": [ 53, 123 ] },
      "AllowAllPorts": false,
      "AllowPrivateNetworks": false,
      "Quotas": {
        "Enabled": true,
        "MaxResponseBytes": 10485760,
        "MaxRequestBytes": 10485760,
        "MaxConcurrentPerDevice": 8,
        "MaxStreamsPerDevice": 4,
        "MaxRedirectHops": 5,
        "StreamIdleTimeoutSeconds": 300
      },
      "GrantedApps": [
        "org.kazoos.commands.curl",
        "org.kazoos.commands.wget",
        "org.kazoos.commands.ping",
        "org.kazoos.cmd.cat",
        "org.kazoos.commands.nmap",
        "org.kazoos.browser"
      ]
    }
  }
}
