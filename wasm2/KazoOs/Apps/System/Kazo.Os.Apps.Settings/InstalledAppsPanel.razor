@inherits Kazo.Os.AppSdk.Blazor.HackComponentBase
@using Kazo.Os.AppSdk.Apps

<div class="setting-group">
    <h4>@(OnlyAppId is null ? L["Apps.Title"] : L["Apps.InstallationTitle"])</h4>
    <p class="setting-desc @(OnlyAppId is null ? "" : "is-hidden")">
        @LocalizedMarkup.Format(L["Apps.Description"],
            LocalizedMarkup.Code("~/.config/hackeros/apps.config"),
            LocalizedMarkup.Code("/etc/hackeros/apps.config"))
    </p>

    @if (_apps is null)
    {
        <p class="setting-desc">@L["Apps.Loading"]</p>
    }

    <div class="apps-list" role="list">
        @foreach (HackAppInstallInfo app in Applications)
        {
            @Row(app)
        }
    </div>

    @if (Commands.Count > 0)
    {
        <details class="commands-group">
            <summary>@L["Apps.Commands", Commands.Count]</summary>
            <div class="apps-list" role="list">
                @foreach (HackAppInstallInfo command in Commands)
                {
                    @Row(command)
                }
            </div>
        </details>
    }

    @if (_pending is null && !string.IsNullOrEmpty(_message))
    {
        <p class="apps-message" role="alert">@_message</p>
    }
</div>

@if (_pending is not null)
{
    <div class="apps-backdrop" @onclick="CancelUninstall">
        <div class="apps-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="uninstall-title"
             @onclick:stopPropagation>
            <header class="apps-dialog-header">
                <span class="apps-dialog-mark" aria-hidden="true">⏏</span>
                <h2 id="uninstall-title">@L["Apps.Uninstall.Title", _pending.App.Name]</h2>
            </header>

            <div class="apps-dialog-body">
                @if (_pending.UninstallClosure.Count > 1)
                {
                    <p>@L["Apps.Uninstall.Dependents"]</p>
                    <ul class="closure-list">
                        @foreach (string dependentId in _pending.UninstallClosure.Where(id => id != _pending.App.Id))
                        {
                            <li>@NameOf(dependentId)</li>
                        }
                    </ul>
                }

                @if (_plan is { RunningProcesses.Count: > 0 } plan)
                {
                    <p>@L["Apps.Uninstall.Processes"]</p>
                    <ul class="process-list">
                        @foreach (HackRunningProcessInfo process in plan.RunningProcesses)
                        {
                            <li><span class="process-pid">@process.Pid</span> @process.Name <span class="process-user">(@process.UserName)</span></li>
                        }
                    </ul>
                    <p>@L["Apps.Uninstall.GracePeriod"]</p>
                }
                else
                {
                    <p>@L["Apps.Uninstall.NothingRunning"]</p>
                }

                @foreach (string siteId in WebSitesIn(_pending.UninstallClosure))
                {
                    <p class="apps-site-data">
                        @LocalizedMarkup.Format(L["Apps.Uninstall.SiteData"], NameOf(siteId), LocalizedMarkup.Code($"hackweb.{siteId}"))
                    </p>
                }

                @if (IsAdministrator && _scope == HackInstallScope.Machine)
                {
                    <p>@L["Apps.Uninstall.AdminWillAuthenticate"]</p>
                }

                @if (IsAdministrator)
                {
                    <div class="scope-options" role="radiogroup" aria-label="@L["Apps.Uninstall.ScopeAriaLabel"]">
                        <button type="button" role="radio"
                                aria-checked="@(_scope == HackInstallScope.User ? "true" : "false")"
                                class="@ScopeClass(HackInstallScope.User)"
                                @onclick="() => _scope = HackInstallScope.User">
                            @L["Apps.Scope.User"]
                        </button>
                        <button type="button" role="radio"
                                aria-checked="@(_scope == HackInstallScope.Machine ? "true" : "false")"
                                class="@ScopeClass(HackInstallScope.Machine)"
                                @onclick="() => _scope = HackInstallScope.Machine">
                            @L["Apps.Scope.Machine"]
                        </button>
                    </div>
                }
                else
                {
                    <p>@L["Apps.Uninstall.ForYouOnly"]</p>
                }

                @if (!string.IsNullOrEmpty(_message))
                {
                    <p class="apps-message" role="alert">@_message</p>
                }
            </div>

            <footer class="apps-dialog-footer">
                <button type="button" class="apps-btn" disabled="@_isBusy" @onclick="CancelUninstall">@L["Common.Cancel"]</button>
                <button type="button" class="apps-btn apps-btn-danger" disabled="@_isBusy" @onclick="ConfirmUninstallAsync">
                    @(_isBusy ? L["Apps.Uninstalling"] : L["Apps.Uninstall"])
                </button>
            </footer>
        </div>
    </div>
}

@code {
    /// <summary>One app line: identity, badge, and the one action its state allows.</summary>
    private RenderFragment Row(HackAppInstallInfo entry) => __builder =>
    {
        HackAppInfo app = entry.App;
        <div class="app-row @RowClass(entry)" role="listitem">
            <div class="app-identity">
                <span class="app-name">@app.Name</span>
                <span class="app-meta">@app.PublisherId · v@(app.Version)</span>
                @if (entry.Problem is { } problem)
                {
                    <span class="app-problem">@problem</span>
                }
            </div>
            <div class="app-actions">
                @if (entry.State == HackAppInstallState.Incompatible)
                {
                    <span class="app-badge app-badge-incompatible" title="This app was built for another version of the App SDK and cannot run">Incompatible</span>
                }
                else if (entry.State == HackAppInstallState.Damaged)
                {
                    <span class="app-badge app-badge-damaged" title="A file of this app does not match its manifest">Damaged</span>
                }
                else if (app.IsSystemApp)
                {
                    <span class="app-badge app-badge-system" title="@L["Apps.SystemBadge.Title"]">@L["Apps.SystemBadge"]</span>
                }
                else
                {
                    @switch (entry.State)
                    {
                        case HackAppInstallState.Installed:
                            <button type="button" class="apps-btn apps-btn-danger" disabled="@_isBusy" @onclick="() => AskUninstall(entry)">@L["Apps.Uninstall"]</button>
                            break;
                        case HackAppInstallState.UninstalledForMachine when !IsAdministrator:
                            <span class="app-badge app-badge-locked">@L["Apps.UninstalledByAdmin"]</span>
                            break;
                        default:
                            <span class="app-badge">@(entry.State == HackAppInstallState.UninstalledForMachine ? L["Apps.UninstalledForAll"] : L["Apps.Uninstalled"])</span>
                            <button type="button" class="apps-btn" disabled="@_isBusy" @onclick="() => ReinstallAsync(entry)">@L["Apps.Reinstall"]</button>
                            break;
                    }
                }
            </div>
        </div>
    };
}
