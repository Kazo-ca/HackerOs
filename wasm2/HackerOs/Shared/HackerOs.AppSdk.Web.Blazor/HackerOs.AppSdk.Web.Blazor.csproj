<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="../../Platform/Packaging.props" />

  <PropertyGroup>
    <PackageId>HackerOs.AppSdk.Web.Blazor</PackageId>
    <Description>Interactive Blazor sites of ASP.Hack: site router, navigation and the view the Kazo OS browser draws a site in.</Description>
    <PackageTags>hackeros;app-sdk;asp-hack;blazor</PackageTags>
  </PropertyGroup>

  <!--
    Blazor sites of ASP.Hack (ADR 0073 §4, ADR 0084): the components a site uses to navigate by the
    URL of the browser tab (HackSiteRouter, HackSiteNavigationManager, HackNavLink, HackPageTitle),
    the view the Kazo OS browser draws a site in (HackWebSiteView) and the contract the platform
    implements to start a site's renderer (IHackWebSiteHost). An SDK library (ADR 0055): no
    reference to Platform Core.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HackerOs.App.Abstractions\HackerOs.App.Abstractions.csproj" />
    <ProjectReference Include="..\HackerOs.AppSdk\HackerOs.AppSdk.csproj" />
    <ProjectReference Include="..\HackerOs.AppSdk.Blazor\HackerOs.AppSdk.Blazor.csproj" />
    <ProjectReference Include="..\HackerOs.AppSdk.Web\HackerOs.AppSdk.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HackerOs.AppSdk.Web.Blazor.Tests" />
  </ItemGroup>

</Project>
