@using Kazo.Os.Apps.CodeEditor
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JavaScript

<section class="code-editor-proof" aria-label="Monaco browser contract">
    <header>
        <h1>Local Monaco contract</h1>
        <div role="toolbar" aria-label="Editor proof actions">
            <button @onclick="UseJsonAsync">Use JSON mode</button>
            <button @onclick="DisposeEditorAsync">Dispose editor</button>
        </div>
    </header>
    <div class="proof-editor" @ref="_host" aria-label="Source code editor"></div>
    <output id="code-editor-result"
            data-status="@_status"
            data-mode="@_document.SyntaxMode">@_document.Content</output>
</section>

@code {
    private readonly CodeEditorDocument _document = CodeEditorDocument.CreateNew(1);
    private ElementReference _host;
    private IJSObjectReference? _module;
    private IJSObjectReference? _editor;
    private DotNetObjectReference<CodeEditorBrowserScenario>? _dotNetReference;
    private string _status = "starting";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _document.TryEdit("// local Monaco bundle");
        _dotNetReference = DotNetObjectReference.Create(this);
        _module = await JavaScript.InvokeAsync<IJSObjectReference>(
            "import", "./_content/Kazo.Os.Apps.CodeEditor/CodeEditorWindow.razor.js");
        _editor = await _module.InvokeAsync<IJSObjectReference>(
            "createEditor", _host, _dotNetReference, new { });
        await _editor.InvokeVoidAsync("showDocument", _document.Id.ToString(), _document.Content, "cSharp");
        _document.SetSyntaxMode(CodeEditorSyntaxMode.CSharp);
        _status = "ready";
        StateHasChanged();
        await _editor.InvokeVoidAsync("focus");
    }

    /// <summary>Receives exact content produced by the locally bundled editor.</summary>
    [JSInvokable]
    public Task OnEditorChanged(string documentId, string content)
    {
        CodeEditorEditResult result = _document.TryEdit(content);
        _status = result.Succeeded ? "edited" : "rejected";
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>Cursor reports are not part of this contract proof.</summary>
    [JSInvokable]
    public Task OnCursorChanged(int line, int column, int selectedLength) => Task.CompletedTask;

    private async Task UseJsonAsync()
    {
        _document.SetSyntaxMode(CodeEditorSyntaxMode.Json);
        if (_editor is not null)
        {
            await _editor.InvokeVoidAsync("setLanguage", "json");
            await _editor.InvokeVoidAsync("focus");
        }

        StateHasChanged();
    }

    private async Task DisposeEditorAsync()
    {
        if (_editor is not null)
        {
            await _editor.InvokeVoidAsync("destroy");
            await _editor.DisposeAsync();
            _editor = null;
        }

        _status = "disposed";
        StateHasChanged();
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        await DisposeEditorAsync();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _dotNetReference?.Dispose();
    }
}
