@using HackerOs.AppSdk.Blazor.Components
@using HackerOs.AppSdk.Blazor.Files
@using HackerOs.Apps.FileExplorer.FileControl
@inherits HackEmbeddableComponent
@implements IAsyncDisposable

@*
    The OS file control (hackeros.file-view, ADR 0148), as the File Explorer provides it to every app
    and shows it itself: FileView (the explorer's implementation, ADR 0155 §1) bound to the OS context
    menu, with the explorer's own trash, clipboard, transfers and dialogs, all run with the rights of
    the window that shows it (HostContext, ADR 0148 §4).
*@
<CascadingValue Value="_binding" IsFixed="true">
    <FileView @ref="_view"
              FileSystem="FileSystem"
              Watch="HostContext.Watch"
              Intents="HostContext.Intents"
              InitialDirectory="_initialDirectory"
              Mode="ViewMode"
              ModeChanged="_modeChanged"
              AllowMultiSelect="AllowMultiSelect"
              AllowDragDrop="Has(HackFileViewFeatures.DragDrop)"
              Filter="_filter"
              FolderActivation="FileViewFolderActivationMode.Custom"
              OnCustomFolderActivate="_activateFolder"
              DeleteRequested="_deleteRequested"
              DropRequested="_dropRequested"
              ClipboardRequested="ClipboardCallback"
              CanPaste="_canPaste"
              CutPaths="_cutPaths"
              IconProvider="IconProvider"
              OwnerAppId="@HostContext.Manifest.Id" />
</CascadingValue>
