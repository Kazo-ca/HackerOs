@namespace Kazo.Os.Platform.Blazor.Windows
@using Kazo.Os.App.Abstractions
@using Kazo.Os.Platform.Core.Discovery
@using Kazo.Os.Platform.Core.Lifecycle
@implements IDisposable
@inject WindowResponsivenessMonitor Responsiveness
@inject AppLifecycleOrchestrator Orchestrator
@inject Kazo.Os.Platform.Core.AppCatalog Catalog
@inject Kazo.Os.Platform.Core.Globalization.SessionLocaleService SessionLocale

@*
    What a shell puts in each window's overlay (ADR 0127 §3): the "not responding" dialog while it is
    open for this window, nothing otherwise.
*@
@if (Responsiveness.IsDialogOpen(Window.Id))
{
    <UnresponsiveWindowDialog Window="Window"
                              AppName="@AppName"
                              OnWait="Responsiveness.Wait"
                              OnTerminate="TerminateAsync" />
}

@code {
    /// <summary>
    /// Gets the fragment a shell passes as <c>WindowOverlay</c> of its window area, so every window
    /// gets this overlay (ADR 0127 §3).
    /// </summary>
    public static RenderFragment<WindowRuntimeState> ForWindow { get; } = window => builder =>
    {
        builder.OpenComponent<UnresponsiveWindowOverlay>(0);
        builder.AddAttribute(1, nameof(Window), window);
        builder.CloseComponent();
    };

    /// <summary>Gets or sets the window this overlay belongs to.</summary>
    [Parameter, EditorRequired]
    public WindowRuntimeState Window { get; set; } = null!;

    /// <summary>The app's localized manifest name (ADR 0104), else the dialog falls back to the window title.</summary>
    private string? AppName =>
        Orchestrator.TryGetRunningInstance(AppInstanceId.FromGuid(Window.OwnerInstanceId.Value), out AppDescriptor? descriptor, out _)
            ? Catalog.Localize(descriptor.Manifest, SessionLocale.Culture).Name
            : null;

    /// <inheritdoc />
    protected override void OnInitialized() => Responsiveness.Changed += Rerender;

    /// <inheritdoc />
    public void Dispose() => Responsiveness.Changed -= Rerender;

    private void Rerender() => _ = InvokeAsync(StateHasChanged);

    private Task TerminateAsync(WindowId id) => Responsiveness.TerminateAsync(id);
}
