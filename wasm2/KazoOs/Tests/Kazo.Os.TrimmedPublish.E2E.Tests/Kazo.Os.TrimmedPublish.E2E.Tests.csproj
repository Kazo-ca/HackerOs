<Project Sdk="Microsoft.NET.Sdk">

  <!--
    E2E test of the trimmed Release publish of OS/Kazo.Os.Ecosystem (ADR 0106 §5, ADR 0113). It
    does not publish or serve anything itself: build/publish-trimmed.sh publishes the host, serves
    the output and runs this suite with HACKEROS_TRIMMED_URL pointing at it. Without that variable
    every test reports as skipped, so a plain `dotnet test Kazo.Os.sln` stays unaffected.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Deque.AxeCore.Playwright" Version="4.14.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.64.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kazo.Os.E2E.Support\Kazo.Os.E2E.Support.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Kazo.Os.E2E.Support" />
  </ItemGroup>

</Project>
