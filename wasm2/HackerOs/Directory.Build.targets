<Project>
  <!-- App model: generated manifest.json and host aggregation (ADR 0047). -->
  <Import Project="$(MSBuildThisFileDirectory)build/HackerOs.Apps.targets" />

  <!--
    ADR 0007: no inline CSS/JS in Razor markup. A <script src="..."> reference without body is allowed
    (ADR 0083 §6): an ASP.Hack layout links the site's own wwwroot/js files that way, as a web page does.
    ASP.Hack .cshtml views (ADR 0086) follow the same rule: their CSS and JavaScript live in the site's wwwroot.
  -->
  <Target Name="ValidateHackerOsRazorAssets"
          BeforeTargets="CoreCompile"
          Condition="'$(UsingMicrosoftNETSdkRazor)' == 'true'">
    <ItemGroup>
      <_HackerOsRazorSource Include="$(MSBuildProjectDirectory)/**/*.razor;$(MSBuildProjectDirectory)/**/*.cshtml"
                            Exclude="$(MSBuildProjectDirectory)/bin/**;$(MSBuildProjectDirectory)/obj/**;$(MSBuildProjectDirectory)/**/WindowHost.razor;$(MSBuildProjectDirectory)/**/App.razor" />
      <_HackerOsRazorViolation Include="@(_HackerOsRazorSource)"
          Condition="'%(_HackerOsRazorSource.FullPath)' != '' and $([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(_HackerOsRazorSource.FullPath)')), '(?is)&lt;\s*style\b|&lt;\s*script\b(?![^&gt;]*\bsrc\s*=)|\sstyle\s*=|(?&lt;!@)(?-i:\bon[a-z][a-z0-9_-]*)\s*='))" />
    </ItemGroup>

    <Error Condition="'@(_HackerOsRazorViolation)' != ''"
           Text="Kazo OS Razor components cannot contain inline CSS or JavaScript. Move assets to Component.razor.css or Component.razor.js (an ASP.Hack view: to the site's wwwroot). Files: @(_HackerOsRazorViolation, ', ')" />
  </Target>
</Project>
