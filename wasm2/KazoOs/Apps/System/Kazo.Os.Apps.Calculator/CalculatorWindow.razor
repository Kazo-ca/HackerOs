@using Kazo.Os.AppSdk.Blazor
@using Kazo.Os.AppSdk.Globalization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@inherits WindowAppBase

<div class="calculator-root" tabindex="0" @onkeydown="HandleKeyDown">
    <!-- Display -->
    <div class="calculator-display" role="status" aria-live="polite" aria-label="@L["Display"]">
        <div class="calculator-previous-operand">
            @if (!string.IsNullOrEmpty(_engine.PreviousValue) && !string.IsNullOrEmpty(_engine.Operator))
            {
                <span>@_engine.PreviousValue @_engine.Operator</span>
            }
        </div>
        <div class="calculator-current-operand" id="calc-display-current">
            @_engine.CurrentValue
        </div>
    </div>

    <!-- Keypad -->
    <div class="calculator-buttons" role="group" aria-label="@L["Keypad"]">
        <button id="calc-mc" aria-label="@L["MemoryClear"]" class="calc-btn mem" @onclick="_engine.MemoryClear">MC</button>
        <button id="calc-mr" aria-label="@L["MemoryRecall"]" class="calc-btn mem" @onclick="_engine.MemoryRecall">MR</button>
        <button id="calc-mplus" aria-label="@L["MemoryAdd"]" class="calc-btn mem" @onclick="_engine.MemoryAdd">M+</button>
        <button id="calc-mminus" aria-label="@L["MemorySubtract"]" class="calc-btn mem" @onclick="_engine.MemorySubtract">M-</button>
        <button id="calc-c" aria-label="@L["Clear"]" class="calc-btn clear" @onclick="_engine.Clear">C</button>
        <button id="calc-ac" aria-label="@L["AllClear"]" class="calc-btn clear" @onclick="_engine.AllClear">AC</button>

        <button id="calc-7" class="calc-btn num" @onclick='() => Dig("7")'>7</button>
        <button id="calc-8" class="calc-btn num" @onclick='() => Dig("8")'>8</button>
        <button id="calc-9" class="calc-btn num" @onclick='() => Dig("9")'>9</button>
        <button id="calc-div" aria-label="@L["Divide"]" class="calc-btn op" @onclick='() => Op("/")'>/</button>
        <button id="calc-sqr" aria-label="@L["Square"]" class="calc-btn func" @onclick="_engine.Square">x²</button>

        <button id="calc-4" class="calc-btn num" @onclick='() => Dig("4")'>4</button>
        <button id="calc-5" class="calc-btn num" @onclick='() => Dig("5")'>5</button>
        <button id="calc-6" class="calc-btn num" @onclick='() => Dig("6")'>6</button>
        <button id="calc-mul" aria-label="@L["Multiply"]" class="calc-btn op" @onclick='() => Op("*")'>*</button>
        <button id="calc-sqrt" aria-label="@L["SquareRoot"]" class="calc-btn func" @onclick="_engine.SquareRoot">√</button>

        <button id="calc-1" class="calc-btn num" @onclick='() => Dig("1")'>1</button>
        <button id="calc-2" class="calc-btn num" @onclick='() => Dig("2")'>2</button>
        <button id="calc-3" class="calc-btn num" @onclick='() => Dig("3")'>3</button>
        <button id="calc-sub" aria-label="@L["Subtract"]" class="calc-btn op" @onclick='() => Op("-")'>-</button>
        <button id="calc-pct" aria-label="@L["Percent"]" class="calc-btn func" @onclick="_engine.Percentage">%</button>

        <button id="calc-0" class="calc-btn num" @onclick='() => Dig("0")'>0</button>
        <button id="calc-dot" aria-label="@L["DecimalPoint"]" class="calc-btn num" @onclick="_engine.InputDecimal">.</button>
        <button id="calc-neg" aria-label="@L["Negate"]" class="calc-btn func" @onclick="_engine.Negate">±</button>
        <button id="calc-add" aria-label="@L["Add"]" class="calc-btn op" @onclick='() => Op("+")'>+</button>
        <button id="calc-eq" aria-label="@L["Equals"]" class="calc-btn equals" @onclick="_engine.HandleEquals">=</button>
    </div>
</div>

@code {
    private readonly CalculatorEngine _engine = new();
    private IStringLocalizer<Strings>? _localizer;

    /// <summary>The Calculator's texts in its own process's language (ADR 0104).</summary>
    private IStringLocalizer<Strings> L => _localizer ??= AppContext.GetLocalizer<Strings>();

    private void Dig(string digit) => _engine.InputDigit(digit);
    private void Op(string op) => _engine.HandleOperator(op);

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        var key = e.Key;
        if (key.Length == 1 && key[0] >= '0' && key[0] <= '9') _engine.InputDigit(key);
        else if (key == ".") _engine.InputDecimal();
        else if (key is "+" or "-" or "*" or "/") _engine.HandleOperator(key);
        else if (key is "Enter" or "=") _engine.HandleEquals();
        else if (key == "Escape") _engine.AllClear();
        else if (key == "Backspace") _engine.Clear();
        else if (key == "%") _engine.Percentage();
    }
}
