<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="..\..\Platform\Packaging.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Kazo.Os.AppSdk.VirtualKeyboard</PackageId>
    <Description>A reusable, host-agnostic on-screen keyboard and a keyboard-aware split container. Pushes typed key events to whatever target a host wires up; never fills a focused text field and never risks opening a native keyboard.</Description>
    <PackageTags>hackeros;virtual-keyboard;mobile;blazor;app-sdk</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Key caps follow the language of the app the keyboard serves (ADR 0104). -->
    <ProjectReference Include="..\Kazo.Os.AppSdk\Kazo.Os.AppSdk.csproj" />
  </ItemGroup>

</Project>
