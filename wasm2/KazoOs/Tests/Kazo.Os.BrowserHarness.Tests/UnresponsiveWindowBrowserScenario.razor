@using Kazo.Os.Platform.Blazor.Windows
@using Kazo.Os.Simulation.Abstractions.Processes
@using Kazo.Os.Windowing.Abstractions
@implements IDisposable
@inject UnresponsiveScenarioState State

@* ADR 0127: one app window whose process can hang, freeze the main thread or recover. *@
<section class="unresponsive-browser-scenario" data-status="ready">
    <nav class="scenario-controls" aria-label="Unresponsive window test controls">
        <button type="button" id="hang-app" @onclick="Hang">Hang App</button>
        <button type="button" id="recover-app" @onclick="Recover">Recover App</button>
        <button type="button" id="freeze-app" @onclick="Freeze">Freeze App</button>
        <output id="process-state">@(State.IsTerminated ? $"terminated:{State.Processes.Stops.LastOrDefault().Reason}" : "running")</output>
    </nav>
    <DesktopArea Windows="State.Runtime.Windows"
                 OnFocus="Focus"
                 OnClose="Close"
                 OnGesture="Apply"
                 WindowOverlay="Overlay">
        <WindowContent Context="window">
            <p class="scenario-content" data-app-id="@window.AppId">
                <button type="button" id="app-button">7</button>
            </p>
        </WindowContent>
    </DesktopArea>
    <WindowResponsivenessHost />
</section>

@code {
    private RenderFragment<WindowRuntimeState> Overlay => window => State.Monitor.IsDialogOpen(window.Id)
        ? @<UnresponsiveWindowDialog Window="window"
                                     AppName="Calculatrice"
                                     OnWait="State.Monitor.Wait"
                                     OnTerminate="id => State.Monitor.TerminateAsync(id)" />
        : null!;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        State.Runtime.StateChanged += Rerender;
        State.Monitor.Changed += Rerender;
        State.Terminated += Rerender;
    }

    /// <inheritdoc />
    public void Dispose()
    {
        State.Runtime.StateChanged -= Rerender;
        State.Monitor.Changed -= Rerender;
        State.Terminated -= Rerender;
    }

    private void Rerender() => _ = InvokeAsync(StateHasChanged);

    private void Hang() => State.Accountant.Hung = true;

    private void Recover()
    {
        State.Accountant.Hung = false;
        State.Accountant.Charge(TimeSpan.FromMilliseconds(1), slices: 1, responding: true);
    }

    private void Freeze() => State.Freeze(TimeSpan.FromMilliseconds(1500));

    private void Focus(WindowId id) => State.Runtime.Apply(new FocusWindowCommand(id));

    private void Close(WindowId id)
    {
        if (!State.Monitor.InterceptClose(id))
        {
            State.Runtime.Apply(new ForceWindowCloseCommand(id));
        }
    }

    private void Apply(WindowCommand command) => State.Runtime.Apply(command);
}
