@namespace Kazo.Os.Samples.Intranet.Board.Pages
@page "/board/tasks/{Id:int}"
@inherits KazoComponentBase
@*
    One card: a page with a route parameter, reached from the board without a reload. Saving calls
    PUT /api/tasks/{id}; the link back is a navigation within the site.
*@
<KazoPageTitle Title="@($"Card {Id} - Intranet")" />
<p class="task-crumbs"><a href="/board" id="task-back">← Board</a></p>
@if (_error is not null)
{
    <p class="task-error" role="alert" id="task-error">@_error</p>
}
@if (_task is null)
{
    <p class="task-muted">@(_error is null ? "Loading the card…" : string.Empty)</p>
}
else
{
    <section class="task-panel" id="task-details">
        <p class="task-prompt">$ task show @_task.Id</p>
        <label class="task-field">Title <input id="task-title" @bind="_task.Title" maxlength="80" /></label>
        <label class="task-field">Assignee <input id="task-assignee" @bind="_task.Assignee" maxlength="40" /></label>
        <p class="task-muted">Column: <strong>@BoardColumns.Title(_task.Column)</strong> · created @_task.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</p>
        <button class="task-button" id="task-save" disabled="@_busy" @onclick="SaveAsync">Save</button>
        @if (_saved)
        {
            <span class="task-saved" id="task-saved">Saved.</span>
        }
    </section>
}
